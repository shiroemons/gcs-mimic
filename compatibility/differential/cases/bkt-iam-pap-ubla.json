{
  "id": "bkt-iam-pap-ubla",
  "description": "Bucket IAM policy read, set and testPermissions (project principals only, never allUsers or allAuthenticatedUsers), then uniform bucket-level access and public access prevention toggles with their invalid inputs and aliases. Public access prevention is only ever enforced, never relaxed to make anything public.",
  "bucket": false,
  "steps": [
    {"name": "create", "method": "POST", "path": "/storage/v1/b", "query": {"project": "{project}"}, "body": {"name": "{new_bucket}", "location": "us-central1", "softDeletePolicy": {"retentionDurationSeconds": "0"}, "iamConfiguration": {"uniformBucketLevelAccess": {"enabled": false}}}, "expect_status": 200},
    {"name": "iam-get", "method": "GET", "path": "/storage/v1/b/{new_bucket}/iam", "capture": {"etag0": "body:etag"}, "expect_status": 200},
    {"name": "iam-get-version-3", "method": "GET", "path": "/storage/v1/b/{new_bucket}/iam", "query": {"optionsRequestedPolicyVersion": "3"}, "expect_status": 200},
    {"name": "iam-get-version-invalid", "method": "GET", "path": "/storage/v1/b/{new_bucket}/iam", "query": {"optionsRequestedPolicyVersion": "-1"}, "expect_status": 400},
    {"name": "iam-get-fields", "method": "GET", "path": "/storage/v1/b/{new_bucket}/iam", "query": {"fields": "version,resourceId"}, "expect_status": 200},
    {"name": "test-permissions", "method": "GET", "path": "/storage/v1/b/{new_bucket}/iam/testPermissions", "query": {"permissions": "storage.buckets.get"}, "expect_status": 200},
    {"name": "test-permissions-several", "method": "GET", "path": "/storage/v1/b/{new_bucket}/iam/testPermissions", "query": {"permissions": "storage.objects.list"}, "expect_status": 200},
    {"name": "test-permissions-unknown", "method": "GET", "path": "/storage/v1/b/{new_bucket}/iam/testPermissions", "query": {"permissions": "storage.noSuchPermission"}, "expect_status": 400},
    {"name": "test-permissions-missing-query", "method": "GET", "path": "/storage/v1/b/{new_bucket}/iam/testPermissions", "expect_status": 400},
    {"name": "test-permissions-project-level", "method": "GET", "path": "/storage/v1/b/{new_bucket}/iam/testPermissions", "query": {"permissions": "storage.buckets.create"}, "expect_status": 400},
    {"name": "iam-set", "method": "PUT", "path": "/storage/v1/b/{new_bucket}/iam", "body": {"version": 1, "etag": "{etag0}", "bindings": [{"role": "roles/storage.legacyBucketOwner", "members": ["projectEditor:{project}", "projectOwner:{project}"]}, {"role": "roles/storage.legacyBucketReader", "members": ["projectViewer:{project}"]}, {"role": "roles/storage.legacyObjectOwner", "members": ["projectEditor:{project}", "projectOwner:{project}"]}, {"role": "roles/storage.legacyObjectReader", "members": ["projectViewer:{project}"]}, {"role": "roles/storage.objectViewer", "members": ["projectViewer:{project}"]}]}, "expect_status": 200},
    {"name": "iam-get-after-set", "method": "GET", "path": "/storage/v1/b/{new_bucket}/iam", "capture": {"etag1": "body:etag"}, "expect_status": 200},
    {"name": "iam-set-stale-etag", "method": "PUT", "path": "/storage/v1/b/{new_bucket}/iam", "body": {"version": 1, "etag": "{etag0}", "bindings": [{"role": "roles/storage.legacyBucketOwner", "members": ["projectOwner:{project}"]}]}, "expect_status": 412},
    {"name": "iam-set-invalid-member", "method": "PUT", "path": "/storage/v1/b/{new_bucket}/iam", "body": {"version": 1, "etag": "{etag1}", "bindings": [{"role": "roles/storage.objectViewer", "members": ["nobody"]}]}, "expect_status": 400},
    {"name": "iam-set-invalid-role", "method": "PUT", "path": "/storage/v1/b/{new_bucket}/iam", "body": {"version": 1, "etag": "{etag1}", "bindings": [{"role": "roles/storage.noSuchRole", "members": ["projectViewer:{project}"]}]}, "expect_status": 400},
    {"name": "iam-set-empty-members", "method": "PUT", "path": "/storage/v1/b/{new_bucket}/iam", "body": {"version": 1, "etag": "{etag1}", "bindings": [{"role": "roles/storage.objectViewer", "members": []}]}, "expect_status": 400},
    {"name": "ubla-get-default", "method": "GET", "path": "/storage/v1/b/{new_bucket}", "query": {"fields": "iamConfiguration"}, "expect_status": 200},
    {"name": "ubla-enable", "method": "PATCH", "path": "/storage/v1/b/{new_bucket}", "body": {"iamConfiguration": {"uniformBucketLevelAccess": {"enabled": true}}}, "expect_status": 200},
    {"name": "ubla-get-enabled", "method": "GET", "path": "/storage/v1/b/{new_bucket}", "query": {"fields": "iamConfiguration"}, "expect_status": 200},
    {"name": "ubla-acl-list-rejected", "method": "GET", "path": "/storage/v1/b/{new_bucket}/acl", "expect_status": 400},
    {"name": "ubla-default-acl-list-rejected", "method": "GET", "path": "/storage/v1/b/{new_bucket}/defaultObjectAcl", "expect_status": 400},
    {"name": "ubla-predefined-acl-rejected", "method": "PATCH", "path": "/storage/v1/b/{new_bucket}", "query": {"predefinedAcl": "private"}, "body": {"labels": {"a": "1"}}, "expect_status": 400},
    {"name": "ubla-alias-bucket-policy-only", "method": "PATCH", "path": "/storage/v1/b/{new_bucket}", "body": {"iamConfiguration": {"bucketPolicyOnly": {"enabled": true}}}, "expect_status": 200},
    {"name": "ubla-read-only-locked-time-ignored", "method": "PATCH", "path": "/storage/v1/b/{new_bucket}", "body": {"iamConfiguration": {"uniformBucketLevelAccess": {"enabled": true, "lockedTime": "2000-01-01T00:00:00Z"}}}, "expect_status": 200},
    {"name": "ubla-null", "method": "PATCH", "path": "/storage/v1/b/{new_bucket}", "body": {"iamConfiguration": {"uniformBucketLevelAccess": null}}, "expect_status": 200},
    {"name": "ubla-get-after-null", "method": "GET", "path": "/storage/v1/b/{new_bucket}", "query": {"fields": "iamConfiguration"}, "expect_status": 200},
    {"name": "ubla-disable", "method": "PATCH", "path": "/storage/v1/b/{new_bucket}", "body": {"iamConfiguration": {"uniformBucketLevelAccess": {"enabled": false}}}, "expect_status": 200},
    {"name": "pap-enforce", "method": "PATCH", "path": "/storage/v1/b/{new_bucket}", "body": {"iamConfiguration": {"publicAccessPrevention": "enforced"}}, "expect_status": 200},
    {"name": "pap-get-enforced", "method": "GET", "path": "/storage/v1/b/{new_bucket}", "query": {"fields": "iamConfiguration"}, "expect_status": 200},
    {"name": "pap-invalid-value", "method": "PATCH", "path": "/storage/v1/b/{new_bucket}", "body": {"iamConfiguration": {"publicAccessPrevention": "bogus"}}, "expect_status": 400},
    {"name": "pap-unspecified", "method": "PATCH", "path": "/storage/v1/b/{new_bucket}", "body": {"iamConfiguration": {"publicAccessPrevention": "unspecified"}}, "expect_status": 400},
    {"name": "pap-set-inherited", "method": "PATCH", "path": "/storage/v1/b/{new_bucket}", "body": {"iamConfiguration": {"publicAccessPrevention": "inherited"}}, "expect_status": 200},
    {"name": "pap-null", "method": "PATCH", "path": "/storage/v1/b/{new_bucket}", "body": {"iamConfiguration": {"publicAccessPrevention": null}}, "expect_status": 400},
    {"name": "pap-get-final", "method": "GET", "path": "/storage/v1/b/{new_bucket}", "query": {"fields": "iamConfiguration"}, "expect_status": 200},
    {"name": "pap-put-omitted-preserves", "method": "PUT", "path": "/storage/v1/b/{new_bucket}", "body": {"name": "{new_bucket}"}, "query": {"fields": "iamConfiguration"}, "expect_status": 200},
    {"name": "delete", "method": "DELETE", "path": "/storage/v1/b/{new_bucket}", "expect_status": 204}
  ]
}
