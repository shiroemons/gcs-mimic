{
  "id": "obj-rewrite",
  "description": "Rewrite: a small object completes in one call, metadata body, storage class change, bad and unknown rewrite tokens, preconditions and missing source. Checks SPEC-REWRITE-EDGES and SPEC-DERIVED-METADATA.",
  "steps": [
    {"name": "upload", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "media", "name": "{object}"}, "headers": {"Content-Type": "text/plain"}, "body_text": "hello", "compare": false, "expect_status": 200},
    {"name": "patch-source", "method": "PATCH", "path": "/storage/v1/b/{bucket}/o/{object}", "body": {"metadata": {"a": "1"}, "cacheControl": "no-cache"}, "compare": false, "expect_status": 200},
    {"name": "rewrite-no-body", "method": "POST", "path": "/storage/v1/b/{bucket}/o/{object}/rewriteTo/b/{bucket}/o/{object2}", "expect_status": 200},
    {"name": "get-rewritten", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object2}", "expect_status": 200},
    {"name": "rewrite-null-body", "method": "POST", "path": "/storage/v1/b/{bucket}/o/{object}/rewriteTo/b/{bucket}/o/{object}-null", "headers": {"Content-Type": "application/json"}, "body_text": "null", "expect_status": 200},
    {"name": "rewrite-metadata-body", "method": "POST", "path": "/storage/v1/b/{bucket}/o/{object}/rewriteTo/b/{bucket}/o/{object}-meta", "body": {"contentType": "text/csv", "metadata": {"b": "2"}}, "expect_status": 200},
    {"name": "rewrite-storage-class", "method": "POST", "path": "/storage/v1/b/{bucket}/o/{object}/rewriteTo/b/{bucket}/o/{object}-cls", "body": {"storageClass": "NEARLINE"}, "expect_status": 200},
    {"name": "rewrite-max-bytes-per-call", "method": "POST", "path": "/storage/v1/b/{bucket}/o/{object}/rewriteTo/b/{bucket}/o/{object}-max", "query": {"maxBytesRewrittenPerCall": "1048576"}, "expect_status": 200},
    {"name": "rewrite-max-bytes-zero", "method": "POST", "path": "/storage/v1/b/{bucket}/o/{object}/rewriteTo/b/{bucket}/o/{object}-zero", "query": {"maxBytesRewrittenPerCall": "0"}, "expect_status": 200},
    {"name": "rewrite-max-bytes-small", "method": "POST", "path": "/storage/v1/b/{bucket}/o/{object}/rewriteTo/b/{bucket}/o/{object}-small", "query": {"maxBytesRewrittenPerCall": "1"}, "expect_status": 400},
    {"name": "rewrite-bogus-token", "method": "POST", "path": "/storage/v1/b/{bucket}/o/{object}/rewriteTo/b/{bucket}/o/{object}-tok", "query": {"rewriteToken": "bogus"}, "expect_status": 400},
    {"name": "rewrite-destination-exists", "method": "POST", "path": "/storage/v1/b/{bucket}/o/{object}/rewriteTo/b/{bucket}/o/{object2}", "query": {"ifGenerationMatch": "0"}, "expect_status": 412},
    {"name": "rewrite-source-generation-mismatch", "method": "POST", "path": "/storage/v1/b/{bucket}/o/{object}/rewriteTo/b/{bucket}/o/{object}-pre", "query": {"ifSourceGenerationMatch": "1"}, "expect_status": 412},
    {"name": "rewrite-source-missing", "method": "POST", "path": "/storage/v1/b/{bucket}/o/{object}-nosuch/rewriteTo/b/{bucket}/o/{object}-x", "expect_status": 404},
    {"name": "rewrite-onto-itself", "method": "POST", "path": "/storage/v1/b/{bucket}/o/{object}/rewriteTo/b/{bucket}/o/{object}", "body": {"metadata": {"c": "3"}}, "expect_status": 200},
    {"name": "cleanup-main", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}", "compare": false},
    {"name": "cleanup-rewritten", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object2}", "compare": false},
    {"name": "cleanup-null", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-null", "compare": false},
    {"name": "cleanup-meta", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-meta", "compare": false},
    {"name": "cleanup-cls", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-cls", "compare": false},
    {"name": "cleanup-max", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-max", "compare": false},
    {"name": "cleanup-zero", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-zero", "compare": false}
  ]
}
