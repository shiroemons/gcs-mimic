{
  "id": "obj-restore-match-and-not-match",
  "description": "Restore of a soft-deleted generation with ifGenerationMatch=0 and ifGenerationNotMatch=1 sent together while no live object remains. The fresh bucket keeps soft-deleted objects for the 7-day minimum. The 2026-11-15 live recording shows that Cloud Storage evaluates both conditions instead of refusing the pair: the not-match condition fails without a live object, so the restore answers 412.",
  "bucket": false,
  "steps": [
    {"name": "create", "method": "POST", "path": "/storage/v1/b", "query": {"project": "{project}", "fields": "name"}, "body": {"name": "{new_bucket}", "location": "us-central1", "storageClass": "STANDARD", "softDeletePolicy": {"retentionDurationSeconds": "604800"}, "iamConfiguration": {"publicAccessPrevention": "enforced"}}, "expect_status": 200},
    {"name": "upload", "method": "POST", "path": "/upload/storage/v1/b/{new_bucket}/o", "query": {"uploadType": "media", "name": "{object}"}, "headers": {"Content-Type": "text/plain"}, "body_text": "hello", "capture": {"gen": "body:generation"}, "expect_status": 200},
    {"name": "delete", "method": "DELETE", "path": "/storage/v1/b/{new_bucket}/o/{object}", "expect_status": 204},
    {"name": "restore-both", "method": "POST", "path": "/storage/v1/b/{new_bucket}/o/{object}/restore", "query": {"generation": "{gen}", "ifGenerationMatch": "0", "ifGenerationNotMatch": "1", "fields": "name"}, "expect_status": 412}
  ]
}
