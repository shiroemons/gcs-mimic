{
  "id": "grpc-probe-bucket-masks",
  "description": "Storage v2 bucket read and update masks, the bucket etag and fractional durations, on an empty bucket of its own. Read masks: nested GetBucket paths (a leaf of a message, a mixed list, a sub-field of the repeated acl, a labels key, an unknown leaf), an unknown top-level bucket path (the object counterpart was recorded in grpc-read-mask), a nested and an unknown ListBuckets path, and ListBuckets with page_size -1 alone and together with the unknown path. UpdateBucket: a superseded and the current bucket.etag, an unknown path, the output-only create_time and update_time paths, an empty and an absent update_mask, and a * mask, each resending the whole bucket (labels with the harness label, public access prevention enforced, soft delete 0s and the project ACLs, so a full replacement keeps every setting the cleanup needs); retention_policy.retention_duration 5.5s, then removal through the mask, and soft_delete_policy.retention_duration 604800.5s. CreateBucket is refused by the harness, so the fractional retention on creation is not asked. The final step removes the retention policy, turns soft delete off and enforces public access prevention again. Asks RPC-STORAGE-002 grpc_bucket_get_nested_mask, RPC-STORAGE-004 grpc_bucket_list_nested_mask, RPC-STORAGE-009 grpc_bucket_update_etag, grpc_bucket_update_wildcard_mask and grpc_bucket_update_retention_nanos and its soft delete scoped difference, and BEHAVIOR-RPC-002 grpc_masks_nested_paths, grpc_masks_wildcard_update, grpc_masks_unknown_bucket_path, grpc_masks_output_only_update_paths and grpc_masks_validation_order (SPEC-GRPC-LOCAL-CHOICES).",
  "bucket": "own",
  "steps": [
    {"name": "get-nested-public-access-prevention", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"name": "projects/_/buckets/{bucket}", "readMask": {"paths": ["iam_config.public_access_prevention"]}}, "local_choice": {"reason": "Nested read mask paths are not implemented; gcs-mimic rejects the path where Cloud Storage returns the selected member (SPEC-GRPC-LOCAL-CHOICES).", "mimic_status": 12}},
    {"name": "get-nested-mixed", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"name": "projects/_/buckets/{bucket}", "readMask": {"paths": ["name", "soft_delete_policy.retention_duration", "iam_config.uniform_bucket_level_access.enabled"]}}, "local_choice": {"reason": "Nested read mask paths are not implemented; gcs-mimic rejects the path where Cloud Storage returns the selected member (SPEC-GRPC-LOCAL-CHOICES).", "mimic_status": 12}},
    {"name": "get-nested-repeated", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"name": "projects/_/buckets/{bucket}", "readMask": {"paths": ["acl.role"]}}, "local_choice": {"reason": "Nested read mask paths are not implemented; gcs-mimic rejects every path under a bucket field with UNIMPLEMENTED, where Cloud Storage answers INVALID_ARGUMENT for one that names no member (SPEC-GRPC-LOCAL-CHOICES).", "mimic_status": 12}},
    {"name": "get-nested-labels-key", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"name": "projects/_/buckets/{bucket}", "readMask": {"paths": ["labels.gcs-mimic-differential"]}}, "local_choice": {"reason": "Nested read mask paths are not implemented; gcs-mimic rejects every path under a bucket field with UNIMPLEMENTED, where Cloud Storage answers INVALID_ARGUMENT for one that names no member (SPEC-GRPC-LOCAL-CHOICES).", "mimic_status": 12}},
    {"name": "get-nested-unknown-leaf", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"name": "projects/_/buckets/{bucket}", "readMask": {"paths": ["versioning.no_such_field"]}}, "local_choice": {"reason": "Nested read mask paths are not implemented; gcs-mimic rejects every path under a bucket field with UNIMPLEMENTED, where Cloud Storage answers INVALID_ARGUMENT for one that names no member (SPEC-GRPC-LOCAL-CHOICES).", "mimic_status": 12}},
    {"name": "get-unknown-path", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"name": "projects/_/buckets/{bucket}", "readMask": {"paths": ["no_such_field"]}}},
    {"name": "list-nested", "protocol": "grpc", "rpc": "google.storage.v2.Storage/ListBuckets", "headers": {"x-goog-request-params": "project=projects%2F{project}"}, "body": {"parent": "projects/{project}", "prefix": "{bucket}", "readMask": {"paths": ["name", "iam_config.public_access_prevention"]}}, "local_choice": {"reason": "Nested read mask paths are not implemented; gcs-mimic rejects the path where Cloud Storage returns the selected member (SPEC-GRPC-LOCAL-CHOICES).", "mimic_status": 12}},
    {"name": "list-unknown-path", "protocol": "grpc", "rpc": "google.storage.v2.Storage/ListBuckets", "headers": {"x-goog-request-params": "project=projects%2F{project}"}, "body": {"parent": "projects/{project}", "prefix": "{bucket}", "readMask": {"paths": ["no_such_field"]}}},
    {"name": "list-negative-page-size", "protocol": "grpc", "rpc": "google.storage.v2.Storage/ListBuckets", "headers": {"x-goog-request-params": "project=projects%2F{project}"}, "body": {"parent": "projects/{project}", "prefix": "{bucket}", "pageSize": -1, "readMask": {"paths": ["name"]}}},
    {"name": "list-negative-page-size-unknown-path", "protocol": "grpc", "rpc": "google.storage.v2.Storage/ListBuckets", "headers": {"x-goog-request-params": "project=projects%2F{project}"}, "body": {"parent": "projects/{project}", "prefix": "{bucket}", "pageSize": -1, "readMask": {"paths": ["no_such_field"]}}},
    {"name": "get-acl-and-etag", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"name": "projects/_/buckets/{bucket}", "readMask": {"paths": ["acl", "default_object_acl", "etag", "metageneration"]}}, "capture": {"pn": "body:acl.0.projectTeam.projectNumber", "etag1": "body:etag"}, "expect_status": 0},
    {"name": "update-label", "protocol": "grpc", "rpc": "google.storage.v2.Storage/UpdateBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": {"name": "projects/_/buckets/{bucket}", "labels": {"probe": "a"}}, "updateMask": {"paths": ["labels.probe"]}}, "compare": false},
    {"name": "update-superseded-etag", "protocol": "grpc", "rpc": "google.storage.v2.Storage/UpdateBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": {"name": "projects/_/buckets/{bucket}", "etag": "{etag1}", "labels": {"probe": "superseded-etag"}}, "updateMask": {"paths": ["labels.probe"]}}},
    {"name": "get-etag-before-current", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"name": "projects/_/buckets/{bucket}", "readMask": {"paths": ["etag", "metageneration", "labels"]}}, "capture": {"etag2": "body:etag"}, "expect_status": 0},
    {"name": "update-current-etag", "protocol": "grpc", "rpc": "google.storage.v2.Storage/UpdateBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": {"name": "projects/_/buckets/{bucket}", "etag": "{etag2}", "labels": {"probe": "current-etag"}}, "updateMask": {"paths": ["labels.probe"]}}},
    {"name": "update-unknown-path", "protocol": "grpc", "rpc": "google.storage.v2.Storage/UpdateBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": {"name": "projects/_/buckets/{bucket}"}, "updateMask": {"paths": ["no_such_field"]}}},
    {"name": "update-output-only-create-time", "protocol": "grpc", "rpc": "google.storage.v2.Storage/UpdateBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": {"name": "projects/_/buckets/{bucket}", "createTime": "2020-01-01T00:00:00Z"}, "updateMask": {"paths": ["create_time"]}}},
    {"name": "update-output-only-update-time", "protocol": "grpc", "rpc": "google.storage.v2.Storage/UpdateBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": {"name": "projects/_/buckets/{bucket}", "updateTime": "2020-01-01T00:00:00Z"}, "updateMask": {"paths": ["update_time"]}}},
    {"name": "update-empty-mask", "protocol": "grpc", "rpc": "google.storage.v2.Storage/UpdateBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": {"name": "projects/_/buckets/{bucket}", "storageClass": "STANDARD", "labels": {"gcs-mimic-differential": "1", "probe": "empty-mask"}, "iamConfig": {"publicAccessPrevention": "enforced"}, "softDeletePolicy": {"retentionDuration": "0s"}, "acl": [{"entity": "project-owners-{pn}", "role": "OWNER"}, {"entity": "project-editors-{pn}", "role": "OWNER"}, {"entity": "project-viewers-{pn}", "role": "READER"}], "defaultObjectAcl": [{"entity": "project-owners-{pn}", "role": "OWNER"}, {"entity": "project-editors-{pn}", "role": "OWNER"}, {"entity": "project-viewers-{pn}", "role": "READER"}]}, "updateMask": {}}},
    {"name": "update-absent-mask", "protocol": "grpc", "rpc": "google.storage.v2.Storage/UpdateBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": {"name": "projects/_/buckets/{bucket}", "storageClass": "STANDARD", "labels": {"gcs-mimic-differential": "1", "probe": "absent-mask"}, "iamConfig": {"publicAccessPrevention": "enforced"}, "softDeletePolicy": {"retentionDuration": "0s"}, "acl": [{"entity": "project-owners-{pn}", "role": "OWNER"}, {"entity": "project-editors-{pn}", "role": "OWNER"}, {"entity": "project-viewers-{pn}", "role": "READER"}], "defaultObjectAcl": [{"entity": "project-owners-{pn}", "role": "OWNER"}, {"entity": "project-editors-{pn}", "role": "OWNER"}, {"entity": "project-viewers-{pn}", "role": "READER"}]}}},
    {"name": "update-wildcard-mask", "protocol": "grpc", "rpc": "google.storage.v2.Storage/UpdateBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": {"name": "projects/_/buckets/{bucket}", "storageClass": "STANDARD", "labels": {"gcs-mimic-differential": "1", "probe": "wildcard"}, "iamConfig": {"publicAccessPrevention": "enforced"}, "softDeletePolicy": {"retentionDuration": "0s"}, "acl": [{"entity": "project-owners-{pn}", "role": "OWNER"}, {"entity": "project-editors-{pn}", "role": "OWNER"}, {"entity": "project-viewers-{pn}", "role": "READER"}], "defaultObjectAcl": [{"entity": "project-owners-{pn}", "role": "OWNER"}, {"entity": "project-editors-{pn}", "role": "OWNER"}, {"entity": "project-viewers-{pn}", "role": "READER"}]}, "updateMask": {"paths": ["*"]}}, "local_choice": {"reason": "The * update mask, which replaces every bucket setting, is not implemented; gcs-mimic rejects it (SPEC-GRPC-LOCAL-CHOICES).", "mimic_status": 12}},
    {"name": "get-after-wildcard", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"name": "projects/_/buckets/{bucket}"}, "compare": {"ignore_body_paths": ["$.acl", "$.defaultObjectAcl", "$.owner", "$.billing", "$.logging", "$.versioning", "$.labels.probe", "$.metageneration"]}},
    {"name": "update-retention-nanos", "protocol": "grpc", "rpc": "google.storage.v2.Storage/UpdateBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": {"name": "projects/_/buckets/{bucket}", "retentionPolicy": {"retentionDuration": "5.5s"}}, "updateMask": {"paths": ["retention_policy"]}}, "compare": {"ignore_body_paths": ["$.billing", "$.logging", "$.versioning", "$.labels.probe", "$.metageneration"]}},
    {"name": "get-retention", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"name": "projects/_/buckets/{bucket}", "readMask": {"paths": ["retention_policy"]}}},
    {"name": "update-retention-remove", "protocol": "grpc", "rpc": "google.storage.v2.Storage/UpdateBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": {"name": "projects/_/buckets/{bucket}"}, "updateMask": {"paths": ["retention_policy"]}}, "compare": {"ignore_body_paths": ["$.billing", "$.logging", "$.versioning", "$.labels.probe", "$.metageneration"]}},
    {"name": "get-retention-after-remove", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"name": "projects/_/buckets/{bucket}", "readMask": {"paths": ["retention_policy"]}}},
    {"name": "update-soft-delete-nanos", "protocol": "grpc", "rpc": "google.storage.v2.Storage/UpdateBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": {"name": "projects/_/buckets/{bucket}", "softDeletePolicy": {"retentionDuration": "604800.5s"}}, "updateMask": {"paths": ["soft_delete_policy"]}}},
    {"name": "get-soft-delete", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"name": "projects/_/buckets/{bucket}", "readMask": {"paths": ["soft_delete_policy"]}}},
    {"name": "restore-settings", "method": "PATCH", "path": "/storage/v1/b/{bucket}", "query": {"fields": "name"}, "body": {"retentionPolicy": null, "softDeletePolicy": {"retentionDurationSeconds": "0"}, "iamConfiguration": {"publicAccessPrevention": "enforced"}, "labels": {"gcs-mimic-differential": "1"}}, "compare": false, "always": true}
  ]
}
