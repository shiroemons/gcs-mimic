{
  "id": "grpc-probe-resumable-sessions",
  "description": "Storage v2 resumable session answers that the ledger keeps as local choices, on the shared bucket: StartResumableWrite with a malformed customer-supplied key (31 bytes; the WriteObject answer was recorded in grpc-csek); CancelResumableWrite on a finalized upload, then QueryWriteStatus of it; a cancel, a repeated cancel, QueryWriteStatus and a resumed WriteObject on the cancelled upload; and CancelResumableWrite and QueryWriteStatus for upload_id values the service never issued: a real one with a character appended, one under the bucket's resource name, one without it, and an empty one. The routing template of both RPCs takes the bucket from an upload_id that starts with the bucket's resource name, so the last three steps send no x-goog-request-params, as an SDK would. Session starts capture the upload_id and are not compared; the malformed-key start compares without uploadId in case the service accepts it. Asks RPC-STORAGE-013 (its scoped local choices), RPC-STORAGE-022 and RPC-STORAGE-023 (SPEC-GRPC-LOCAL-CHOICES, SPEC-GRPC-CSEK).",
  "steps": [
    {"name": "start-malformed-key", "protocol": "grpc", "rpc": "google.storage.v2.Storage/StartResumableWrite", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-key", "contentType": "text/plain"}}, "commonObjectRequestParams": {"encryptionAlgorithm": "AES256", "encryptionKeyBytes": "AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQ==", "encryptionKeySha256Bytes": "zF9s8y82Hp+1BQbHCoZsJb9ZVv8JXNXJaOuxTyJBKmM="}}, "compare": {"ignore_body_paths": ["$.uploadId"]}},
    {"name": "start-finalized", "protocol": "grpc", "rpc": "google.storage.v2.Storage/StartResumableWrite", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-a", "contentType": "text/plain"}}}, "capture": {"upa": "body:uploadId"}, "compare": false, "expect_status": 0},
    {"name": "finish-finalized", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"uploadId": "{upa}", "writeOffset": "0", "checksummedData": {"content": "aGVsbG8="}, "finishWrite": true}], "compare": false},
    {"name": "cancel-finalized", "protocol": "grpc", "rpc": "google.storage.v2.Storage/CancelResumableWrite", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"uploadId": "{upa}"}},
    {"name": "status-after-cancel-finalized", "protocol": "grpc", "rpc": "google.storage.v2.Storage/QueryWriteStatus", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"uploadId": "{upa}"}},
    {"name": "start-cancelled", "protocol": "grpc", "rpc": "google.storage.v2.Storage/StartResumableWrite", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-b", "contentType": "text/plain"}}}, "capture": {"upb": "body:uploadId"}, "compare": false, "expect_status": 0},
    {"name": "cancel", "protocol": "grpc", "rpc": "google.storage.v2.Storage/CancelResumableWrite", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"uploadId": "{upb}"}},
    {"name": "cancel-again", "protocol": "grpc", "rpc": "google.storage.v2.Storage/CancelResumableWrite", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"uploadId": "{upb}"}},
    {"name": "status-cancelled", "protocol": "grpc", "rpc": "google.storage.v2.Storage/QueryWriteStatus", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"uploadId": "{upb}"}},
    {"name": "write-cancelled", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"uploadId": "{upb}", "writeOffset": "0", "checksummedData": {"content": "aGVsbG8="}, "finishWrite": true}]},
    {"name": "cancel-appended", "protocol": "grpc", "rpc": "google.storage.v2.Storage/CancelResumableWrite", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"uploadId": "{upb}x"}},
    {"name": "status-appended", "protocol": "grpc", "rpc": "google.storage.v2.Storage/QueryWriteStatus", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"uploadId": "{upb}x"}},
    {"name": "cancel-unknown-under-bucket", "protocol": "grpc", "rpc": "google.storage.v2.Storage/CancelResumableWrite", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"uploadId": "projects/_/buckets/{bucket}/unknown-upload-id"}},
    {"name": "status-unknown-under-bucket", "protocol": "grpc", "rpc": "google.storage.v2.Storage/QueryWriteStatus", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"uploadId": "projects/_/buckets/{bucket}/unknown-upload-id"}},
    {"name": "cancel-malformed", "protocol": "grpc", "rpc": "google.storage.v2.Storage/CancelResumableWrite", "body": {"uploadId": "not-an-upload-id"}},
    {"name": "status-malformed", "protocol": "grpc", "rpc": "google.storage.v2.Storage/QueryWriteStatus", "body": {"uploadId": "not-an-upload-id"}},
    {"name": "cancel-empty", "protocol": "grpc", "rpc": "google.storage.v2.Storage/CancelResumableWrite", "body": {"uploadId": ""}}
  ]
}
