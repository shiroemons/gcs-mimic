{
  "id": "obj-probe-noncurrent-delete-conditions",
  "description": "Generation-specific deletes of noncurrent generations with ifGenerationMatch, ifGenerationNotMatch, ifMetagenerationMatch and ifMetagenerationNotMatch, each failing and holding: first on an object whose live generation has metageneration 2, then on a second object that has no live generation. Each condition is probed on its own generation with the failing value first, and each generation's content has its own length, so the version listings show by size which generations remain. While the live generation exists, every value is chosen so that evaluating it against the selected generation or against the live one predicts opposite outcomes. Pairs in which one condition holds and the other fails come first in each part and fail under either reading. Versioning is on for the case and off again at the end, and every generation is deleted. Checks SPEC-VERSION-DELETE-CONDITIONS.",
  "bucket": "own",
  "steps": [
    {"name": "enable-versioning", "method": "PATCH", "path": "/storage/v1/b/{bucket}", "query": {"fields": "name,versioning"}, "body": {"versioning": {"enabled": true}}, "expect_status": 200},
    {"name": "upload-n1", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "media", "name": "{object}"}, "headers": {"Content-Type": "text/plain"}, "body_text": "1", "capture": {"n1": "body:generation"}, "compare": false, "expect_status": 200},
    {"name": "upload-n2", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "media", "name": "{object}"}, "headers": {"Content-Type": "text/plain"}, "body_text": "22", "capture": {"n2": "body:generation"}, "compare": false, "expect_status": 200},
    {"name": "upload-n3", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "media", "name": "{object}"}, "headers": {"Content-Type": "text/plain"}, "body_text": "333", "capture": {"n3": "body:generation"}, "compare": false, "expect_status": 200},
    {"name": "upload-n4", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "media", "name": "{object}"}, "headers": {"Content-Type": "text/plain"}, "body_text": "4444", "capture": {"n4": "body:generation"}, "compare": false, "expect_status": 200},
    {"name": "upload-live", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "media", "name": "{object}"}, "headers": {"Content-Type": "text/plain"}, "body_text": "55555", "capture": {"live": "body:generation"}, "compare": false, "expect_status": 200},
    {"name": "patch-live", "method": "PATCH", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"fields": "name,generation,metageneration"}, "body": {"metadata": {"k": "v"}}, "expect_status": 200},
    {"name": "list-versions-before", "method": "GET", "path": "/storage/v1/b/{bucket}/o", "query": {"prefix": "{object}", "versions": "true", "fields": "items(name,size,metageneration,timeDeleted)"}, "expect_status": 200},
    {"name": "live-pair-generation-holds-metageneration-fails", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"generation": "{n1}", "ifGenerationMatch": "{n1}", "ifMetagenerationNotMatch": "1"}},
    {"name": "live-pair-not-match-holds-metageneration-fails", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"generation": "{n2}", "ifGenerationNotMatch": "{live}", "ifMetagenerationMatch": "2"}},
    {"name": "live-generation-match-live-value", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"generation": "{n1}", "ifGenerationMatch": "{live}"}},
    {"name": "live-generation-match-selected-value", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"generation": "{n1}", "ifGenerationMatch": "{n1}"}},
    {"name": "live-generation-not-match-selected-value", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"generation": "{n2}", "ifGenerationNotMatch": "{n2}"}},
    {"name": "live-generation-not-match-live-value", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"generation": "{n2}", "ifGenerationNotMatch": "{live}"}},
    {"name": "live-metageneration-match-live-value", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"generation": "{n3}", "ifMetagenerationMatch": "2"}},
    {"name": "live-metageneration-match-selected-value", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"generation": "{n3}", "ifMetagenerationMatch": "1"}},
    {"name": "live-metageneration-not-match-selected-value", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"generation": "{n4}", "ifMetagenerationNotMatch": "1"}},
    {"name": "live-metageneration-not-match-live-value", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"generation": "{n4}", "ifMetagenerationNotMatch": "2"}},
    {"name": "get-live-after-probes", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"fields": "name,generation,metageneration"}, "expect_status": 200},
    {"name": "list-versions-after-live-probes", "method": "GET", "path": "/storage/v1/b/{bucket}/o", "query": {"prefix": "{object}", "versions": "true", "fields": "items(name,size,metageneration,timeDeleted)"}, "expect_status": 200},
    {"name": "upload-m1", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "media", "name": "{object2}"}, "headers": {"Content-Type": "text/plain"}, "body_text": "1", "capture": {"m1": "body:generation"}, "compare": false, "expect_status": 200},
    {"name": "upload-m2", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "media", "name": "{object2}"}, "headers": {"Content-Type": "text/plain"}, "body_text": "22", "capture": {"m2": "body:generation"}, "compare": false, "expect_status": 200},
    {"name": "upload-m3", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "media", "name": "{object2}"}, "headers": {"Content-Type": "text/plain"}, "body_text": "333", "capture": {"m3": "body:generation"}, "compare": false, "expect_status": 200},
    {"name": "upload-m4", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "media", "name": "{object2}"}, "headers": {"Content-Type": "text/plain"}, "body_text": "4444", "capture": {"m4": "body:generation"}, "compare": false, "expect_status": 200},
    {"name": "delete-live-object2", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object2}", "expect_status": 204},
    {"name": "get-object2-without-live", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object2}", "query": {"fields": "name"}, "expect_status": 404},
    {"name": "none-pair-generation-holds-metageneration-fails", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object2}", "query": {"generation": "{m1}", "ifGenerationMatch": "{m1}", "ifMetagenerationNotMatch": "1"}},
    {"name": "none-pair-metageneration-holds-not-match-fails", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object2}", "query": {"generation": "{m2}", "ifGenerationNotMatch": "{m2}", "ifMetagenerationMatch": "1"}},
    {"name": "none-generation-match-other-value", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object2}", "query": {"generation": "{m1}", "ifGenerationMatch": "{m2}"}},
    {"name": "none-generation-match-selected-value", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object2}", "query": {"generation": "{m1}", "ifGenerationMatch": "{m1}"}},
    {"name": "none-generation-not-match-selected-value", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object2}", "query": {"generation": "{m2}", "ifGenerationNotMatch": "{m2}"}},
    {"name": "none-generation-not-match-other-value", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object2}", "query": {"generation": "{m2}", "ifGenerationNotMatch": "{m3}"}},
    {"name": "none-metageneration-match-other-value", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object2}", "query": {"generation": "{m3}", "ifMetagenerationMatch": "2"}},
    {"name": "none-metageneration-match-selected-value", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object2}", "query": {"generation": "{m3}", "ifMetagenerationMatch": "1"}},
    {"name": "none-metageneration-not-match-selected-value", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object2}", "query": {"generation": "{m4}", "ifMetagenerationNotMatch": "1"}},
    {"name": "none-metageneration-not-match-other-value", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object2}", "query": {"generation": "{m4}", "ifMetagenerationNotMatch": "2"}},
    {"name": "list-versions-after-no-live-probes", "method": "GET", "path": "/storage/v1/b/{bucket}/o", "query": {"prefix": "{object2}", "versions": "true", "fields": "items(name,size,metageneration,timeDeleted)"}, "expect_status": 200},
    {"name": "cleanup-n1", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"generation": "{n1}"}, "compare": false},
    {"name": "cleanup-n2", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"generation": "{n2}"}, "compare": false},
    {"name": "cleanup-n3", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"generation": "{n3}"}, "compare": false},
    {"name": "cleanup-n4", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"generation": "{n4}"}, "compare": false},
    {"name": "cleanup-live", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"generation": "{live}"}, "compare": false},
    {"name": "cleanup-m1", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object2}", "query": {"generation": "{m1}"}, "compare": false},
    {"name": "cleanup-m2", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object2}", "query": {"generation": "{m2}"}, "compare": false},
    {"name": "cleanup-m3", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object2}", "query": {"generation": "{m3}"}, "compare": false},
    {"name": "cleanup-m4", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object2}", "query": {"generation": "{m4}"}, "compare": false},
    {"name": "list-versions-after-cleanup", "method": "GET", "path": "/storage/v1/b/{bucket}/o", "query": {"versions": "true", "fields": "items(name)"}, "expect_status": 200},
    {"name": "disable-versioning", "method": "PATCH", "path": "/storage/v1/b/{bucket}", "query": {"fields": "name,versioning"}, "body": {"versioning": {"enabled": false}}, "expect_status": 200, "always": true}
  ]
}
