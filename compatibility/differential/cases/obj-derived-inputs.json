{
  "id": "obj-derived-inputs",
  "description": "Copy and rewrite inputs not recorded by obj-copy and obj-rewrite: a zero-byte source, a whitespace body, null and empty metadata maps, an empty contentType, a body name or bucket that differs from the path, unknown and output-only body fields, and a missing source together with a failing destination condition. Checks SPEC-DERIVED-METADATA and SPEC-REWRITE-EDGES.",
  "steps": [
    {"name": "upload", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "media", "name": "{object}"}, "headers": {"Content-Type": "text/plain"}, "body_text": "hello", "compare": false, "expect_status": 200},
    {"name": "set-metadata", "method": "PATCH", "path": "/storage/v1/b/{bucket}/o/{object}", "body": {"metadata": {"k": "v"}, "contentLanguage": "en"}, "compare": false, "expect_status": 200},
    {"name": "upload-empty", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "media", "name": "{object}-empty"}, "headers": {"Content-Type": "text/plain"}, "body_text": "", "compare": false, "expect_status": 200},
    {"name": "copy-zero-byte", "method": "POST", "path": "/storage/v1/b/{bucket}/o/{object}-empty/copyTo/b/{bucket}/o/{object}-c0", "query": {"fields": "name,size,md5Hash,crc32c,contentType"}},
    {"name": "copy-whitespace-body", "method": "POST", "path": "/storage/v1/b/{bucket}/o/{object}/copyTo/b/{bucket}/o/{object}-c1", "headers": {"Content-Type": "application/json"}, "body_text": " ", "query": {"fields": "name,metadata,contentLanguage"}},
    {"name": "copy-metadata-null", "method": "POST", "path": "/storage/v1/b/{bucket}/o/{object}/copyTo/b/{bucket}/o/{object}-c2", "query": {"fields": "name,metadata,contentLanguage,contentType"}, "body": {"metadata": null}},
    {"name": "copy-metadata-empty", "method": "POST", "path": "/storage/v1/b/{bucket}/o/{object}/copyTo/b/{bucket}/o/{object}-c3", "query": {"fields": "name,metadata,contentLanguage,contentType"}, "body": {"metadata": {}}},
    {"name": "copy-content-type-empty", "method": "POST", "path": "/storage/v1/b/{bucket}/o/{object}/copyTo/b/{bucket}/o/{object}-c4", "query": {"fields": "name,metadata,contentType"}, "body": {"contentType": ""}},
    {"name": "copy-body-name-differs", "method": "POST", "path": "/storage/v1/b/{bucket}/o/{object}/copyTo/b/{bucket}/o/{object}-c5", "query": {"fields": "name,bucket"}, "body": {"name": "{object}-other", "bucket": "{missing_bucket}"}},
    {"name": "copy-unknown-field", "method": "POST", "path": "/storage/v1/b/{bucket}/o/{object}/copyTo/b/{bucket}/o/{object}-c6", "query": {"fields": "name"}, "body": {"gcsmimicUnknown": "x"}},
    {"name": "copy-output-only-fields", "method": "POST", "path": "/storage/v1/b/{bucket}/o/{object}/copyTo/b/{bucket}/o/{object}-c7", "query": {"fields": "name,size,generation,md5Hash,timeCreated"}, "body": {"size": "999", "generation": "1", "md5Hash": "AAAAAAAAAAAAAAAAAAAAAA==", "timeCreated": "2000-01-01T00:00:00Z"}},
    {"name": "rewrite-zero-byte", "method": "POST", "path": "/storage/v1/b/{bucket}/o/{object}-empty/rewriteTo/b/{bucket}/o/{object}-r0", "query": {"fields": "done,totalBytesRewritten,objectSize,resource/size"}},
    {"name": "rewrite-unknown-field", "method": "POST", "path": "/storage/v1/b/{bucket}/o/{object}/rewriteTo/b/{bucket}/o/{object}-r1", "query": {"fields": "done,resource/name"}, "body": {"gcsmimicUnknown": "x"}},
    {"name": "rewrite-output-only-fields", "method": "POST", "path": "/storage/v1/b/{bucket}/o/{object}/rewriteTo/b/{bucket}/o/{object}-r2", "query": {"fields": "done,resource/size,resource/md5Hash"}, "body": {"size": "999", "md5Hash": "AAAAAAAAAAAAAAAAAAAAAA=="}},
    {"name": "rewrite-metadata-null", "method": "POST", "path": "/storage/v1/b/{bucket}/o/{object}/rewriteTo/b/{bucket}/o/{object}-r3", "query": {"fields": "done,resource/metadata,resource/contentLanguage"}, "body": {"metadata": null}},
    {"name": "rewrite-missing-source-failing-destination-condition", "method": "POST", "path": "/storage/v1/b/{bucket}/o/{object}-missing/rewriteTo/b/{bucket}/o/{object}", "query": {"ifGenerationMatch": "1"}},
    {"name": "copy-missing-source-failing-destination-condition", "method": "POST", "path": "/storage/v1/b/{bucket}/o/{object}-missing/copyTo/b/{bucket}/o/{object}", "query": {"ifGenerationMatch": "1"}},
    {"name": "rewrite-failing-source-and-destination-conditions", "method": "POST", "path": "/storage/v1/b/{bucket}/o/{object}/rewriteTo/b/{bucket}/o/{object}", "query": {"ifSourceGenerationMatch": "1", "ifGenerationMatch": "1"}},
    {"name": "cleanup-main", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}", "compare": false, "always": true},
    {"name": "cleanup-empty", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-empty", "compare": false, "always": true},
    {"name": "cleanup-c0", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-c0", "compare": false, "always": true},
    {"name": "cleanup-c1", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-c1", "compare": false, "always": true},
    {"name": "cleanup-c2", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-c2", "compare": false, "always": true},
    {"name": "cleanup-c3", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-c3", "compare": false, "always": true},
    {"name": "cleanup-c4", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-c4", "compare": false, "always": true},
    {"name": "cleanup-c5", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-c5", "compare": false, "always": true},
    {"name": "cleanup-c6", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-c6", "compare": false, "always": true},
    {"name": "cleanup-c7", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-c7", "compare": false, "always": true},
    {"name": "cleanup-r0", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-r0", "compare": false, "always": true},
    {"name": "cleanup-r1", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-r1", "compare": false, "always": true},
    {"name": "cleanup-r2", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-r2", "compare": false, "always": true},
    {"name": "cleanup-r3", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-r3", "compare": false, "always": true}
  ]
}
