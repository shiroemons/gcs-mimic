{
  "id": "grpc-unsupported-options",
  "description": "Storage v2 options that gcs-mimic rejects with UNIMPLEMENTED, and the derived RPC responses it infers: nested and mixed-wildcard bucket read masks, return_partial_success on ListBuckets, predefined ACLs on UpdateBucket and UpdateObject, a wildcard object update mask, ComposeObject and RewriteObject with a predefined ACL, a wrong checksum and a custom time, source deletion on compose, MoveObject in a flat-namespace bucket, policy version 2 and child resources on IAM RPCs. No retention policy is locked. Cloud Storage applies the predefined bucket ACL and the wildcard object update that gcs-mimic rejects, so the later rewrite, move and policy read ignore the content type, content language and bindings those updates changed there. Checks SPEC-SDK-UNSUPPORTED, SPEC-GRPC-DERIVED-OWNER-VIEW and SPEC-001.",
  "bucket": "own",
  "steps": [
    {"name": "write-a", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-a", "contentType": "text/plain"}, "objectSize": "5"}, "checksummedData": {"content": "aGVsbG8="}, "finishWrite": true}], "compare": false, "expect_status": 0},
    {"name": "write-b", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-b", "contentType": "text/plain"}, "objectSize": "5"}, "checksummedData": {"content": "aGVsbG8="}, "finishWrite": true}], "compare": false, "expect_status": 0},
    {"name": "get-bucket-nested-mask", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"name": "projects/_/buckets/{bucket}", "readMask": {"paths": ["versioning.enabled"]}}, "local_choice": {"reason": "Not implemented yet; gcs-mimic rejects the option (SPEC-SDK-UNSUPPORTED).", "mimic_status": 12}},
    {"name": "get-bucket-mixed-wildcard-mask", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"name": "projects/_/buckets/{bucket}", "readMask": {"paths": ["*", "name"]}}},
    {"name": "list-buckets-partial-success", "protocol": "grpc", "rpc": "google.storage.v2.Storage/ListBuckets", "headers": {"x-goog-request-params": "project=projects%2F{project}"}, "body": {"parent": "projects/{project}", "prefix": "{bucket}", "returnPartialSuccess": true, "readMask": {"paths": ["name"]}}},
    {"name": "update-bucket-predefined-acl", "protocol": "grpc", "rpc": "google.storage.v2.Storage/UpdateBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": {"name": "projects/_/buckets/{bucket}", "labels": {"probe": "acl"}}, "updateMask": {"paths": ["labels"]}, "predefinedAcl": "private"}, "local_choice": {"reason": "Not implemented yet; gcs-mimic rejects the option (SPEC-SDK-UNSUPPORTED).", "mimic_status": 12}},
    {"name": "update-object-wildcard-mask", "protocol": "grpc", "rpc": "google.storage.v2.Storage/UpdateObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"object": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-a", "contentType": "text/x-probe"}, "updateMask": {"paths": ["*"]}}, "local_choice": {"reason": "Not implemented yet; gcs-mimic rejects the option (SPEC-SDK-UNSUPPORTED).", "mimic_status": 12}},
    {"name": "update-object-predefined-acl", "protocol": "grpc", "rpc": "google.storage.v2.Storage/UpdateObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"object": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-a", "contentLanguage": "en"}, "updateMask": {"paths": ["content_language"]}, "predefinedAcl": "private"}, "local_choice": {"reason": "Not implemented yet; gcs-mimic rejects the option (SPEC-SDK-UNSUPPORTED).", "mimic_status": 12}},
    {"name": "compose-plain", "protocol": "grpc", "rpc": "google.storage.v2.Storage/ComposeObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"destination": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-cmp"}, "sourceObjects": [{"name": "{object}-a"}, {"name": "{object}-b"}]}},
    {"name": "compose-predefined-acl", "protocol": "grpc", "rpc": "google.storage.v2.Storage/ComposeObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"destination": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-cmp-acl"}, "sourceObjects": [{"name": "{object}-a"}, {"name": "{object}-b"}], "destinationPredefinedAcl": "private"}, "local_choice": {"reason": "Not implemented yet; gcs-mimic rejects the option (SPEC-SDK-UNSUPPORTED).", "mimic_status": 12}},
    {"name": "compose-wrong-checksum", "protocol": "grpc", "rpc": "google.storage.v2.Storage/ComposeObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"destination": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-cmp-crc"}, "sourceObjects": [{"name": "{object}-a"}, {"name": "{object}-b"}], "objectChecksums": {"crc32c": 1}}, "local_choice": {"reason": "Request checksums on ComposeObject are not verified; gcs-mimic rejects the option (SPEC-SDK-UNSUPPORTED).", "mimic_status": 12}},
    {"name": "compose-custom-time", "protocol": "grpc", "rpc": "google.storage.v2.Storage/ComposeObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"destination": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-cmp-time", "customTime": "2020-01-01T00:00:00Z"}, "sourceObjects": [{"name": "{object}-a"}, {"name": "{object}-b"}]}, "local_choice": {"reason": "Not implemented yet; gcs-mimic rejects the option (SPEC-SDK-UNSUPPORTED).", "mimic_status": 12}},
    {"name": "rewrite-plain", "protocol": "grpc", "rpc": "google.storage.v2.Storage/RewriteObject", "headers": {"x-goog-request-params": "source_bucket=projects%2F_%2Fbuckets%2F{bucket}&bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"destinationName": "{object}-rw", "destinationBucket": "projects/_/buckets/{bucket}", "sourceBucket": "projects/_/buckets/{bucket}", "sourceObject": "{object}-a"}, "compare": {"ignore_body_paths": ["$.resource.contentType", "$.resource.contentLanguage"]}},
    {"name": "rewrite-predefined-acl", "protocol": "grpc", "rpc": "google.storage.v2.Storage/RewriteObject", "headers": {"x-goog-request-params": "source_bucket=projects%2F_%2Fbuckets%2F{bucket}&bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"destinationName": "{object}-rw-acl", "destinationBucket": "projects/_/buckets/{bucket}", "sourceBucket": "projects/_/buckets/{bucket}", "sourceObject": "{object}-a", "destinationPredefinedAcl": "private"}, "local_choice": {"reason": "Not implemented yet; gcs-mimic rejects the option (SPEC-SDK-UNSUPPORTED).", "mimic_status": 12}},
    {"name": "rewrite-wrong-checksum", "protocol": "grpc", "rpc": "google.storage.v2.Storage/RewriteObject", "headers": {"x-goog-request-params": "source_bucket=projects%2F_%2Fbuckets%2F{bucket}&bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"destinationName": "{object}-rw-crc", "destinationBucket": "projects/_/buckets/{bucket}", "sourceBucket": "projects/_/buckets/{bucket}", "sourceObject": "{object}-a", "objectChecksums": {"crc32c": 1}}, "local_choice": {"reason": "Request checksums on RewriteObject are not verified; gcs-mimic rejects the option (SPEC-SDK-UNSUPPORTED).", "mimic_status": 12}},
    {"name": "rewrite-custom-time", "protocol": "grpc", "rpc": "google.storage.v2.Storage/RewriteObject", "headers": {"x-goog-request-params": "source_bucket=projects%2F_%2Fbuckets%2F{bucket}&bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"destinationName": "{object}-rw-time", "destinationBucket": "projects/_/buckets/{bucket}", "destination": {"customTime": "2020-01-01T00:00:00Z"}, "sourceBucket": "projects/_/buckets/{bucket}", "sourceObject": "{object}-a"}, "local_choice": {"reason": "Not implemented yet; gcs-mimic rejects the option (SPEC-SDK-UNSUPPORTED).", "mimic_status": 12}},
    {"name": "move-flat-namespace", "protocol": "grpc", "rpc": "google.storage.v2.Storage/MoveObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": "projects/_/buckets/{bucket}", "sourceObject": "{object}-rw", "destinationObject": "{object}-moved"}, "compare": {"ignore_body_paths": ["$.contentType", "$.contentLanguage"]}},
    {"name": "compose-delete-sources", "protocol": "grpc", "rpc": "google.storage.v2.Storage/ComposeObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"destination": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-cmp-del"}, "sourceObjects": [{"name": "{object}-a"}, {"name": "{object}-b"}], "deleteSourceObjects": true}},
    {"name": "get-deleted-source", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": "projects/_/buckets/{bucket}", "object": "{object}-a", "readMask": {"paths": ["name"]}}},
    {"name": "get-iam-policy-version-2", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetIamPolicy", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"resource": "projects/_/buckets/{bucket}", "options": {"requestedPolicyVersion": 2}}, "compare": {"ignore_body_paths": ["$.bindings"]}},
    {"name": "get-iam-policy-managed-folder", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetIamPolicy", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"resource": "projects/_/buckets/{bucket}/managedFolders/probe"}, "local_choice": {"reason": "Managed folder IAM is not implemented; gcs-mimic answers UNIMPLEMENTED where Cloud Storage reports the missing uniform access (SPEC-SDK-UNSUPPORTED).", "mimic_status": 12}},
    {"name": "test-iam-permissions-object", "protocol": "grpc", "rpc": "google.storage.v2.Storage/TestIamPermissions", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"resource": "projects/_/buckets/{bucket}/objects/{object}-cmp", "permissions": ["storage.objects.get"]}, "local_choice": {"reason": "Not implemented yet; gcs-mimic rejects the option (SPEC-SDK-UNSUPPORTED).", "mimic_status": 12}}
  ]
}
