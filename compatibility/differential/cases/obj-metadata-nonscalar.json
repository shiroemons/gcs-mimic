{
  "id": "obj-metadata-nonscalar",
  "description": "Custom metadata values beyond strings: number spellings, mixed scalar and nested values, and how PATCH, PUT, multipart insert and copy treat them.",
  "steps": [
    {"name": "upload", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "media", "name": "{object}"}, "headers": {"Content-Type": "text/plain"}, "body_text": "x", "compare": false, "expect_status": 200},
    {"name": "seed-1", "method": "PATCH", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"fields": "metadata"}, "body": {"metadata": {"keep": "1"}}, "compare": false},
    {"name": "patch-mixed-scalar-and-object", "method": "PATCH", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"fields": "metadata"}, "body": {"metadata": {"new": "2", "o": {"x": "1"}}}},
    {"name": "get-after-mixed", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"fields": "metadata"}},
    {"name": "seed-2", "method": "PATCH", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"fields": "metadata"}, "body": {"metadata": {"keep": "1"}}, "compare": false},
    {"name": "patch-object-only", "method": "PATCH", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"fields": "metadata"}, "body": {"metadata": {"o": {"x": "1"}}}},
    {"name": "get-after-object", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"fields": "metadata"}},
    {"name": "seed-3", "method": "PATCH", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"fields": "metadata"}, "body": {"metadata": {"keep": "1"}}, "compare": false},
    {"name": "patch-empty-object-value", "method": "PATCH", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"fields": "metadata"}, "body": {"metadata": {"o": {}}}},
    {"name": "seed-4", "method": "PATCH", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"fields": "metadata"}, "body": {"metadata": {"keep": "1"}}, "compare": false},
    {"name": "patch-array-mixed", "method": "PATCH", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"fields": "metadata"}, "body": {"metadata": {"new": "2", "a": ["1", "2"]}}},
    {"name": "get-after-array", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"fields": "metadata"}},
    {"name": "seed-5", "method": "PATCH", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"fields": "metadata"}, "body": {"metadata": {"keep": "1"}}, "compare": false},
    {"name": "patch-number-spellings", "method": "PATCH", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"fields": "metadata"}, "headers": {"Content-Type": "application/json"}, "body_text": "{{\"metadata\":{{\"trail\":1.50,\"exp\":1e3,\"big\":12345678901234567890,\"neg\":-1,\"zero\":0.0,\"f\":false}}}}"},
    {"name": "get-after-spellings", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"fields": "metadata"}},
    {"name": "patch-null-scalar-mix", "method": "PATCH", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"fields": "metadata"}, "body": {"metadata": {"keep": null, "n": 2}}},
    {"name": "put-mixed-object", "method": "PUT", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"fields": "metadata"}, "body": {"contentType": "text/plain", "metadata": {"k": "v", "o": {"x": "1"}}}},
    {"name": "put-number", "method": "PUT", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"fields": "metadata"}, "body": {"contentType": "text/plain", "metadata": {"n": 3, "b": true}}},
    {"name": "multipart-mixed-object", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "multipart", "fields": "metadata"}, "headers": {"Content-Type": "multipart/related; boundary=scalars"}, "body_text": "--scalars\r\nContent-Type: application/json\r\n\r\n{{\"name\":\"{object2}\",\"metadata\":{{\"k\":\"v\",\"o\":{{\"x\":\"1\"}}}}}}\r\n--scalars\r\nContent-Type: text/plain\r\n\r\nx\r\n--scalars--\r\n"},
    {"name": "copy-number", "method": "POST", "path": "/storage/v1/b/{bucket}/o/{object}/copyTo/b/{bucket}/o/{object2}", "query": {"fields": "metadata"}, "body": {"metadata": {"n": 4}}},
    {"name": "copy-mixed-object", "method": "POST", "path": "/storage/v1/b/{bucket}/o/{object}/copyTo/b/{bucket}/o/{object2}", "query": {"fields": "metadata"}, "body": {"metadata": {"k": "v", "o": {"x": "1"}}}},
    {"name": "cleanup", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}", "compare": false, "always": true},
    {"name": "cleanup2", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object2}", "compare": false, "always": true}
  ]
}
