{
  "id": "grpc-bucket-list",
  "description": "gRPC ListBuckets by parent project: prefix filter, page size, read mask, an empty result and a malformed parent.",
  "steps": [
    {"name": "list-prefix", "protocol": "grpc", "rpc": "google.storage.v2.Storage/ListBuckets", "headers": {"x-goog-request-params": "project=projects%2F{project}"}, "body": {"parent": "projects/{project}", "prefix": "{bucket}", "readMask": {"paths": ["name", "location", "storage_class"]}}, "expect_status": 0},
    {"name": "list-read-mask", "protocol": "grpc", "rpc": "google.storage.v2.Storage/ListBuckets", "headers": {"x-goog-request-params": "project=projects%2F{project}"}, "body": {"parent": "projects/{project}", "prefix": "{bucket}", "pageSize": 1, "readMask": {"paths": ["name", "location"]}}, "expect_status": 0},
    {"name": "list-malformed-parent", "protocol": "grpc", "rpc": "google.storage.v2.Storage/ListBuckets", "headers": {"x-goog-request-params": "project=buckets%2Fx"}, "body": {"parent": "buckets/x"}, "expect_status": 3}
  ]
}
