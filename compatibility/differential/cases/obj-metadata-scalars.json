{
  "id": "obj-metadata-scalars",
  "description": "Custom metadata values that are not strings, on PATCH and on multipart insert.",
  "steps": [
    {"name": "upload", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "media", "name": "{object}"}, "headers": {"Content-Type": "text/plain"}, "body_text": "x", "compare": false, "expect_status": 200},
    {"name": "patch-number-and-bool", "method": "PATCH", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"fields": "metadata"}, "body": {"metadata": {"n": 1, "f": 1.5, "b": true}}},
    {"name": "get-after-patch", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"fields": "metadata"}},
    {"name": "patch-nested-object", "method": "PATCH", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"fields": "metadata"}, "body": {"metadata": {"o": {"x": "1"}}}},
    {"name": "patch-array", "method": "PATCH", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"fields": "metadata"}, "body": {"metadata": {"a": ["1"]}}},
    {"name": "multipart-number", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "multipart", "fields": "metadata"}, "headers": {"Content-Type": "multipart/related; boundary=scalars"}, "body_text": "--scalars\r\nContent-Type: application/json\r\n\r\n{{\"name\":\"{object2}\",\"metadata\":{{\"n\":7,\"b\":false}}}}\r\n--scalars\r\nContent-Type: text/plain\r\n\r\nx\r\n--scalars--\r\n"},
    {"name": "cleanup", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}", "compare": false, "always": true},
    {"name": "cleanup2", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object2}", "compare": false, "always": true}
  ]
}
