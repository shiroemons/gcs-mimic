{
  "id": "bkt-acl-crud",
  "description": "Bucket, default object and object access control lists on a fresh bucket with uniform access disabled: list, get, patch, update, delete and insert of the project-viewers entity (never a public entity), plus invalid role and invalid entity errors. The three *-get-missing steps request project-owners-1, a project-team entity that names another project, so they record the 400 `Project \"1\" was not found.` answer rather than a missing entry in the same project; object-acl-get-missing-object records the missing object.",
  "bucket": false,
  "steps": [
    {"name": "create", "method": "POST", "path": "/storage/v1/b", "query": {"project": "{project}"}, "body": {"name": "{new_bucket}", "location": "us-central1", "softDeletePolicy": {"retentionDurationSeconds": "0"}, "iamConfiguration": {"uniformBucketLevelAccess": {"enabled": false}, "publicAccessPrevention": "enforced"}}, "capture": {"pn": "body:projectNumber"}, "expect_status": 200},
    {"name": "bucket-acl-list", "method": "GET", "path": "/storage/v1/b/{new_bucket}/acl", "expect_status": 200},
    {"name": "bucket-acl-get", "method": "GET", "path": "/storage/v1/b/{new_bucket}/acl/project-viewers-{pn}", "expect_status": 200},
    {"name": "bucket-acl-get-missing", "method": "GET", "path": "/storage/v1/b/{new_bucket}/acl/project-owners-1", "expect_status": 400},
    {"name": "bucket-acl-patch", "method": "PATCH", "path": "/storage/v1/b/{new_bucket}/acl/project-viewers-{pn}", "body": {"role": "WRITER"}, "expect_status": 200},
    {"name": "bucket-acl-update", "method": "PUT", "path": "/storage/v1/b/{new_bucket}/acl/project-viewers-{pn}", "body": {"entity": "project-viewers-{pn}", "role": "READER"}, "expect_status": 200},
    {"name": "bucket-acl-delete", "method": "DELETE", "path": "/storage/v1/b/{new_bucket}/acl/project-viewers-{pn}", "expect_status": 204},
    {"name": "bucket-acl-get-after-delete", "method": "GET", "path": "/storage/v1/b/{new_bucket}/acl/project-viewers-{pn}", "expect_status": 404},
    {"name": "bucket-acl-delete-again", "method": "DELETE", "path": "/storage/v1/b/{new_bucket}/acl/project-viewers-{pn}", "expect_status": 404},
    {"name": "bucket-acl-insert", "method": "POST", "path": "/storage/v1/b/{new_bucket}/acl", "body": {"entity": "project-viewers-{pn}", "role": "READER"}, "expect_status": 200},
    {"name": "bucket-acl-insert-invalid-role", "method": "POST", "path": "/storage/v1/b/{new_bucket}/acl", "body": {"entity": "project-viewers-{pn}", "role": "SUPERUSER"}, "expect_status": 400},
    {"name": "bucket-acl-insert-invalid-entity", "method": "POST", "path": "/storage/v1/b/{new_bucket}/acl", "body": {"entity": "bogus", "role": "READER"}, "expect_status": 400},
    {"name": "bucket-acl-insert-missing-role", "method": "POST", "path": "/storage/v1/b/{new_bucket}/acl", "body": {"entity": "project-viewers-{pn}"}, "expect_status": 400},
    {"name": "bucket-acl-list-after", "method": "GET", "path": "/storage/v1/b/{new_bucket}/acl", "expect_status": 200},
    {"name": "default-acl-list", "method": "GET", "path": "/storage/v1/b/{new_bucket}/defaultObjectAcl", "expect_status": 200},
    {"name": "default-acl-get", "method": "GET", "path": "/storage/v1/b/{new_bucket}/defaultObjectAcl/project-viewers-{pn}", "expect_status": 200},
    {"name": "default-acl-get-missing", "method": "GET", "path": "/storage/v1/b/{new_bucket}/defaultObjectAcl/project-owners-1", "expect_status": 400},
    {"name": "default-acl-patch", "method": "PATCH", "path": "/storage/v1/b/{new_bucket}/defaultObjectAcl/project-viewers-{pn}", "body": {"role": "OWNER"}, "expect_status": 200},
    {"name": "default-acl-update", "method": "PUT", "path": "/storage/v1/b/{new_bucket}/defaultObjectAcl/project-viewers-{pn}", "body": {"entity": "project-viewers-{pn}", "role": "READER"}, "expect_status": 200},
    {"name": "default-acl-delete", "method": "DELETE", "path": "/storage/v1/b/{new_bucket}/defaultObjectAcl/project-viewers-{pn}", "expect_status": 204},
    {"name": "default-acl-delete-again", "method": "DELETE", "path": "/storage/v1/b/{new_bucket}/defaultObjectAcl/project-viewers-{pn}", "expect_status": 404},
    {"name": "default-acl-insert", "method": "POST", "path": "/storage/v1/b/{new_bucket}/defaultObjectAcl", "body": {"entity": "project-viewers-{pn}", "role": "READER"}, "expect_status": 200},
    {"name": "default-acl-insert-invalid-role", "method": "POST", "path": "/storage/v1/b/{new_bucket}/defaultObjectAcl", "body": {"entity": "project-viewers-{pn}", "role": "WRITER"}, "expect_status": 400},
    {"name": "upload-object", "method": "POST", "path": "/upload/storage/v1/b/{new_bucket}/o", "query": {"uploadType": "media", "name": "{object}"}, "headers": {"Content-Type": "text/plain"}, "body_text": "acl", "capture": {"gen": "body:generation"}, "expect_status": 200},
    {"name": "object-acl-list", "method": "GET", "path": "/storage/v1/b/{new_bucket}/o/{object}/acl", "expect_status": 200},
    {"name": "object-acl-get", "method": "GET", "path": "/storage/v1/b/{new_bucket}/o/{object}/acl/project-viewers-{pn}", "expect_status": 200},
    {"name": "object-acl-get-missing", "method": "GET", "path": "/storage/v1/b/{new_bucket}/o/{object}/acl/project-owners-1", "expect_status": 400},
    {"name": "object-acl-get-missing-object", "method": "GET", "path": "/storage/v1/b/{new_bucket}/o/{object2}/acl", "expect_status": 404},
    {"name": "object-acl-patch", "method": "PATCH", "path": "/storage/v1/b/{new_bucket}/o/{object}/acl/project-viewers-{pn}", "body": {"role": "OWNER"}, "expect_status": 200},
    {"name": "object-acl-update", "method": "PUT", "path": "/storage/v1/b/{new_bucket}/o/{object}/acl/project-viewers-{pn}", "body": {"entity": "project-viewers-{pn}", "role": "READER"}, "expect_status": 200},
    {"name": "object-acl-delete", "method": "DELETE", "path": "/storage/v1/b/{new_bucket}/o/{object}/acl/project-viewers-{pn}", "expect_status": 204},
    {"name": "object-acl-delete-again", "method": "DELETE", "path": "/storage/v1/b/{new_bucket}/o/{object}/acl/project-viewers-{pn}", "expect_status": 404},
    {"name": "object-acl-insert", "method": "POST", "path": "/storage/v1/b/{new_bucket}/o/{object}/acl", "query": {"generation": "{gen}"}, "body": {"entity": "project-viewers-{pn}", "role": "READER"}, "expect_status": 200},
    {"name": "object-acl-insert-invalid-role", "method": "POST", "path": "/storage/v1/b/{new_bucket}/o/{object}/acl", "body": {"entity": "project-viewers-{pn}", "role": "WRITER"}, "expect_status": 400},
    {"name": "object-acl-list-after", "method": "GET", "path": "/storage/v1/b/{new_bucket}/o/{object}/acl", "expect_status": 200},
    {"name": "delete-object", "method": "DELETE", "path": "/storage/v1/b/{new_bucket}/o/{object}", "expect_status": 204},
    {"name": "delete-bucket", "method": "DELETE", "path": "/storage/v1/b/{new_bucket}", "expect_status": 204}
  ]
}
