{
  "id": "obj-gaps-uploads",
  "description": "Upload questions the gap ledger left open: Content-MD5 on a resumable final chunk (wrong and right), DELETE and a status query on a completed session, an unknown query and ifGenerationMatch on a chunk PUT, resumable initiation whose metadata contentType disagrees with X-Upload-Content-Type, and multipart media parts with 7bit, 8bit and quoted-printable transfer encodings. Checks SPEC-RSM-EDGES, SPEC-RSM-AUTH-CONDITIONS, SPEC-016.",
  "steps": [
    {"name": "start-md5-wrong", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "name": "{object}-md5w"}, "headers": {"Content-Type": "application/json", "X-Upload-Content-Type": "text/plain"}, "body": {}, "capture": {"u1": "header:location?upload_id"}, "compare": {"ignore_headers": ["location", "x-guploader-uploadid"]}, "expect_status": 200},
    {"name": "final-chunk-md5-wrong", "method": "PUT", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "upload_id": "{u1}", "fields": "name,size,md5Hash"}, "headers": {"Content-Range": "bytes 0-4/5", "Content-MD5": "AAAAAAAAAAAAAAAAAAAAAA=="}, "body_text": "hello"},
    {"name": "start-md5-right", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "name": "{object}-md5r"}, "headers": {"Content-Type": "application/json", "X-Upload-Content-Type": "text/plain"}, "body": {}, "capture": {"u2": "header:location?upload_id"}, "compare": {"ignore_headers": ["location", "x-guploader-uploadid"]}, "expect_status": 200},
    {"name": "final-chunk-md5-right", "method": "PUT", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "upload_id": "{u2}", "fields": "name,size,md5Hash"}, "headers": {"Content-Range": "bytes 0-4/5", "Content-MD5": "XUFAKrxLKna5cZ2REBfFkg=="}, "body_text": "hello"},

    {"name": "start-delete-completed", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "name": "{object}-del"}, "headers": {"Content-Type": "application/json", "X-Upload-Content-Type": "text/plain"}, "body": {}, "capture": {"u3": "header:location?upload_id"}, "compare": {"ignore_headers": ["location", "x-guploader-uploadid"]}, "expect_status": 200},
    {"name": "complete-before-delete", "method": "PUT", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "upload_id": "{u3}", "fields": "name,size"}, "headers": {"Content-Range": "bytes 0-4/5"}, "body_text": "hello", "expect_status": 200},
    {"name": "delete-completed-session", "local_choice": {"reason": "Recorded 2026-11-17: Cloud Storage answers DELETE on a completed resumable session with 200 and the object resource; gcs-mimic answers 410 (SPEC-RSM-EDGES).", "mimic_status": 410}, "method": "DELETE", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "upload_id": "{u3}"}},
    {"name": "status-after-delete-completed", "method": "PUT", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "upload_id": "{u3}", "fields": "name,size"}, "headers": {"Content-Range": "bytes */5"}, "body_text": ""},
    {"name": "get-after-delete-completed", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}-del", "query": {"fields": "name,size"}},

    {"name": "start-unknown-query", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "name": "{object}-q1"}, "headers": {"Content-Type": "application/json", "X-Upload-Content-Type": "text/plain"}, "body": {}, "capture": {"u4": "header:location?upload_id"}, "compare": {"ignore_headers": ["location", "x-guploader-uploadid"]}, "expect_status": 200},
    {"name": "chunk-with-unknown-query", "method": "PUT", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "upload_id": "{u4}", "gcsmimicprobe": "1", "fields": "name,size"}, "headers": {"Content-Range": "bytes 0-4/5"}, "body_text": "hello"},
    {"name": "start-chunk-precondition", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "name": "{object}-q2"}, "headers": {"Content-Type": "application/json", "X-Upload-Content-Type": "text/plain"}, "body": {}, "capture": {"u5": "header:location?upload_id"}, "compare": {"ignore_headers": ["location", "x-guploader-uploadid"]}, "expect_status": 200},
    {"name": "chunk-with-failing-if-generation-match", "method": "PUT", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "upload_id": "{u5}", "ifGenerationMatch": "1", "fields": "name,size"}, "headers": {"Content-Range": "bytes 0-4/5"}, "body_text": "hello"},
    {"name": "status-after-chunk-precondition", "method": "PUT", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "upload_id": "{u5}", "fields": "name,size"}, "headers": {"Content-Range": "bytes */5"}, "body_text": ""},

    {"name": "start-content-type-conflict", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "name": "{object}-ct"}, "headers": {"Content-Type": "application/json", "X-Upload-Content-Type": "text/plain"}, "body": {"contentType": "text/csv"}, "compare": {"ignore_headers": ["location", "x-guploader-uploadid"]}},

    {"name": "multipart-7bit", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "multipart", "fields": "name,size,md5Hash"}, "headers": {"Content-Type": "multipart/related; boundary=gcsmimicdiff"}, "body_text": "--gcsmimicdiff\r\nContent-Type: application/json; charset=UTF-8\r\n\r\n{{\"name\":\"{object}-7bit\"}}\r\n--gcsmimicdiff\r\nContent-Type: text/plain\r\nContent-Transfer-Encoding: 7bit\r\n\r\nhello\r\n--gcsmimicdiff--"},
    {"name": "multipart-8bit", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "multipart", "fields": "name,size,md5Hash"}, "headers": {"Content-Type": "multipart/related; boundary=gcsmimicdiff"}, "body_text": "--gcsmimicdiff\r\nContent-Type: application/json; charset=UTF-8\r\n\r\n{{\"name\":\"{object}-8bit\"}}\r\n--gcsmimicdiff\r\nContent-Type: text/plain\r\nContent-Transfer-Encoding: 8bit\r\n\r\nhello\r\n--gcsmimicdiff--"},
    {"name": "multipart-quoted-printable", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "multipart", "fields": "name,size,md5Hash"}, "headers": {"Content-Type": "multipart/related; boundary=gcsmimicdiff"}, "body_text": "--gcsmimicdiff\r\nContent-Type: application/json; charset=UTF-8\r\n\r\n{{\"name\":\"{object}-qp\"}}\r\n--gcsmimicdiff\r\nContent-Type: text/plain\r\nContent-Transfer-Encoding: quoted-printable\r\n\r\nhello=3D\r\n--gcsmimicdiff--"},

    {"name": "cleanup-md5w", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-md5w", "compare": false, "always": true},
    {"name": "cleanup-md5r", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-md5r", "compare": false, "always": true},
    {"name": "cleanup-del", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-del", "compare": false, "always": true},
    {"name": "cleanup-q1", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-q1", "compare": false, "always": true},
    {"name": "cleanup-q2", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-q2", "compare": false, "always": true},
    {"name": "cleanup-ct", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-ct", "compare": false, "always": true},
    {"name": "cleanup-7bit", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-7bit", "compare": false, "always": true},
    {"name": "cleanup-8bit", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-8bit", "compare": false, "always": true},
    {"name": "cleanup-qp", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-qp", "compare": false, "always": true}
  ]
}
