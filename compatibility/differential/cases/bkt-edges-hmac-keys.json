{
  "id": "bkt-edges-hmac-keys",
  "description": "HMAC key requests that need no key: the list shape for a project without keys, maxResults bounds, requester billing on list, get and delete, and the order of the not-found and state checks on update. No key is created, because creating one returns a secret the harness must not hold. Checks SPEC-HMAC-WIRE.",
  "bucket": false,
  "steps": [
    {"name": "list", "method": "GET", "path": "/storage/v1/projects/{project}/hmacKeys"},
    {"name": "list-max-results-zero", "method": "GET", "path": "/storage/v1/projects/{project}/hmacKeys", "query": {"maxResults": "0"}},
    {"name": "list-max-results-negative", "method": "GET", "path": "/storage/v1/projects/{project}/hmacKeys", "query": {"maxResults": "-1"}},
    {"name": "list-user-project", "method": "GET", "path": "/storage/v1/projects/{project}/hmacKeys", "query": {"userProject": "{project}"}, "expect_status": 200},
    {"name": "get-missing-user-project", "method": "GET", "path": "/storage/v1/projects/{project}/hmacKeys/GOOGNOSUCHKEYID000000", "query": {"userProject": "{project}"}, "expect_status": 404},
    {"name": "delete-missing-user-project", "method": "DELETE", "path": "/storage/v1/projects/{project}/hmacKeys/GOOGNOSUCHKEYID000000", "query": {"userProject": "{project}"}, "expect_status": 404},
    {"name": "update-missing-without-state", "method": "PUT", "path": "/storage/v1/projects/{project}/hmacKeys/GOOGNOSUCHKEYID000000", "body": {}},
    {"name": "update-missing-to-deleted", "method": "PUT", "path": "/storage/v1/projects/{project}/hmacKeys/GOOGNOSUCHKEYID000000", "body": {"state": "DELETED"}}
  ]
}
