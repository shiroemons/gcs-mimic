{
  "id": "obj-get-fields",
  "description": "Object metadata reads with projection values and many fields selections: nested, wildcard, repeated, invalid and unknown selectors. Checks SPEC-FIELDS-EDGES.",
  "steps": [
    {"name": "upload", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "media", "name": "{object}"}, "headers": {"Content-Type": "text/plain"}, "body_text": "hello", "compare": false, "expect_status": 200},
    {"name": "patch-metadata", "method": "PATCH", "path": "/storage/v1/b/{bucket}/o/{object}", "body": {"metadata": {"a": "1", "b": "2"}}, "compare": false, "expect_status": 200},
    {"name": "projection-default", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}", "expect_status": 200},
    {"name": "projection-full", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"projection": "full"}, "expect_status": 200},
    {"name": "projection-no-acl", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"projection": "noAcl"}, "expect_status": 200},
    {"name": "projection-invalid", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"projection": "bogus"}, "expect_status": 400},
    {"name": "fields-scalars", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"fields": "name,size,contentType,kind"}, "expect_status": 200},
    {"name": "fields-nested-key", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"fields": "name,metadata/a"}, "expect_status": 200},
    {"name": "fields-parenthesized-key", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"fields": "metadata(a,b)"}, "expect_status": 200},
    {"name": "fields-whole-map", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"fields": "metadata"}, "expect_status": 200},
    {"name": "fields-wildcard", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"fields": "*"}, "expect_status": 200},
    {"name": "fields-nested-wildcard", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"fields": "metadata/*"}, "expect_status": 200},
    {"name": "fields-acl-with-full", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"fields": "name,acl(entity,role)", "projection": "full"}, "expect_status": 200},
    {"name": "fields-acl-without-projection", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"fields": "name,acl"}, "expect_status": 200},
    {"name": "fields-owner", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"fields": "name,owner", "projection": "full"}, "expect_status": 200},
    {"name": "fields-missing-key", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"fields": "name,metadata/zzz"}, "expect_status": 200},
    {"name": "fields-repeated", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"fields": "name,name,size"}, "expect_status": 200},
    {"name": "fields-unknown", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"fields": "nosuchfield"}, "expect_status": 400},
    {"name": "fields-empty-segment", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"fields": "name,,size"}, "expect_status": 400},
    {"name": "fields-subselector-on-scalar", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"fields": "size/x"}, "expect_status": 400},
    {"name": "fields-unbalanced-parenthesis", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"fields": "metadata(a"}, "expect_status": 400},
    {"name": "fields-empty-value", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"fields": ""}, "expect_status": 200},
    {"name": "patch-fields", "method": "PATCH", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"fields": "name,metadata"}, "body": {"metadata": {"c": "3"}}, "expect_status": 200},
    {"name": "patch-projection-full", "method": "PATCH", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"projection": "full"}, "body": {"metadata": {"d": "4"}}, "expect_status": 200},
    {"name": "cleanup", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}", "compare": false}
  ]
}
