{
  "id": "obj-unsupported-derived",
  "description": "Derived-write options that gcs-mimic rejects as unsupported: temporaryHold, customTime and destinationPredefinedAcl on copy, rewrite and compose, an object retention on copy in a bucket without object retention, and objects.move in a flat-namespace bucket with and without projection=full. Held objects are released before deletion. Checks SPEC-SDK-UNSUPPORTED and SPEC-001.",
  "steps": [
    {"name": "upload-a", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "media", "name": "{object}-a"}, "headers": {"Content-Type": "text/plain"}, "body_text": "hel", "compare": false, "expect_status": 200},
    {"name": "upload-b", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "media", "name": "{object}-b"}, "headers": {"Content-Type": "text/plain"}, "body_text": "lo", "compare": false, "expect_status": 200},
    {"name": "copy-temporary-hold", "method": "POST", "path": "/storage/v1/b/{bucket}/o/{object}-a/copyTo/b/{bucket}/o/{object}-copy-hold", "query": {"fields": "name,temporaryHold"}, "body": {"temporaryHold": true}, "local_choice": {"reason": "Not implemented yet; gcs-mimic rejects the option (SPEC-SDK-UNSUPPORTED).", "mimic_status": 400}},
    {"name": "copy-custom-time", "method": "POST", "path": "/storage/v1/b/{bucket}/o/{object}-a/copyTo/b/{bucket}/o/{object}-copy-time", "query": {"fields": "name,customTime"}, "body": {"customTime": "2020-01-01T00:00:00Z"}, "local_choice": {"reason": "Not implemented yet; gcs-mimic rejects the option (SPEC-SDK-UNSUPPORTED).", "mimic_status": 400}},
    {"name": "copy-predefined-acl", "method": "POST", "path": "/storage/v1/b/{bucket}/o/{object}-a/copyTo/b/{bucket}/o/{object}-copy-acl", "query": {"destinationPredefinedAcl": "private", "fields": "name"}, "local_choice": {"reason": "Not implemented yet; gcs-mimic rejects the option (SPEC-SDK-UNSUPPORTED).", "mimic_status": 400}},
    {"name": "copy-retention-without-bucket-setting", "method": "POST", "path": "/storage/v1/b/{bucket}/o/{object}-a/copyTo/b/{bucket}/o/{object}-copy-retention", "query": {"fields": "name,retention"}, "body": {"retention": {"mode": "Unlocked", "retainUntilTime": "2030-01-01T00:00:00Z"}}, "local_choice": {"reason": "gcs-mimic rejects retention on a copy as unsupported instead of naming the bucket setting (SPEC-SDK-UNSUPPORTED).", "mimic_status": 400}},
    {"name": "rewrite-temporary-hold", "method": "POST", "path": "/storage/v1/b/{bucket}/o/{object}-a/rewriteTo/b/{bucket}/o/{object}-rw-hold", "query": {"fields": "done,resource(name,temporaryHold)"}, "body": {"temporaryHold": true}, "local_choice": {"reason": "Not implemented yet; gcs-mimic rejects the option (SPEC-SDK-UNSUPPORTED).", "mimic_status": 400}},
    {"name": "rewrite-custom-time", "method": "POST", "path": "/storage/v1/b/{bucket}/o/{object}-a/rewriteTo/b/{bucket}/o/{object}-rw-time", "query": {"fields": "done,resource(name,customTime)"}, "body": {"customTime": "2020-01-01T00:00:00Z"}, "local_choice": {"reason": "Not implemented yet; gcs-mimic rejects the option (SPEC-SDK-UNSUPPORTED).", "mimic_status": 400}},
    {"name": "rewrite-predefined-acl", "method": "POST", "path": "/storage/v1/b/{bucket}/o/{object}-a/rewriteTo/b/{bucket}/o/{object}-rw-acl", "query": {"destinationPredefinedAcl": "private", "fields": "done,resource(name)"}, "local_choice": {"reason": "Not implemented yet; gcs-mimic rejects the option (SPEC-SDK-UNSUPPORTED).", "mimic_status": 400}},
    {"name": "compose-temporary-hold", "method": "POST", "path": "/storage/v1/b/{bucket}/o/{object}-cmp-hold/compose", "query": {"fields": "name,temporaryHold"}, "body": {"sourceObjects": [{"name": "{object}-a"}, {"name": "{object}-b"}], "destination": {"temporaryHold": true}}, "local_choice": {"reason": "Not implemented yet; gcs-mimic rejects the option (SPEC-SDK-UNSUPPORTED).", "mimic_status": 400}},
    {"name": "compose-custom-time", "method": "POST", "path": "/storage/v1/b/{bucket}/o/{object}-cmp-time/compose", "query": {"fields": "name,customTime"}, "body": {"sourceObjects": [{"name": "{object}-a"}, {"name": "{object}-b"}], "destination": {"customTime": "2020-01-01T00:00:00Z"}}, "local_choice": {"reason": "Not implemented yet; gcs-mimic rejects the option (SPEC-SDK-UNSUPPORTED).", "mimic_status": 400}},
    {"name": "compose-predefined-acl", "method": "POST", "path": "/storage/v1/b/{bucket}/o/{object}-cmp-acl/compose", "query": {"destinationPredefinedAcl": "private", "fields": "name"}, "body": {"sourceObjects": [{"name": "{object}-a"}, {"name": "{object}-b"}]}, "local_choice": {"reason": "Not implemented yet; gcs-mimic rejects the option (SPEC-SDK-UNSUPPORTED).", "mimic_status": 400}},
    {"name": "move-flat-namespace", "method": "POST", "path": "/storage/v1/b/{bucket}/o/{object}-b/moveTo/o/{object}-moved", "query": {"fields": "name,size"}},
    {"name": "move-projection-full", "method": "POST", "path": "/storage/v1/b/{bucket}/o/{object}-moved/moveTo/o/{object}-b", "query": {"projection": "full", "fields": "name,size"}, "local_choice": {"reason": "Not implemented yet; gcs-mimic rejects the option (SPEC-SDK-UNSUPPORTED).", "mimic_status": 400}},
    {"name": "release-copy-hold", "method": "PATCH", "path": "/storage/v1/b/{bucket}/o/{object}-copy-hold", "query": {"fields": "name"}, "body": {"temporaryHold": false}, "compare": false, "always": true},
    {"name": "release-rewrite-hold", "method": "PATCH", "path": "/storage/v1/b/{bucket}/o/{object}-rw-hold", "query": {"fields": "name"}, "body": {"temporaryHold": false}, "compare": false, "always": true},
    {"name": "release-compose-hold", "method": "PATCH", "path": "/storage/v1/b/{bucket}/o/{object}-cmp-hold", "query": {"fields": "name"}, "body": {"temporaryHold": false}, "compare": false, "always": true},
    {"name": "cleanup-a", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-a", "compare": false, "always": true},
    {"name": "cleanup-b", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-b", "compare": false, "always": true},
    {"name": "cleanup-moved", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-moved", "compare": false, "always": true},
    {"name": "cleanup-copy-hold", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-copy-hold", "compare": false, "always": true},
    {"name": "cleanup-copy-time", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-copy-time", "compare": false, "always": true},
    {"name": "cleanup-copy-acl", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-copy-acl", "compare": false, "always": true},
    {"name": "cleanup-copy-retention", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-copy-retention", "compare": false, "always": true},
    {"name": "cleanup-rewrite-hold", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-rw-hold", "compare": false, "always": true},
    {"name": "cleanup-rewrite-time", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-rw-time", "compare": false, "always": true},
    {"name": "cleanup-rewrite-acl", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-rw-acl", "compare": false, "always": true},
    {"name": "cleanup-compose-hold", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-cmp-hold", "compare": false, "always": true},
    {"name": "cleanup-compose-time", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-cmp-time", "compare": false, "always": true},
    {"name": "cleanup-compose-acl", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-cmp-acl", "compare": false, "always": true}
  ]
}
