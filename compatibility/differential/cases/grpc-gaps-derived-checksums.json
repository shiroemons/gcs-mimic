{
  "id": "grpc-gaps-derived-checksums",
  "description": "Request checksums on Storage v2 ComposeObject and RewriteObject beyond the wrong CRC32C already recorded: a matching CRC32C on each, an MD5 on a compose (a composite object has none), a matching, a wrong and a short MD5 on a rewrite, and whether a refused compose leaves an object behind. The source holds hello, whose CRC32C is 2591144780 and MD5 XUFAKrxLKna5cZ2REBfFkg==. The two completed rewrites compare without the resource's contentType: Cloud Storage answered them without the source's text/plain, which gcs-mimic copies, and nothing recorded yet explains when a Storage v2 rewrite drops it. Checks SPEC-SDK-UNSUPPORTED.",
  "steps": [
    {
      "name": "write-source",
      "protocol": "grpc",
      "rpc": "google.storage.v2.Storage/WriteObject",
      "headers": {
        "x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"
      },
      "body": [
        {
          "writeObjectSpec": {
            "resource": {
              "bucket": "projects/_/buckets/{bucket}",
              "name": "{object}-src",
              "contentType": "text/plain"
            },
            "objectSize": "5"
          },
          "checksummedData": {
            "content": "aGVsbG8="
          },
          "finishWrite": true
        }
      ],
      "compare": false,
      "expect_status": 0
    },
    {
      "name": "compose-matching-crc32c",
      "protocol": "grpc",
      "rpc": "google.storage.v2.Storage/ComposeObject",
      "headers": {
        "x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"
      },
      "body": {
        "destination": {
          "bucket": "projects/_/buckets/{bucket}",
          "name": "{object}-cmp-crc"
        },
        "sourceObjects": [
          {
            "name": "{object}-src"
          }
        ],
        "objectChecksums": {
          "crc32c": 2591144780
        }
      }
    },
    {
      "name": "compose-matching-md5",
      "protocol": "grpc",
      "rpc": "google.storage.v2.Storage/ComposeObject",
      "headers": {
        "x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"
      },
      "body": {
        "destination": {
          "bucket": "projects/_/buckets/{bucket}",
          "name": "{object}-cmp-md5"
        },
        "sourceObjects": [
          {
            "name": "{object}-src"
          }
        ],
        "objectChecksums": {
          "md5Hash": "XUFAKrxLKna5cZ2REBfFkg=="
        }
      }
    },
    {
      "name": "compose-wrong-md5",
      "protocol": "grpc",
      "rpc": "google.storage.v2.Storage/ComposeObject",
      "headers": {
        "x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"
      },
      "body": {
        "destination": {
          "bucket": "projects/_/buckets/{bucket}",
          "name": "{object}-cmp-bad-md5"
        },
        "sourceObjects": [
          {
            "name": "{object}-src"
          }
        ],
        "objectChecksums": {
          "md5Hash": "AAAAAAAAAAAAAAAAAAAAAA=="
        }
      }
    },
    {
      "name": "compose-wrong-crc32c",
      "protocol": "grpc",
      "rpc": "google.storage.v2.Storage/ComposeObject",
      "headers": {
        "x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"
      },
      "body": {
        "destination": {
          "bucket": "projects/_/buckets/{bucket}",
          "name": "{object}-cmp-bad"
        },
        "sourceObjects": [
          {
            "name": "{object}-src"
          }
        ],
        "objectChecksums": {
          "crc32c": 1
        }
      }
    },
    {
      "name": "get-after-wrong-crc32c",
      "protocol": "grpc",
      "rpc": "google.storage.v2.Storage/GetObject",
      "headers": {
        "x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"
      },
      "body": {
        "bucket": "projects/_/buckets/{bucket}",
        "object": "{object}-cmp-bad"
      }
    },
    {
      "name": "rewrite-matching-crc32c",
      "protocol": "grpc",
      "rpc": "google.storage.v2.Storage/RewriteObject",
      "headers": {
        "x-goog-request-params": "source_bucket=projects%2F_%2Fbuckets%2F{bucket}&bucket=projects%2F_%2Fbuckets%2F{bucket}"
      },
      "body": {
        "destinationName": "{object}-rw-crc",
        "destinationBucket": "projects/_/buckets/{bucket}",
        "sourceBucket": "projects/_/buckets/{bucket}",
        "sourceObject": "{object}-src",
        "objectChecksums": {
          "crc32c": 2591144780
        }
      },
      "compare": {
        "ignore_body_paths": [
          "$.resource.contentType"
        ]
      }
    },
    {
      "name": "rewrite-matching-md5",
      "protocol": "grpc",
      "rpc": "google.storage.v2.Storage/RewriteObject",
      "headers": {
        "x-goog-request-params": "source_bucket=projects%2F_%2Fbuckets%2F{bucket}&bucket=projects%2F_%2Fbuckets%2F{bucket}"
      },
      "body": {
        "destinationName": "{object}-rw-md5",
        "destinationBucket": "projects/_/buckets/{bucket}",
        "sourceBucket": "projects/_/buckets/{bucket}",
        "sourceObject": "{object}-src",
        "objectChecksums": {
          "md5Hash": "XUFAKrxLKna5cZ2REBfFkg=="
        }
      },
      "compare": {
        "ignore_body_paths": [
          "$.resource.contentType"
        ]
      }
    },
    {
      "name": "rewrite-wrong-md5",
      "protocol": "grpc",
      "rpc": "google.storage.v2.Storage/RewriteObject",
      "headers": {
        "x-goog-request-params": "source_bucket=projects%2F_%2Fbuckets%2F{bucket}&bucket=projects%2F_%2Fbuckets%2F{bucket}"
      },
      "body": {
        "destinationName": "{object}-rw-bad-md5",
        "destinationBucket": "projects/_/buckets/{bucket}",
        "sourceBucket": "projects/_/buckets/{bucket}",
        "sourceObject": "{object}-src",
        "objectChecksums": {
          "md5Hash": "AAAAAAAAAAAAAAAAAAAAAA=="
        }
      }
    },
    {
      "name": "rewrite-short-md5",
      "protocol": "grpc",
      "rpc": "google.storage.v2.Storage/RewriteObject",
      "headers": {
        "x-goog-request-params": "source_bucket=projects%2F_%2Fbuckets%2F{bucket}&bucket=projects%2F_%2Fbuckets%2F{bucket}"
      },
      "body": {
        "destinationName": "{object}-rw-short-md5",
        "destinationBucket": "projects/_/buckets/{bucket}",
        "sourceBucket": "projects/_/buckets/{bucket}",
        "sourceObject": "{object}-src",
        "objectChecksums": {
          "md5Hash": "AAAA"
        }
      }
    },
    {
      "name": "cleanup-src",
      "method": "DELETE",
      "path": "/storage/v1/b/{bucket}/o/{object}-src",
      "compare": false,
      "always": true
    },
    {
      "name": "cleanup-cmp-crc",
      "method": "DELETE",
      "path": "/storage/v1/b/{bucket}/o/{object}-cmp-crc",
      "compare": false,
      "always": true
    },
    {
      "name": "cleanup-cmp-md5",
      "method": "DELETE",
      "path": "/storage/v1/b/{bucket}/o/{object}-cmp-md5",
      "compare": false,
      "always": true
    },
    {
      "name": "cleanup-cmp-bad-md5",
      "method": "DELETE",
      "path": "/storage/v1/b/{bucket}/o/{object}-cmp-bad-md5",
      "compare": false,
      "always": true
    },
    {
      "name": "cleanup-rw-crc",
      "method": "DELETE",
      "path": "/storage/v1/b/{bucket}/o/{object}-rw-crc",
      "compare": false,
      "always": true
    },
    {
      "name": "cleanup-rw-md5",
      "method": "DELETE",
      "path": "/storage/v1/b/{bucket}/o/{object}-rw-md5",
      "compare": false,
      "always": true
    },
    {
      "name": "cleanup-rw-bad-md5",
      "method": "DELETE",
      "path": "/storage/v1/b/{bucket}/o/{object}-rw-bad-md5",
      "compare": false,
      "always": true
    },
    {
      "name": "cleanup-rw-short-md5",
      "method": "DELETE",
      "path": "/storage/v1/b/{bucket}/o/{object}-rw-short-md5",
      "compare": false,
      "always": true
    }
  ]
}
