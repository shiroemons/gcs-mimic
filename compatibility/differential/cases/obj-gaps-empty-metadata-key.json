{
  "id": "obj-gaps-empty-metadata-key",
  "description": "Where an empty custom metadata key is stored and how it reads back: a JSON multipart insert and copy, a JSON PATCH that removes the key with null, the XML GET of such an object, an XML PUT with an x-goog-meta- header that names no key, and Storage v2 GetObject, WriteObject and UpdateObject. The UpdateObject steps also show that a metadata mask merges the request's entries into the stored map and clears it for none, and that the metadata. path names the empty key. Checks SPEC-SDK-UNSUPPORTED.",
  "steps": [
    {
      "name": "json-insert-empty-key",
      "method": "POST",
      "path": "/upload/storage/v1/b/{bucket}/o",
      "query": {
        "uploadType": "multipart",
        "fields": "name,metadata"
      },
      "headers": {
        "Content-Type": "multipart/related; boundary=gcsmimicdiff"
      },
      "body_text": "--gcsmimicdiff\r\nContent-Type: application/json; charset=UTF-8\r\n\r\n{{\"name\":\"{object}-j\",\"metadata\":{{\"\":\"v\",\"k\":\"w\"}}}}\r\n--gcsmimicdiff\r\nContent-Type: text/plain\r\n\r\nx\r\n--gcsmimicdiff--",
      "expect_status": 200
    },
    {
      "name": "xml-get-empty-key",
      "protocol": "xml",
      "method": "GET",
      "path": "/{bucket}/{object}-j"
    },
    {
      "name": "grpc-get-empty-key",
      "protocol": "grpc",
      "rpc": "google.storage.v2.Storage/GetObject",
      "headers": {
        "x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"
      },
      "body": {
        "bucket": "projects/_/buckets/{bucket}",
        "object": "{object}-j",
        "readMask": {
          "paths": [
            "name",
            "metadata"
          ]
        }
      }
    },
    {
      "name": "json-copy-empty-key",
      "method": "POST",
      "path": "/storage/v1/b/{bucket}/o/{object}-j/copyTo/b/{bucket}/o/{object}-c",
      "query": {
        "fields": "name,metadata"
      },
      "body": {
        "metadata": {
          "": "c"
        }
      }
    },
    {
      "name": "json-patch-remove-empty-key",
      "method": "PATCH",
      "path": "/storage/v1/b/{bucket}/o/{object}-c",
      "query": {
        "fields": "name,metadata"
      },
      "body": {
        "metadata": {
          "": null
        }
      }
    },
    {
      "name": "grpc-update-empty-key",
      "protocol": "grpc",
      "rpc": "google.storage.v2.Storage/UpdateObject",
      "headers": {
        "x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"
      },
      "body": {
        "object": {
          "bucket": "projects/_/buckets/{bucket}",
          "name": "{object}-j",
          "metadata": {
            "": "g"
          }
        },
        "updateMask": {
          "paths": [
            "metadata"
          ]
        }
      }
    },
    {
      "name": "grpc-update-metadata-mask-other-key",
      "protocol": "grpc",
      "rpc": "google.storage.v2.Storage/UpdateObject",
      "headers": {
        "x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"
      },
      "body": {
        "object": {
          "bucket": "projects/_/buckets/{bucket}",
          "name": "{object}-j",
          "metadata": {
            "n": "1"
          }
        },
        "updateMask": {
          "paths": [
            "metadata"
          ]
        }
      }
    },
    {
      "name": "grpc-update-empty-key-path",
      "protocol": "grpc",
      "rpc": "google.storage.v2.Storage/UpdateObject",
      "headers": {
        "x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"
      },
      "body": {
        "object": {
          "bucket": "projects/_/buckets/{bucket}",
          "name": "{object}-j",
          "metadata": {
            "": "d"
          }
        },
        "updateMask": {
          "paths": [
            "metadata."
          ]
        }
      }
    },
    {
      "name": "grpc-update-metadata-mask-empty-map",
      "protocol": "grpc",
      "rpc": "google.storage.v2.Storage/UpdateObject",
      "headers": {
        "x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"
      },
      "body": {
        "object": {
          "bucket": "projects/_/buckets/{bucket}",
          "name": "{object}-j"
        },
        "updateMask": {
          "paths": [
            "metadata"
          ]
        }
      }
    },
    {
      "name": "grpc-write-empty-key",
      "protocol": "grpc",
      "rpc": "google.storage.v2.Storage/WriteObject",
      "headers": {
        "x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"
      },
      "body": [
        {
          "writeObjectSpec": {
            "resource": {
              "bucket": "projects/_/buckets/{bucket}",
              "name": "{object}-g",
              "contentType": "text/plain",
              "metadata": {
                "": "v"
              }
            },
            "objectSize": "1"
          },
          "checksummedData": {
            "content": "eA=="
          },
          "finishWrite": true
        }
      ]
    },
    {
      "name": "xml-put-empty-key",
      "protocol": "xml",
      "method": "PUT",
      "path": "/{bucket}/{object}-x",
      "headers": {
        "Content-Type": "text/plain",
        "x-goog-meta-": "v"
      },
      "body_text": "x"
    },
    {
      "name": "json-get-xml-put",
      "method": "GET",
      "path": "/storage/v1/b/{bucket}/o/{object}-x",
      "query": {
        "fields": "name,metadata"
      }
    },
    {
      "name": "cleanup-j",
      "method": "DELETE",
      "path": "/storage/v1/b/{bucket}/o/{object}-j",
      "compare": false,
      "always": true
    },
    {
      "name": "cleanup-c",
      "method": "DELETE",
      "path": "/storage/v1/b/{bucket}/o/{object}-c",
      "compare": false,
      "always": true
    },
    {
      "name": "cleanup-g",
      "method": "DELETE",
      "path": "/storage/v1/b/{bucket}/o/{object}-g",
      "compare": false,
      "always": true
    },
    {
      "name": "cleanup-x",
      "method": "DELETE",
      "path": "/storage/v1/b/{bucket}/o/{object}-x",
      "compare": false,
      "always": true
    }
  ]
}
