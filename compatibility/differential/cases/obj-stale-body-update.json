{
  "id": "obj-stale-body-update",
  "description": "Object metadata writes whose body repeats a superseded read, as the .NET client's UpdateObject sends one: a PUT carrying every output field of the first read (etag, metageneration, updated and the rest) and its ETag as If-Match after a PATCH advanced the metageneration, and a PATCH carrying only the stale etag. Checks how Cloud Storage treats output-only fields that no longer match.",
  "steps": [
    {"name": "upload", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "media", "name": "{object}"}, "headers": {"Content-Type": "text/plain"}, "body_text": "hello", "capture": {"etag0": "body:etag", "gen": "body:generation", "id0": "body:id", "self0": "body:selfLink", "media0": "body:mediaLink", "class0": "body:storageClass", "md5": "body:md5Hash", "crc": "body:crc32c", "created": "body:timeCreated", "updated0": "body:updated", "classed": "body:timeStorageClassUpdated", "finalized": "body:timeFinalized"}, "expect_status": 200},
    {"name": "patch-first", "method": "PATCH", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"fields": "metadata,metageneration"}, "body": {"metadata": {"k": "first"}}, "expect_status": 200},
    {"name": "put-stale-read", "method": "PUT", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"fields": "metadata,metageneration"}, "headers": {"If-Match": "\"{etag0}\""}, "body": {"kind": "storage#object", "id": "{id0}", "selfLink": "{self0}", "mediaLink": "{media0}", "name": "{object}", "bucket": "{bucket}", "generation": "{gen}", "metageneration": "1", "contentType": "text/plain", "storageClass": "{class0}", "size": "5", "md5Hash": "{md5}", "crc32c": "{crc}", "etag": "{etag0}", "timeCreated": "{created}", "updated": "{updated0}", "timeStorageClassUpdated": "{classed}", "timeFinalized": "{finalized}", "metadata": {"k": "stale"}}},
    {"name": "patch-stale-etag", "method": "PATCH", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"fields": "metadata,metageneration"}, "body": {"etag": "{etag0}", "metadata": {"k": "patched"}}},
    {"name": "get-after", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"fields": "metadata,metageneration"}, "expect_status": 200}
  ]
}
