{
  "id": "grpc-bucket-unset-settings-mask",
  "description": "GetBucket and ListBuckets read masks naming bucket settings gcs-mimic never stores (billing, custom_placement_config, encryption, hierarchical_namespace, ip_filter, logging, rpo, website) on a bucket without them, alone and inside the mask google-cloud-storage 2.78.0 for Java sends on every bucket read. Cloud Storage answers the eight settings unset. The full mask's response is compared whole, including ACL entityAlt, the millisecond createTime and updateTime, and a disabled softDeletePolicy without effectiveTime.",
  "bucket": "own",
  "steps": [
    {"name": "get-unset-settings", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"name": "projects/_/buckets/{bucket}", "readMask": {"paths": ["billing", "custom_placement_config", "encryption", "hierarchical_namespace", "ip_filter", "logging", "rpo", "website"]}}, "expect_status": 0},
    {"name": "get-java-default-mask", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"name": "projects/_/buckets/{bucket}", "readMask": {"paths": ["acl", "autoclass", "billing", "bucket_id", "cors", "create_time", "custom_placement_config", "default_event_based_hold", "default_object_acl", "encryption", "etag", "hierarchical_namespace", "iam_config", "ip_filter", "labels", "lifecycle", "location", "location_type", "logging", "metageneration", "name", "object_retention", "owner", "project", "retention_policy", "rpo", "soft_delete_policy", "storage_class", "update_time", "versioning", "website"]}}, "expect_status": 0},
    {"name": "list-unset-settings", "protocol": "grpc", "rpc": "google.storage.v2.Storage/ListBuckets", "headers": {"x-goog-request-params": "project=projects%2F{project}"}, "body": {"parent": "projects/{project}", "prefix": "{bucket}", "readMask": {"paths": ["name", "billing", "encryption", "logging", "rpo", "website"]}}, "expect_status": 0}
  ]
}
