{
  "id": "obj-resumable",
  "description": "Resumable completion and replay, an undersized non-final chunk on an isolated session, status and cancellation on a fresh untouched session, and separate sessions for a mismatched total and malformed Content-Range. A status request after bad-content-range explicitly probes the recorded persistent 400 failure. The 5-byte non-final chunk is expected to fail because the documented chunk size is a multiple of 256 KiB; status-after-chunk uses a separate empty session so that rejection cannot poison cancellation. The documented JSON cancel status is 499; 404 after cancel is a provisional choice within the documented 4xx family, pending re-recording. start-precondition-fail answers 200 because the precondition is evaluated at completion. Contract: https://docs.cloud.google.com/storage/docs/performing-resumable-uploads. Checks SPEC-RSM-EDGES.",
  "steps": [
    {"name": "start", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "name": "{object}"}, "headers": {"Content-Type": "application/json", "X-Upload-Content-Type": "text/plain", "X-Upload-Content-Length": "10"}, "body": {"contentType": "text/plain", "metadata": {"k": "v"}}, "capture": {"up1": "header:location?upload_id"}, "expect_status": 200},
    {"name": "status-empty", "method": "PUT", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "upload_id": "{up1}"}, "headers": {"Content-Range": "bytes */10"}, "body_text": "", "expect_status": 308},
    {"name": "complete", "method": "PUT", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "upload_id": "{up1}"}, "headers": {"Content-Range": "bytes 0-9/10"}, "body_text": "0123456789", "expect_status": 200},
    {"name": "status-after-complete", "method": "PUT", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "upload_id": "{up1}"}, "headers": {"Content-Range": "bytes */10"}, "body_text": "", "expect_status": 200},
    {"name": "resend-after-complete", "method": "PUT", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "upload_id": "{up1}"}, "headers": {"Content-Range": "bytes 0-9/10"}, "body_text": "0123456789", "expect_status": 200},
    {"name": "get-result", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}", "expect_status": 200},
    {"name": "download-result", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"alt": "media"}, "expect_status": 200},
    {"name": "start-chunked", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "name": "{object2}"}, "headers": {"Content-Type": "application/json", "X-Upload-Content-Type": "text/plain"}, "body": {}, "capture": {"up2": "header:location?upload_id"}, "expect_status": 200},
    {"name": "chunk-not-final", "method": "PUT", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "upload_id": "{up2}"}, "headers": {"Content-Range": "bytes 0-4/*"}, "body_text": "01234", "expect_status": 400},
    {"name": "start-cancel", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "name": "{object2}"}, "headers": {"Content-Type": "application/json"}, "body": {}, "capture": {"up3": "header:location?upload_id"}, "expect_status": 200},
    {"name": "status-after-chunk", "method": "PUT", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "upload_id": "{up3}"}, "headers": {"Content-Range": "bytes */*"}, "body_text": "", "expect_status": 308},
    {"name": "cancel", "method": "DELETE", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "upload_id": "{up3}"}, "expect_status": 499},
    {"name": "status-after-cancel", "method": "PUT", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "upload_id": "{up3}"}, "headers": {"Content-Range": "bytes */*"}, "body_text": "", "expect_status": 404},
    {"name": "start-total-mismatch", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "name": "{object2}"}, "headers": {"Content-Type": "application/json"}, "body": {}, "capture": {"up4": "header:location?upload_id"}, "expect_status": 200},
    {"name": "total-mismatch", "method": "PUT", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "upload_id": "{up4}"}, "headers": {"Content-Range": "bytes 0-9/5"}, "body_text": "0123456789", "expect_status": 400},
    {"name": "start-bad-content-range", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "name": "{object2}"}, "headers": {"Content-Type": "application/json"}, "body": {}, "capture": {"up5": "header:location?upload_id"}, "expect_status": 200},
    {"name": "bad-content-range", "method": "PUT", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "upload_id": "{up5}"}, "headers": {"Content-Range": "bytes nonsense"}, "body_text": "0123456789", "expect_status": 400},
    {"name": "status-after-bad-content-range", "method": "PUT", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "upload_id": "{up5}"}, "headers": {"Content-Range": "bytes */*"}, "body_text": "", "expect_status": 400},
    {"name": "unknown-session", "method": "PUT", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "upload_id": "unknown-session-id"}, "headers": {"Content-Range": "bytes */*"}, "body_text": "", "expect_status": 404},
    {"name": "start-no-name", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable"}, "headers": {"Content-Type": "application/json"}, "body": {}, "expect_status": 400},
    {"name": "start-precondition-fail", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "name": "{object}", "ifGenerationMatch": "0"}, "headers": {"Content-Type": "application/json"}, "body": {}, "expect_status": 200},
    {"name": "cleanup", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}", "compare": false}
  ]
}
