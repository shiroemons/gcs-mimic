{
  "id": "obj-full-projection-writes",
  "description": "A resumable upload and a rewrite that ask for projection=full, as the Go SDK's Writer and Copier do: the completing chunk, a status query on the completed session, and a rewrite to a new object. Checks that both write responses carry the object's acl and owner like a full read.",
  "steps": [
    {"name": "start", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "name": "{object}", "projection": "full"}, "headers": {"Content-Type": "application/json", "X-Upload-Content-Type": "text/plain", "X-Upload-Content-Length": "5"}, "body": {}, "capture": {"up": "header:location?upload_id"}, "expect_status": 200},
    {"name": "complete", "method": "PUT", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "upload_id": "{up}"}, "headers": {"Content-Range": "bytes 0-4/5"}, "body_text": "hello", "expect_status": 200},
    {"name": "status-after-completion", "method": "PUT", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "upload_id": "{up}"}, "headers": {"Content-Range": "bytes */5"}, "expect_status": 200},
    {"name": "rewrite-full", "method": "POST", "path": "/storage/v1/b/{bucket}/o/{object}/rewriteTo/b/{bucket}/o/{object}-rw", "query": {"projection": "full"}, "expect_status": 200},
    {"name": "get-rewritten-full", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}-rw", "query": {"projection": "full"}, "expect_status": 200}
  ]
}
