{
  "id": "bkt-gaps-autoclass-off",
  "description": "Bucket creation with autoclass enabled false: whether the response and a later read advertise an autoclass object at all. Checks SPEC-RUBY-DEFAULTS.",
  "bucket": false,
  "steps": [
    {"name": "create-autoclass-disabled", "method": "POST", "path": "/storage/v1/b", "query": {"project": "{project}"}, "body": {"name": "{new_bucket}", "location": "us-central1", "autoclass": {"enabled": false}, "softDeletePolicy": {"retentionDurationSeconds": "0"}, "iamConfiguration": {"publicAccessPrevention": "enforced"}}, "expect_status": 200},
    {"name": "get-autoclass-disabled", "method": "GET", "path": "/storage/v1/b/{new_bucket}", "query": {"fields": "autoclass,storageClass"}, "expect_status": 200},
    {"name": "delete", "method": "DELETE", "path": "/storage/v1/b/{new_bucket}", "expect_status": 204, "always": true}
  ]
}
