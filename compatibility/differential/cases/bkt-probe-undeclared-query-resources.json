{
  "id": "bkt-probe-undeclared-query-resources",
  "description": "The undeclared query parameter gcsmimicUnknown=1 on bucket getIamPolicy and testIamPermissions (setIamPolicy is not called), the notification configuration list and the get of an id that does not exist (no configuration or topic is created), the HMAC key list (no key is created) and the managed folder list. The bucket is the case's own, because the managed folder list needs uniform bucket-level access: it is listed once without and once with the parameter after uniform access is switched on, and uniform access is switched off again at the end. Checks SPEC-JSON-UNKNOWN-QUERY-OBJECTS.",
  "bucket": "own",
  "steps": [
    {"name": "iam-get", "method": "GET", "path": "/storage/v1/b/{bucket}/iam", "query": {"gcsmimicUnknown": "1"}},
    {"name": "iam-test-permissions", "method": "GET", "path": "/storage/v1/b/{bucket}/iam/testPermissions", "query": {"permissions": "storage.buckets.get", "gcsmimicUnknown": "1"}},
    {"name": "notification-list", "method": "GET", "path": "/storage/v1/b/{bucket}/notificationConfigs", "query": {"gcsmimicUnknown": "1"}},
    {"name": "notification-get-missing", "method": "GET", "path": "/storage/v1/b/{bucket}/notificationConfigs/999999", "query": {"gcsmimicUnknown": "1"}},
    {"name": "hmac-key-list", "method": "GET", "path": "/storage/v1/projects/{project}/hmacKeys", "query": {"gcsmimicUnknown": "1"}},
    {"name": "enable-uniform-access", "method": "PATCH", "path": "/storage/v1/b/{bucket}", "query": {"fields": "iamConfiguration"}, "body": {"iamConfiguration": {"uniformBucketLevelAccess": {"enabled": true}, "publicAccessPrevention": "enforced"}}, "compare": false, "expect_status": 200},
    {"name": "managed-folder-list", "method": "GET", "path": "/storage/v1/b/{bucket}/managedFolders"},
    {"name": "managed-folder-list-unknown", "method": "GET", "path": "/storage/v1/b/{bucket}/managedFolders", "query": {"gcsmimicUnknown": "1"}},
    {"name": "disable-uniform-access", "method": "PATCH", "path": "/storage/v1/b/{bucket}", "query": {"fields": "iamConfiguration"}, "body": {"iamConfiguration": {"uniformBucketLevelAccess": {"enabled": false}, "publicAccessPrevention": "enforced"}}, "compare": false, "always": true}
  ]
}
