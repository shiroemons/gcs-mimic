{
  "id": "bkt-gaps-legacy-class-multi-region",
  "description": "The legacy REGIONAL class in a multi-region (US) bucket the case creates: bucket creation with REGIONAL, then on a STANDARD bucket a JSON PATCH and Storage v2 UpdateBucket of the default class, a JSON multipart insert, an XML PUT, Storage v2 WriteObject, a JSON and a Storage v2 rewrite and a compose naming REGIONAL, and lifecycle SetStorageClass actions and matchesStorageClass conditions naming REGIONAL or MULTI_REGIONAL. The bucket is deleted at the end. Checks SPEC-SDK-UNSUPPORTED for the REGIONAL class.",
  "steps": [
    {"name": "create-us-regional", "method": "POST", "path": "/storage/v1/b", "query": {"project": "{project}", "fields": "location,locationType,storageClass"}, "body": {"name": "{new_bucket}", "location": "US", "storageClass": "REGIONAL", "softDeletePolicy": {"retentionDurationSeconds": "0"}, "iamConfiguration": {"publicAccessPrevention": "enforced"}}},
    {"name": "create-us-standard", "method": "POST", "path": "/storage/v1/b", "query": {"project": "{project}", "fields": "location,locationType,storageClass"}, "body": {"name": "{new_bucket}", "location": "US", "storageClass": "STANDARD", "softDeletePolicy": {"retentionDurationSeconds": "0"}, "iamConfiguration": {"publicAccessPrevention": "enforced"}}},
    {"name": "patch-class-regional", "method": "PATCH", "path": "/storage/v1/b/{new_bucket}", "query": {"fields": "storageClass"}, "body": {"storageClass": "REGIONAL"}},
    {"name": "upload-class-regional", "method": "POST", "path": "/upload/storage/v1/b/{new_bucket}/o", "query": {"uploadType": "multipart", "fields": "name,storageClass"}, "headers": {"Content-Type": "multipart/related; boundary=gcsmimicdiff"}, "body_text": "--gcsmimicdiff\r\nContent-Type: application/json; charset=UTF-8\r\n\r\n{{\"name\":\"{object}-r\",\"storageClass\":\"REGIONAL\"}}\r\n--gcsmimicdiff\r\nContent-Type: text/plain\r\n\r\nx\r\n--gcsmimicdiff--"},
    {"name": "upload-class-standard", "method": "POST", "path": "/upload/storage/v1/b/{new_bucket}/o", "query": {"uploadType": "multipart", "fields": "name,storageClass"}, "headers": {"Content-Type": "multipart/related; boundary=gcsmimicdiff"}, "body_text": "--gcsmimicdiff\r\nContent-Type: application/json; charset=UTF-8\r\n\r\n{{\"name\":\"{object}-s\"}}\r\n--gcsmimicdiff\r\nContent-Type: text/plain\r\n\r\nx\r\n--gcsmimicdiff--"},
    {"name": "xml-put-class-regional", "protocol": "xml", "method": "PUT", "path": "/{new_bucket}/{object}-x", "headers": {"Content-Type": "text/plain", "x-goog-storage-class": "REGIONAL"}, "body_text": "x"},
    {"name": "rewrite-to-regional", "method": "POST", "path": "/storage/v1/b/{new_bucket}/o/{object}-s/rewriteTo/b/{new_bucket}/o/{object}-rw", "query": {"fields": "done,resource(name,storageClass)"}, "body": {"storageClass": "REGIONAL"}},
    {"name": "compose-class-regional", "method": "POST", "path": "/storage/v1/b/{new_bucket}/o/{object}-c/compose", "query": {"fields": "name,storageClass"}, "body": {"sourceObjects": [{"name": "{object}-s"}], "destination": {"storageClass": "REGIONAL"}}},
    {"name": "lifecycle-set-class-regional", "method": "PATCH", "path": "/storage/v1/b/{new_bucket}", "query": {"fields": "lifecycle"}, "body": {"lifecycle": {"rule": [{"action": {"type": "SetStorageClass", "storageClass": "REGIONAL"}, "condition": {"matchesStorageClass": ["DURABLE_REDUCED_AVAILABILITY"]}}]}}},
    {"name": "lifecycle-match-regional", "method": "PATCH", "path": "/storage/v1/b/{new_bucket}", "query": {"fields": "lifecycle"}, "body": {"lifecycle": {"rule": [{"action": {"type": "Delete"}, "condition": {"matchesStorageClass": ["REGIONAL"], "age": 3650}}]}}},
    {"name": "lifecycle-set-class-multi-regional", "method": "PATCH", "path": "/storage/v1/b/{new_bucket}", "query": {"fields": "lifecycle"}, "body": {"lifecycle": {"rule": [{"action": {"type": "SetStorageClass", "storageClass": "MULTI_REGIONAL"}, "condition": {"matchesStorageClass": ["DURABLE_REDUCED_AVAILABILITY"]}}]}}},
    {"name": "grpc-write-class-regional", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{new_bucket}"}, "body": [{"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{new_bucket}", "name": "{object}-g", "contentType": "text/plain", "storageClass": "REGIONAL"}, "objectSize": "1"}, "checksummedData": {"content": "eA=="}, "finishWrite": true}], "compare": {"ignore_body_paths": ["$.resource.contentType"]}},
    {"name": "grpc-update-bucket-class-regional", "protocol": "grpc", "rpc": "google.storage.v2.Storage/UpdateBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{new_bucket}"}, "body": {"bucket": {"name": "projects/_/buckets/{new_bucket}", "storageClass": "REGIONAL"}, "updateMask": {"paths": ["storage_class"]}}},
    {"name": "grpc-rewrite-class-regional", "protocol": "grpc", "rpc": "google.storage.v2.Storage/RewriteObject", "headers": {"x-goog-request-params": "source_bucket=projects%2F_%2Fbuckets%2F{new_bucket}&bucket=projects%2F_%2Fbuckets%2F{new_bucket}"}, "body": {"destinationName": "{object}-gr", "destinationBucket": "projects/_/buckets/{new_bucket}", "destination": {"storageClass": "REGIONAL"}, "sourceBucket": "projects/_/buckets/{new_bucket}", "sourceObject": "{object}-s"}, "compare": {"ignore_body_paths": ["$.resource.contentType"]}},
    {"name": "patch-class-multi-regional", "method": "PATCH", "path": "/storage/v1/b/{new_bucket}", "query": {"fields": "storageClass"}, "body": {"storageClass": "MULTI_REGIONAL"}},
    {"name": "upload-default-class", "method": "POST", "path": "/upload/storage/v1/b/{new_bucket}/o", "query": {"uploadType": "multipart", "fields": "name,storageClass"}, "headers": {"Content-Type": "multipart/related; boundary=gcsmimicdiff"}, "body_text": "--gcsmimicdiff\r\nContent-Type: application/json; charset=UTF-8\r\n\r\n{{\"name\":\"{object}-d\"}}\r\n--gcsmimicdiff\r\nContent-Type: text/plain\r\n\r\nx\r\n--gcsmimicdiff--"},
    {"name": "cleanup-r", "method": "DELETE", "path": "/storage/v1/b/{new_bucket}/o/{object}-r", "compare": false, "always": true},
    {"name": "cleanup-s", "method": "DELETE", "path": "/storage/v1/b/{new_bucket}/o/{object}-s", "compare": false, "always": true},
    {"name": "cleanup-x", "method": "DELETE", "path": "/storage/v1/b/{new_bucket}/o/{object}-x", "compare": false, "always": true},
    {"name": "cleanup-rw", "method": "DELETE", "path": "/storage/v1/b/{new_bucket}/o/{object}-rw", "compare": false, "always": true},
    {"name": "cleanup-c", "method": "DELETE", "path": "/storage/v1/b/{new_bucket}/o/{object}-c", "compare": false, "always": true},
    {"name": "cleanup-g", "method": "DELETE", "path": "/storage/v1/b/{new_bucket}/o/{object}-g", "compare": false, "always": true},
    {"name": "cleanup-gr", "method": "DELETE", "path": "/storage/v1/b/{new_bucket}/o/{object}-gr", "compare": false, "always": true},
    {"name": "cleanup-d", "method": "DELETE", "path": "/storage/v1/b/{new_bucket}/o/{object}-d", "compare": false, "always": true},
    {"name": "delete-bucket", "method": "DELETE", "path": "/storage/v1/b/{new_bucket}", "compare": false, "always": true}
  ]
}
