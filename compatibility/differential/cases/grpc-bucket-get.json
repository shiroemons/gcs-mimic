{
  "id": "grpc-bucket-get",
  "description": "gRPC GetBucket: full resource, a read mask, a missing bucket, an invalid name and a failed metageneration precondition.",
  "steps": [
    {"name": "get", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetBucket", "headers": {"x-goog-request-params": "bucket=projects/_/buckets/{bucket}"}, "body": {"name": "projects/_/buckets/{bucket}"}, "expect_status": 0},
    {"name": "get-read-mask", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetBucket", "headers": {"x-goog-request-params": "bucket=projects/_/buckets/{bucket}"}, "body": {"name": "projects/_/buckets/{bucket}", "readMask": {"paths": ["name", "location", "storageClass", "metageneration"]}}, "expect_status": 0},
    {"name": "get-missing", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetBucket", "headers": {"x-goog-request-params": "bucket=projects/_/buckets/{missing_bucket}"}, "body": {"name": "projects/_/buckets/{missing_bucket}"}, "expect_status": 5},
    {"name": "get-invalid-name", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetBucket", "headers": {"x-goog-request-params": "bucket={bucket}"}, "body": {"name": "{bucket}"}, "expect_status": 3},
    {"name": "get-metageneration-mismatch", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetBucket", "headers": {"x-goog-request-params": "bucket=projects/_/buckets/{bucket}"}, "body": {"name": "projects/_/buckets/{bucket}", "ifMetagenerationMatch": "99"}, "expect_status": 9}
  ]
}
