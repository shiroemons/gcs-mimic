{
  "id": "bkt-probe-collection-validators",
  "description": "Validator headers on the collection listings obj-collection-validators left out: the bucket ACL, default object ACL, notification configuration (the shared bucket has none) and HMAC key listings (no key is created), each plain, with If-None-Match: * and with If-Match: \"bogus\", and the object ACL listing, which carries an ETag, with the same two headers. Compared on the ETag and cache headers only. Checks SPEC-JSON-ETAG-COLLECTIONS.",
  "steps": [
    {"name": "upload", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "media", "name": "{object}"}, "headers": {"Content-Type": "text/plain"}, "body_text": "hello", "compare": false, "expect_status": 200},
    {"name": "bucket-acl-list", "method": "GET", "path": "/storage/v1/b/{bucket}/acl", "compare": {"only_headers": ["etag", "cache-control", "last-modified"], "body": "ignore"}, "expect_status": 200},
    {"name": "bucket-acl-list-if-none-match-star", "method": "GET", "path": "/storage/v1/b/{bucket}/acl", "headers": {"If-None-Match": "*"}, "compare": {"only_headers": ["etag", "cache-control"], "body": "ignore"}},
    {"name": "bucket-acl-list-if-match-bogus", "method": "GET", "path": "/storage/v1/b/{bucket}/acl", "headers": {"If-Match": "\"bogus\""}, "compare": {"only_headers": ["etag", "cache-control"], "body": "ignore"}},
    {"name": "default-acl-list", "method": "GET", "path": "/storage/v1/b/{bucket}/defaultObjectAcl", "compare": {"only_headers": ["etag", "cache-control", "last-modified"], "body": "ignore"}, "expect_status": 200},
    {"name": "default-acl-list-if-none-match-star", "method": "GET", "path": "/storage/v1/b/{bucket}/defaultObjectAcl", "headers": {"If-None-Match": "*"}, "compare": {"only_headers": ["etag", "cache-control"], "body": "ignore"}},
    {"name": "default-acl-list-if-match-bogus", "method": "GET", "path": "/storage/v1/b/{bucket}/defaultObjectAcl", "headers": {"If-Match": "\"bogus\""}, "compare": {"only_headers": ["etag", "cache-control"], "body": "ignore"}},
    {"name": "notification-list", "method": "GET", "path": "/storage/v1/b/{bucket}/notificationConfigs", "compare": {"only_headers": ["etag", "cache-control", "last-modified"], "body": "ignore"}, "expect_status": 200},
    {"name": "notification-list-if-none-match-star", "method": "GET", "path": "/storage/v1/b/{bucket}/notificationConfigs", "headers": {"If-None-Match": "*"}, "compare": {"only_headers": ["etag", "cache-control"], "body": "ignore"}},
    {"name": "notification-list-if-match-bogus", "method": "GET", "path": "/storage/v1/b/{bucket}/notificationConfigs", "headers": {"If-Match": "\"bogus\""}, "compare": {"only_headers": ["etag", "cache-control"], "body": "ignore"}},
    {"name": "hmac-key-list", "method": "GET", "path": "/storage/v1/projects/{project}/hmacKeys", "compare": {"only_headers": ["etag", "cache-control", "last-modified"], "body": "ignore"}, "expect_status": 200},
    {"name": "hmac-key-list-if-none-match-star", "method": "GET", "path": "/storage/v1/projects/{project}/hmacKeys", "headers": {"If-None-Match": "*"}, "compare": {"only_headers": ["etag", "cache-control"], "body": "ignore"}},
    {"name": "hmac-key-list-if-match-bogus", "method": "GET", "path": "/storage/v1/projects/{project}/hmacKeys", "headers": {"If-Match": "\"bogus\""}, "compare": {"only_headers": ["etag", "cache-control"], "body": "ignore"}},
    {"name": "object-acl-list", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}/acl", "compare": {"only_headers": ["etag", "cache-control", "last-modified"], "body": "ignore"}, "expect_status": 200},
    {"name": "object-acl-list-if-none-match-star", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}/acl", "headers": {"If-None-Match": "*"}, "compare": {"only_headers": ["etag", "cache-control"], "body": "ignore"}},
    {"name": "object-acl-list-if-match-bogus", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}/acl", "headers": {"If-Match": "\"bogus\""}, "compare": {"only_headers": ["etag", "cache-control"], "body": "ignore"}},
    {"name": "cleanup", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}", "compare": false, "always": true}
  ]
}
