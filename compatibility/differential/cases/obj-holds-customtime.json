{
  "id": "obj-holds-customtime",
  "description": "Temporary and event-based holds block delete and overwrite; PUT omission, explicit null and false; customTime set, backdate, clear and PUT omission. Both holds are released and the object deleted at the end. Checks SPEC-OBJECT-HOLDS-CUSTOMTIME and SPEC-EVENT-HOLD-WIRE.",
  "steps": [
    {"name": "upload", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "media", "name": "{object}"}, "headers": {"Content-Type": "text/plain"}, "body_text": "hello", "compare": false, "expect_status": 200},
    {"name": "set-temporary-hold", "method": "PATCH", "path": "/storage/v1/b/{bucket}/o/{object}", "body": {"temporaryHold": true}, "expect_status": 200},
    {"name": "delete-under-temporary-hold", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}", "expect_status": 403},
    {"name": "overwrite-under-temporary-hold", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "media", "name": "{object}"}, "headers": {"Content-Type": "text/plain"}, "body_text": "again", "expect_status": 403},
    {"name": "patch-metadata-under-hold", "method": "PATCH", "path": "/storage/v1/b/{bucket}/o/{object}", "body": {"metadata": {"a": "1"}}, "expect_status": 200},
    {"name": "put-omits-hold", "method": "PUT", "path": "/storage/v1/b/{bucket}/o/{object}", "body": {"metadata": {"b": "2"}}, "expect_status": 200},
    {"name": "put-null-hold", "method": "PUT", "path": "/storage/v1/b/{bucket}/o/{object}", "body": {"temporaryHold": null}, "expect_status": 200},
    {"name": "get-hold-state", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"fields": "name,temporaryHold,eventBasedHold"}, "expect_status": 200},
    {"name": "release-temporary-hold", "method": "PATCH", "path": "/storage/v1/b/{bucket}/o/{object}", "body": {"temporaryHold": false}, "expect_status": 200},
    {"name": "set-event-based-hold", "method": "PATCH", "path": "/storage/v1/b/{bucket}/o/{object}", "body": {"eventBasedHold": true}, "expect_status": 200},
    {"name": "delete-under-event-hold", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}", "expect_status": 403},
    {"name": "both-holds", "method": "PATCH", "path": "/storage/v1/b/{bucket}/o/{object}", "body": {"temporaryHold": true}, "expect_status": 200},
    {"name": "release-event-hold-only", "method": "PATCH", "path": "/storage/v1/b/{bucket}/o/{object}", "body": {"eventBasedHold": false}, "expect_status": 200},
    {"name": "delete-still-held", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}", "expect_status": 403},
    {"name": "hold-invalid-type", "method": "PATCH", "path": "/storage/v1/b/{bucket}/o/{object}", "body": {"temporaryHold": "yes"}, "expect_status": 200},
    {"name": "release-all", "method": "PATCH", "path": "/storage/v1/b/{bucket}/o/{object}", "body": {"temporaryHold": false, "eventBasedHold": false}, "expect_status": 200},
    {"name": "set-custom-time", "method": "PATCH", "path": "/storage/v1/b/{bucket}/o/{object}", "body": {"customTime": "2030-01-01T00:00:00Z"}, "expect_status": 200},
    {"name": "custom-time-backdate", "method": "PATCH", "path": "/storage/v1/b/{bucket}/o/{object}", "body": {"customTime": "2029-01-01T00:00:00Z"}, "expect_status": 400},
    {"name": "custom-time-null", "method": "PATCH", "path": "/storage/v1/b/{bucket}/o/{object}", "body": {"customTime": null}, "expect_status": 200},
    {"name": "custom-time-invalid-format", "method": "PATCH", "path": "/storage/v1/b/{bucket}/o/{object}", "body": {"customTime": "yesterday"}, "expect_status": 400},
    {"name": "custom-time-later", "method": "PATCH", "path": "/storage/v1/b/{bucket}/o/{object}", "body": {"customTime": "2031-01-01T00:00:00Z"}, "expect_status": 200},
    {"name": "put-omits-custom-time", "method": "PUT", "path": "/storage/v1/b/{bucket}/o/{object}", "body": {"metadata": {"c": "3"}}, "expect_status": 200},
    {"name": "put-with-custom-time", "method": "PUT", "path": "/storage/v1/b/{bucket}/o/{object}", "body": {"customTime": "2031-01-01T00:00:00Z"}, "expect_status": 200},
    {"name": "upload-with-custom-time", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "multipart"}, "headers": {"Content-Type": "multipart/related; boundary=gcsmimicdiff"}, "body_text": "--gcsmimicdiff\r\nContent-Type: application/json; charset=UTF-8\r\n\r\n{{\"name\":\"{object2}\",\"customTime\":\"2030-06-01T00:00:00Z\",\"temporaryHold\":true}}\r\n--gcsmimicdiff\r\nContent-Type: text/plain\r\n\r\nhello\r\n--gcsmimicdiff--", "expect_status": 200},
    {"name": "release-upload-hold", "method": "PATCH", "path": "/storage/v1/b/{bucket}/o/{object2}", "body": {"temporaryHold": false, "eventBasedHold": false}, "compare": false, "always": true},
    {"name": "release-all-final", "method": "PATCH", "path": "/storage/v1/b/{bucket}/o/{object}", "body": {"temporaryHold": false, "eventBasedHold": false}, "compare": false, "always": true},
    {"name": "cleanup-main", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}", "compare": false, "always": true},
    {"name": "cleanup-upload", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object2}", "compare": false, "always": true}
  ]
}
