{
  "id": "grpc-probe-object-masks",
  "description": "Storage v2 object read and update masks, the object etag and decompressive transcoding, on the shared bucket. Read masks: an unknown path on a missing object and in a missing bucket (the existing-object answer was recorded in grpc-read-mask), nested GetObject paths other than the checksum digests (owner.entity, an unknown leaf, a sub-field of the repeated acl), metadata.owner.entity on ReadObject, and ListObjects with an unknown path on an empty page and on a page with an object, and with owner.entity. UpdateObject: a superseded and the current object.etag, an unknown path, the output-only create_time and update_time paths, an empty and an absent update_mask, and a * mask with only a content type on an object that holds custom metadata, a content language and a cache control, read back whole (the 2026-11-13 * step updated an object without such fields, so it did not show what * resets). ReadObject of a 28-byte gzip object stored with content_encoding gzip shows whether Storage v2 transcodes. Asks RPC-STORAGE-014 get_object_nested_masks and get_object_mask_validation_order, RPC-STORAGE-015 read_object_nested_masks and read_object_transcoding, RPC-STORAGE-017 grpc_update_object_etag and grpc_update_object_wildcard_mask, RPC-STORAGE-020 list_nested_masks and list_mask_validation_order, and BEHAVIOR-RPC-002 grpc_masks_nested_paths, grpc_masks_output_only_update_paths and grpc_masks_validation_order (SPEC-GRPC-LOCAL-CHOICES).",
  "steps": [
    {"name": "write", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}", "contentType": "text/plain", "contentLanguage": "en", "cacheControl": "no-cache", "metadata": {"k": "v"}}, "objectSize": "5"}, "checksummedData": {"content": "aGVsbG8="}, "finishWrite": true}], "compare": false, "expect_status": 0},
    {"name": "get-missing-object-unknown-path", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": "projects/_/buckets/{bucket}", "object": "{object}-missing", "readMask": {"paths": ["no_such_field"]}}},
    {"name": "get-missing-bucket-unknown-path", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{missing_bucket}"}, "body": {"bucket": "projects/_/buckets/{missing_bucket}", "object": "{object}", "readMask": {"paths": ["no_such_field"]}}},
    {"name": "get-nested-owner-entity", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": "projects/_/buckets/{bucket}", "object": "{object}", "readMask": {"paths": ["owner.entity"]}}},
    {"name": "get-nested-unknown-leaf", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": "projects/_/buckets/{bucket}", "object": "{object}", "readMask": {"paths": ["owner.no_such_field"]}}},
    {"name": "get-nested-repeated", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": "projects/_/buckets/{bucket}", "object": "{object}", "readMask": {"paths": ["name", "acl.role"]}}},
    {"name": "read-nested-owner-entity", "protocol": "grpc", "rpc": "google.storage.v2.Storage/ReadObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": "projects/_/buckets/{bucket}", "object": "{object}", "readMask": {"paths": ["checksummed_data.content", "metadata.owner.entity"]}}},
    {"name": "list-empty-page-unknown-path", "protocol": "grpc", "rpc": "google.storage.v2.Storage/ListObjects", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"parent": "projects/_/buckets/{bucket}", "prefix": "{object}-none/", "readMask": {"paths": ["no_such_field"]}}},
    {"name": "list-unknown-path", "protocol": "grpc", "rpc": "google.storage.v2.Storage/ListObjects", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"parent": "projects/_/buckets/{bucket}", "prefix": "{object}", "readMask": {"paths": ["no_such_field"]}}},
    {"name": "list-nested-owner-entity", "protocol": "grpc", "rpc": "google.storage.v2.Storage/ListObjects", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"parent": "projects/_/buckets/{bucket}", "prefix": "{object}", "readMask": {"paths": ["name", "owner.entity"]}}},
    {"name": "get-etag", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": "projects/_/buckets/{bucket}", "object": "{object}", "readMask": {"paths": ["etag", "metageneration"]}}, "capture": {"etag1": "body:etag"}, "expect_status": 0},
    {"name": "update-content-language", "protocol": "grpc", "rpc": "google.storage.v2.Storage/UpdateObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"object": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}", "contentLanguage": "fr"}, "updateMask": {"paths": ["content_language"]}}, "compare": false},
    {"name": "update-superseded-etag", "protocol": "grpc", "rpc": "google.storage.v2.Storage/UpdateObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"object": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}", "etag": "{etag1}", "contentLanguage": "de"}, "updateMask": {"paths": ["content_language"]}}},
    {"name": "get-etag-before-current", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": "projects/_/buckets/{bucket}", "object": "{object}", "readMask": {"paths": ["etag", "metageneration", "content_language"]}}, "capture": {"etag2": "body:etag"}, "expect_status": 0},
    {"name": "update-current-etag", "protocol": "grpc", "rpc": "google.storage.v2.Storage/UpdateObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"object": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}", "etag": "{etag2}", "contentLanguage": "it"}, "updateMask": {"paths": ["content_language"]}}},
    {"name": "update-unknown-path", "protocol": "grpc", "rpc": "google.storage.v2.Storage/UpdateObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"object": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}"}, "updateMask": {"paths": ["no_such_field"]}}},
    {"name": "update-output-only-create-time", "protocol": "grpc", "rpc": "google.storage.v2.Storage/UpdateObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"object": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}", "createTime": "2020-01-01T00:00:00Z"}, "updateMask": {"paths": ["create_time"]}}},
    {"name": "update-output-only-update-time", "protocol": "grpc", "rpc": "google.storage.v2.Storage/UpdateObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"object": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}", "updateTime": "2020-01-01T00:00:00Z"}, "updateMask": {"paths": ["update_time"]}}},
    {"name": "update-empty-mask", "protocol": "grpc", "rpc": "google.storage.v2.Storage/UpdateObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"object": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}", "contentType": "text/x-empty-mask"}, "updateMask": {}}},
    {"name": "update-absent-mask", "protocol": "grpc", "rpc": "google.storage.v2.Storage/UpdateObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"object": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}", "contentType": "text/x-absent-mask"}}},
    {"name": "get-before-wildcard", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": "projects/_/buckets/{bucket}", "object": "{object}", "readMask": {"paths": ["content_type", "content_language", "cache_control", "metadata", "metageneration"]}}},
    {"name": "update-wildcard-content-type-only", "protocol": "grpc", "rpc": "google.storage.v2.Storage/UpdateObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"object": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}", "contentType": "text/x-wildcard"}, "updateMask": {"paths": ["*"]}}},
    {"name": "get-after-wildcard", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": "projects/_/buckets/{bucket}", "object": "{object}"}},
    {"name": "upload-gzip", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "media", "name": "{object}-gz", "contentEncoding": "gzip"}, "headers": {"Content-Type": "text/plain"}, "body_base64": "H4sIAAAAAAACA8tIzcnJV8hAkACAiPnlEQAAAA==", "compare": false, "expect_status": 200},
    {"name": "read-gzip", "protocol": "grpc", "rpc": "google.storage.v2.Storage/ReadObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": "projects/_/buckets/{bucket}", "object": "{object}-gz"}}
  ]
}
