{
  "id": "obj-probe-resumable-alias-session",
  "description": "Data and finalization requests on the session URL that a resumable initiation through the Discovery /resumable/upload alias returns, sent to that alias path with the name, uploadType and upload_id its Location carries: a 256 KiB chunk whose total is open, a status query, the final 5-byte chunk and a read of the result. obj-resumable-edges recorded only the initiation. Checks SPEC-RSM-DISCOVERY-PATH.",
  "steps": [
    {"name": "start-alias", "method": "POST", "path": "/resumable/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "name": "{object}"}, "headers": {"Content-Type": "application/json"}, "body": {"contentType": "text/plain"}, "capture": {"up": "header:location?upload_id"}, "expect_status": 200},
    {"name": "alias-open-chunk", "method": "PUT", "path": "/resumable/upload/storage/v1/b/{bucket}/o", "query": {"name": "{object}", "uploadType": "resumable", "upload_id": "{up}"}, "headers": {"Content-Range": "bytes 0-262143/*"}, "body_repeat": {"text": "a", "times": 262144}},
    {"name": "alias-status", "method": "PUT", "path": "/resumable/upload/storage/v1/b/{bucket}/o", "query": {"name": "{object}", "uploadType": "resumable", "upload_id": "{up}"}, "headers": {"Content-Range": "bytes */*"}, "body_text": ""},
    {"name": "alias-final-chunk", "method": "PUT", "path": "/resumable/upload/storage/v1/b/{bucket}/o", "query": {"name": "{object}", "uploadType": "resumable", "upload_id": "{up}"}, "headers": {"Content-Range": "bytes 262144-262148/262149"}, "body_text": "hello"},
    {"name": "get-result", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"fields": "name,size,contentType,crc32c,md5Hash"}},
    {"name": "cleanup", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}", "compare": false, "always": true}
  ]
}
