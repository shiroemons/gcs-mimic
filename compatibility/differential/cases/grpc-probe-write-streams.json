    {"name": "single-wrong-crc32c-and-offset-past-start", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-n5", "contentType": "text/plain"}}, "writeOffset": "3", "checksummedData": {"content": "aGVsbG8=", "crc32c": 1}, "finishWrite": true}]},
    {"name": "single-wrong-crc32c-and-object-size", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-n6", "contentType": "text/plain"}, "objectSize": "9"}, "writeOffset": "0", "checksummedData": {"content": "aGVsbG8=", "crc32c": 1}, "finishWrite": true}]},
    {"name": "single-malformed-key-and-failing-condition", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-n7", "contentType": "text/plain"}, "ifGenerationMatch": "1"}, "writeOffset": "0", "checksummedData": {"content": "aGVsbG8="}, "finishWrite": true, "commonObjectRequestParams": {"encryptionAlgorithm": "AES256", "encryptionKeyBytes": "AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQ==", "encryptionKeySha256Bytes": "zF9s8y82Hp+1BQbHCoZsJb9ZVv8JXNXJaOuxTyJBKmM="}}]}
  ]
