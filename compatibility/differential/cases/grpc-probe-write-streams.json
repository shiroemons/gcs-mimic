{
  "id": "grpc-probe-write-streams",
  "description": "Storage v2 WriteObject stream shapes the ledger leaves open, on the shared bucket, each resumable shape on a session of its own. Resumable: a finishing total below and above the session's object_size, data with a wrong crc32c and QueryWriteStatus afterwards, a second message that names the upload_id again, object_checksums on the first message and on a middle message, a message after finish_write and QueryWriteStatus afterwards, and the first write_offset above, below and at the persisted size. The proto requires a nonfinal message to carry a multiple of 256 KiB, so the persisted size comes from a nonfinal 3-byte message (hel): its WriteObjectResponse and the QueryWriteStatus after it show whether the service persists such a prefix and which responses carry persisted_data_checksums; the below and at steps send the rest of hello from offset 1 and offset 3, so they test resumption only if those 3 bytes were persisted. Non-resumable: a stream that ends without finish_write, a message after finish_write, a second write_object_spec, and a wrong crc32c beside a failing condition, beside a write_offset past the start and beside a wrong object_size, and a malformed customer-supplied key beside a failing condition. Every object holds at most 7 bytes. Asks RPC-STORAGE-018 write_local_precedence, RPC-STORAGE-023 query_status_persisted_checksums, and BEHAVIOR-RPC-003 stream_after_finish, stream_resume_offset, stream_persisted_checksums and stream_resumable_first_checksums (SPEC-GRPC-LOCAL-CHOICES).",
  "steps": [
    {"name": "start-short", "protocol": "grpc", "rpc": "google.storage.v2.Storage/StartResumableWrite", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-short", "contentType": "text/plain"}, "objectSize": "5"}}, "capture": {"short": "body:uploadId"}, "compare": false, "expect_status": 0},
    {"name": "finish-below-object-size", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"uploadId": "{short}", "writeOffset": "0", "checksummedData": {"content": "YWJj"}, "finishWrite": true}]},
    {"name": "status-after-below-object-size", "protocol": "grpc", "rpc": "google.storage.v2.Storage/QueryWriteStatus", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"uploadId": "{short}"}},
    {"name": "start-long", "protocol": "grpc", "rpc": "google.storage.v2.Storage/StartResumableWrite", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-long", "contentType": "text/plain"}, "objectSize": "5"}}, "capture": {"long": "body:uploadId"}, "compare": false, "expect_status": 0},
    {"name": "finish-above-object-size", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"uploadId": "{long}", "writeOffset": "0", "checksummedData": {"content": "YWJjZGVmZw=="}, "finishWrite": true}]},
    {"name": "start-crc", "protocol": "grpc", "rpc": "google.storage.v2.Storage/StartResumableWrite", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-crc", "contentType": "text/plain"}}}, "capture": {"crc": "body:uploadId"}, "compare": false, "expect_status": 0},
    {"name": "finish-wrong-data-crc32c", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"uploadId": "{crc}", "writeOffset": "0", "checksummedData": {"content": "aGVsbG8=", "crc32c": 1}, "finishWrite": true}]},
    {"name": "status-after-wrong-data-crc32c", "protocol": "grpc", "rpc": "google.storage.v2.Storage/QueryWriteStatus", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"uploadId": "{crc}"}},
    {"name": "start-repeat", "protocol": "grpc", "rpc": "google.storage.v2.Storage/StartResumableWrite", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-repeat", "contentType": "text/plain"}}}, "capture": {"repeat": "body:uploadId"}, "compare": false, "expect_status": 0},
    {"name": "upload-id-repeated", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"uploadId": "{repeat}", "writeOffset": "0"}, {"uploadId": "{repeat}", "writeOffset": "0", "checksummedData": {"content": "aGVsbG8="}, "finishWrite": true}]},
    {"name": "start-first-checksums", "protocol": "grpc", "rpc": "google.storage.v2.Storage/StartResumableWrite", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-first", "contentType": "text/plain"}}}, "capture": {"first": "body:uploadId"}, "compare": false, "expect_status": 0},
    {"name": "object-checksums-on-first-message", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"uploadId": "{first}", "writeOffset": "0", "objectChecksums": {"crc32c": 2591144780}}, {"writeOffset": "0", "checksummedData": {"content": "aGVsbG8="}, "finishWrite": true}]},
    {"name": "start-middle-checksums", "protocol": "grpc", "rpc": "google.storage.v2.Storage/StartResumableWrite", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-middle", "contentType": "text/plain"}}}, "capture": {"middle": "body:uploadId"}, "compare": false, "expect_status": 0},
    {"name": "object-checksums-on-middle-message", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"uploadId": "{middle}", "writeOffset": "0"}, {"writeOffset": "0", "objectChecksums": {"crc32c": 2591144780}}, {"writeOffset": "0", "checksummedData": {"content": "aGVsbG8="}, "finishWrite": true}]},
    {"name": "start-after-finish", "protocol": "grpc", "rpc": "google.storage.v2.Storage/StartResumableWrite", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-after", "contentType": "text/plain"}}}, "capture": {"after": "body:uploadId"}, "compare": false, "expect_status": 0},
    {"name": "message-after-finish-write", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"uploadId": "{after}", "writeOffset": "0", "checksummedData": {"content": "aGVsbG8="}, "finishWrite": true}, {"writeOffset": "5", "checksummedData": {"content": "eA=="}}]},
    {"name": "status-after-message-after-finish-write", "protocol": "grpc", "rpc": "google.storage.v2.Storage/QueryWriteStatus", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"uploadId": "{after}"}},
    {"name": "start-offsets", "protocol": "grpc", "rpc": "google.storage.v2.Storage/StartResumableWrite", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-offsets", "contentType": "text/plain"}}}, "capture": {"offsets": "body:uploadId"}, "compare": false, "expect_status": 0},
    {"name": "nonfinal-three-bytes", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"uploadId": "{offsets}", "writeOffset": "0", "checksummedData": {"content": "aGVs"}}]},
    {"name": "status-after-nonfinal-three-bytes", "protocol": "grpc", "rpc": "google.storage.v2.Storage/QueryWriteStatus", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"uploadId": "{offsets}"}},
    {"name": "first-offset-above-persisted", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"uploadId": "{offsets}", "writeOffset": "5", "checksummedData": {"content": "eA=="}}]},
    {"name": "first-offset-below-persisted-finish", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"uploadId": "{offsets}", "writeOffset": "1", "checksummedData": {"content": "ZWxsbw=="}, "finishWrite": true}]},
    {"name": "status-after-below-persisted", "protocol": "grpc", "rpc": "google.storage.v2.Storage/QueryWriteStatus", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"uploadId": "{offsets}"}},
    {"name": "start-at", "protocol": "grpc", "rpc": "google.storage.v2.Storage/StartResumableWrite", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-at", "contentType": "text/plain"}}}, "capture": {"at": "body:uploadId"}, "compare": false, "expect_status": 0},
    {"name": "nonfinal-three-bytes-again", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"uploadId": "{at}", "writeOffset": "0", "checksummedData": {"content": "aGVs"}}]},
    {"name": "first-offset-at-persisted-finish", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"uploadId": "{at}", "writeOffset": "3", "checksummedData": {"content": "bG8="}, "finishWrite": true}]},
    {"name": "single-without-finish-write", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-n1", "contentType": "text/plain"}}, "writeOffset": "0", "checksummedData": {"content": "aGVsbG8="}}]},
    {"name": "single-message-after-finish-write", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-n2", "contentType": "text/plain"}}, "writeOffset": "0", "checksummedData": {"content": "aGVsbG8="}, "finishWrite": true}, {"writeOffset": "5", "checksummedData": {"content": "eA=="}}]},
    {"name": "single-spec-repeated", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-n3", "contentType": "text/plain"}}, "writeOffset": "0"}, {"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-n3", "contentType": "text/plain"}}, "writeOffset": "0", "checksummedData": {"content": "aGVsbG8="}, "finishWrite": true}]},
