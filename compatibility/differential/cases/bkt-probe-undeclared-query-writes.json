{
  "id": "bkt-probe-undeclared-query-writes",
  "description": "The undeclared query parameter gcsmimicUnknown=1 on the methods bkt-probe-undeclared-query-resources and obj-probe-undeclared-query-acls left unrecorded, in a bucket of its own: bucket ACL and default object ACL patch, update, delete and insert of the project-viewers entity (never a public entity), each followed by a plain listing that shows which changes took effect; setIamPolicy writing back the default legacy bindings; a notification insert naming a topic that does not exist and a delete of a missing configuration; get, update and delete of a missing HMAC key (no key is created); and the project service account. Checks SPEC-JSON-UNKNOWN-QUERY-OBJECTS.",
  "bucket": "own",
  "steps": [
    {
      "name": "bucket-project-number",
      "method": "GET",
      "path": "/storage/v1/b/{bucket}",
      "query": {
        "fields": "projectNumber"
      },
      "capture": {
        "pn": "body:projectNumber"
      },
      "compare": false,
      "expect_status": 200
    },
    {
      "name": "bucket-acl-patch",
      "method": "PATCH",
      "path": "/storage/v1/b/{bucket}/acl/project-viewers-{pn}",
      "query": {
        "gcsmimicUnknown": "1"
      },
      "body": {
        "role": "READER"
      }
    },
    {
      "name": "bucket-acl-update",
      "method": "PUT",
      "path": "/storage/v1/b/{bucket}/acl/project-viewers-{pn}",
      "query": {
        "gcsmimicUnknown": "1"
      },
      "body": {
        "entity": "project-viewers-{pn}",
        "role": "READER"
      }
    },
    {
      "name": "bucket-acl-delete",
      "method": "DELETE",
      "path": "/storage/v1/b/{bucket}/acl/project-viewers-{pn}",
      "query": {
        "gcsmimicUnknown": "1"
      }
    },
    {
      "name": "bucket-acl-list-after-delete",
      "method": "GET",
      "path": "/storage/v1/b/{bucket}/acl",
      "expect_status": 200
    },
    {
      "name": "bucket-acl-insert",
      "method": "POST",
      "path": "/storage/v1/b/{bucket}/acl",
      "query": {
        "gcsmimicUnknown": "1"
      },
      "body": {
        "entity": "project-viewers-{pn}",
        "role": "READER"
      }
    },
    {
      "name": "bucket-acl-list-after-insert",
      "method": "GET",
      "path": "/storage/v1/b/{bucket}/acl",
      "expect_status": 200
    },
    {
      "name": "default-acl-patch",
      "method": "PATCH",
      "path": "/storage/v1/b/{bucket}/defaultObjectAcl/project-viewers-{pn}",
      "query": {
        "gcsmimicUnknown": "1"
      },
      "body": {
        "role": "READER"
      }
    },
    {
      "name": "default-acl-update",
      "method": "PUT",
      "path": "/storage/v1/b/{bucket}/defaultObjectAcl/project-viewers-{pn}",
      "query": {
        "gcsmimicUnknown": "1"
      },
      "body": {
        "entity": "project-viewers-{pn}",
        "role": "READER"
      }
    },
    {
      "name": "default-acl-delete",
      "method": "DELETE",
      "path": "/storage/v1/b/{bucket}/defaultObjectAcl/project-viewers-{pn}",
      "query": {
        "gcsmimicUnknown": "1"
      }
    },
    {
      "name": "default-acl-list-after-delete",
      "method": "GET",
      "path": "/storage/v1/b/{bucket}/defaultObjectAcl",
      "expect_status": 200
    },
    {
      "name": "default-acl-insert",
      "method": "POST",
      "path": "/storage/v1/b/{bucket}/defaultObjectAcl",
      "query": {
        "gcsmimicUnknown": "1"
      },
      "body": {
        "entity": "project-viewers-{pn}",
        "role": "READER"
      }
    },
    {
      "name": "default-acl-list-after-insert",
      "method": "GET",
      "path": "/storage/v1/b/{bucket}/defaultObjectAcl",
      "expect_status": 200
    },
    {
      "name": "iam-set-default-bindings",
      "method": "PUT",
      "path": "/storage/v1/b/{bucket}/iam",
      "query": {
        "gcsmimicUnknown": "1"
      },
      "body": {
        "bindings": [
          {
            "role": "roles/storage.legacyBucketOwner",
            "members": [
              "projectEditor:{project}",
              "projectOwner:{project}"
            ]
          },
          {
            "role": "roles/storage.legacyBucketReader",
            "members": [
              "projectViewer:{project}"
            ]
          }
        ]
      }
    },
    {
      "name": "iam-get-after-set",
      "method": "GET",
      "path": "/storage/v1/b/{bucket}/iam",
      "expect_status": 200
    },
    {
      "name": "notification-insert-missing-topic",
      "method": "POST",
      "path": "/storage/v1/b/{bucket}/notificationConfigs",
      "query": {
        "gcsmimicUnknown": "1"
      },
      "body": {
        "topic": "//pubsub.googleapis.com/projects/{project}/topics/gcs-mimic-diff-no-such-topic",
        "payload_format": "JSON_API_V1"
      }
    },
    {
      "name": "notification-delete-missing",
      "method": "DELETE",
      "path": "/storage/v1/b/{bucket}/notificationConfigs/999999",
      "query": {
        "gcsmimicUnknown": "1"
      }
    },
    {
      "name": "hmac-key-get-missing",
      "method": "GET",
      "path": "/storage/v1/projects/{project}/hmacKeys/GOOGNOSUCHKEYID000000",
      "query": {
        "gcsmimicUnknown": "1"
      }
    },
    {
      "name": "hmac-key-update-missing",
      "method": "PUT",
      "path": "/storage/v1/projects/{project}/hmacKeys/GOOGNOSUCHKEYID000000",
      "query": {
        "gcsmimicUnknown": "1"
      },
      "body": {
        "state": "INACTIVE"
      }
    },
    {
      "name": "hmac-key-delete-missing",
      "method": "DELETE",
      "path": "/storage/v1/projects/{project}/hmacKeys/GOOGNOSUCHKEYID000000",
      "query": {
        "gcsmimicUnknown": "1"
      }
    },
    {
      "name": "service-account-get",
      "method": "GET",
      "path": "/storage/v1/projects/{project}/serviceAccount",
      "query": {
        "gcsmimicUnknown": "1"
      }
    }
  ]
}
