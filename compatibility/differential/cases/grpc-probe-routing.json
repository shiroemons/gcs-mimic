{
  "id": "grpc-probe-routing",
  "description": "Storage v2 routing metadata and resource names that the ledger keeps as local choices, on the shared bucket. GetObject, GetBucket and ListBuckets, and a WriteObject stream, sent without x-goog-request-params; GetObject and GetBucket whose routed bucket names another (missing) bucket than the request, whose routed bucket is a bare bucket ID instead of a resource name, or whose metadata adds an unknown key; GetObject whose metadata routes a project, or a routing_token beside the bucket. GetIamPolicy on an object resource, which the proto does not name for it. The grpc-timeout and grpc-encoding headers cannot be sent from a case: grpcurl's gRPC library drops reserved headers from the metadata it is given, takes the deadline from the harness's fixed -max-time and offers no request compression. Asks BEHAVIOR-RPC-001 (its routing scoped differences under SPEC-GRPC-ROUTING-NAMES and SPEC-GRPC-UNMODELED-SETTINGS) and RPC-STORAGE-006 (the object-resource local choice under SPEC-GRPC-LOCAL-CHOICES).",
  "steps": [
    {"name": "write", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}", "contentType": "text/plain"}, "objectSize": "5"}, "checksummedData": {"content": "aGVsbG8="}, "finishWrite": true}], "compare": false, "expect_status": 0},
    {"name": "get-object-without-routing", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetObject", "body": {"bucket": "projects/_/buckets/{bucket}", "object": "{object}", "readMask": {"paths": ["name", "size"]}}},
    {"name": "get-bucket-without-routing", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetBucket", "body": {"name": "projects/_/buckets/{bucket}", "readMask": {"paths": ["name"]}}},
    {"name": "list-buckets-without-routing", "protocol": "grpc", "rpc": "google.storage.v2.Storage/ListBuckets", "body": {"parent": "projects/{project}", "prefix": "{bucket}", "readMask": {"paths": ["name"]}}},
    {"name": "write-object-without-routing", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "body": [{"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-w", "contentType": "text/plain"}, "objectSize": "1"}, "checksummedData": {"content": "eA=="}, "finishWrite": true}]},
    {"name": "get-object-routed-other-bucket", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{missing_bucket}"}, "body": {"bucket": "projects/_/buckets/{bucket}", "object": "{object}", "readMask": {"paths": ["name", "size"]}}},
    {"name": "get-bucket-routed-other-bucket", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{missing_bucket}"}, "body": {"name": "projects/_/buckets/{bucket}", "readMask": {"paths": ["name"]}}},
    {"name": "get-object-routed-bare-bucket-id", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetObject", "headers": {"x-goog-request-params": "bucket={bucket}"}, "body": {"bucket": "projects/_/buckets/{bucket}", "object": "{object}", "readMask": {"paths": ["name", "size"]}}},
    {"name": "get-bucket-routed-bare-bucket-id", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetBucket", "headers": {"x-goog-request-params": "bucket={bucket}"}, "body": {"name": "projects/_/buckets/{bucket}", "readMask": {"paths": ["name"]}}},
    {"name": "get-object-routed-unknown-key", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}&gcsmimic_unknown=1"}, "body": {"bucket": "projects/_/buckets/{bucket}", "object": "{object}", "readMask": {"paths": ["name", "size"]}}},
    {"name": "get-bucket-routed-unknown-key", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}&gcsmimic_unknown=1"}, "body": {"name": "projects/_/buckets/{bucket}", "readMask": {"paths": ["name"]}}},
    {"name": "get-object-routed-project", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetObject", "headers": {"x-goog-request-params": "project=projects%2F{project}"}, "body": {"bucket": "projects/_/buckets/{bucket}", "object": "{object}", "readMask": {"paths": ["name", "size"]}}},
    {"name": "get-object-routed-routing-token", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}&routing_token=gcsmimic-probe"}, "body": {"bucket": "projects/_/buckets/{bucket}", "object": "{object}", "readMask": {"paths": ["name", "size"]}}},
    {"name": "get-iam-policy-object-resource", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetIamPolicy", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"resource": "projects/_/buckets/{bucket}/objects/{object}"}, "local_choice": {"reason": "Object IAM policies are not implemented: gcs-mimic keeps no policy for an object and refuses the resource, where Cloud Storage returns a version 1 policy that renders the object's ACL as roles/storage.legacyObjectReader and roles/storage.legacyObjectOwner bindings with an etag (SPEC-GRPC-LOCAL-CHOICES).", "mimic_status": 12}}
  ]
}
