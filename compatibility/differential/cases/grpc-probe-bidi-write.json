{
  "id": "grpc-probe-bidi-write",
  "description": "Storage v2 BidiWriteObject shapes the ledger leaves open, on the shared bucket. Cloud Storage refused BidiReadObject to the recording project as not allowlisted (grpc-gaps-bidi-read), and it may refuse BidiWriteObject the same way: the first step is a plain one-message write, so a refusal there says the remaining BidiWriteObject answers are refusals too and only the StartResumableWrite and QueryWriteStatus steps carry Storage v2 write answers. Non-resumable streams: a plain write; a nonfinal 3-byte message with flush and state_lookup, and one with state_lookup alone, each followed by the rest; a message after finish_write; a wrong crc32c; a total below object_size; a second write_object_spec. Resumable streams: a nonfinal 3-byte message with flush and state_lookup, QueryWriteStatus, a first write_offset above and then below the persisted size (the latter finishing), a state_lookup on the finalized upload, object_checksums on the first message with state_lookup, a second message that names the upload_id again, and a message after finish_write followed by QueryWriteStatus. Every object holds at most 5 bytes. Asks RPC-STORAGE-019 (its open stream shapes), BEHAVIOR-RPC-003 stream_single_flush, stream_after_finish, stream_resume_offset, stream_persisted_checksums and stream_resumable_first_checksums, and RPC-STORAGE-023 query_status_persisted_checksums (SPEC-GRPC-LOCAL-CHOICES).",
  "steps": [
    {"name": "single-finish", "protocol": "grpc", "rpc": "google.storage.v2.Storage/BidiWriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-single", "contentType": "text/plain"}}, "writeOffset": "0", "checksummedData": {"content": "aGVsbG8="}, "finishWrite": true}]},
    {"name": "single-flush-state-lookup", "protocol": "grpc", "rpc": "google.storage.v2.Storage/BidiWriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-flush", "contentType": "text/plain"}}, "writeOffset": "0", "checksummedData": {"content": "aGVs"}, "flush": true, "stateLookup": true}, {"writeOffset": "3", "checksummedData": {"content": "bG8="}, "finishWrite": true}]},
    {"name": "single-state-lookup-only", "protocol": "grpc", "rpc": "google.storage.v2.Storage/BidiWriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-lookup", "contentType": "text/plain"}}, "writeOffset": "0", "checksummedData": {"content": "aGVs"}, "stateLookup": true}, {"writeOffset": "3", "checksummedData": {"content": "bG8="}, "finishWrite": true}]},
    {"name": "single-message-after-finish-write", "protocol": "grpc", "rpc": "google.storage.v2.Storage/BidiWriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-after", "contentType": "text/plain"}}, "writeOffset": "0", "checksummedData": {"content": "aGVsbG8="}, "finishWrite": true}, {"writeOffset": "5", "checksummedData": {"content": "eA=="}}]},
    {"name": "single-wrong-data-crc32c", "protocol": "grpc", "rpc": "google.storage.v2.Storage/BidiWriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-crc", "contentType": "text/plain"}}, "writeOffset": "0", "checksummedData": {"content": "aGVsbG8=", "crc32c": 1}, "finishWrite": true}]},
    {"name": "single-below-object-size", "protocol": "grpc", "rpc": "google.storage.v2.Storage/BidiWriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-size", "contentType": "text/plain"}, "objectSize": "5"}, "writeOffset": "0", "checksummedData": {"content": "YWJj"}, "finishWrite": true}]},
    {"name": "single-spec-repeated", "protocol": "grpc", "rpc": "google.storage.v2.Storage/BidiWriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-repeat", "contentType": "text/plain"}}, "writeOffset": "0"}, {"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-repeat", "contentType": "text/plain"}}, "writeOffset": "0", "checksummedData": {"content": "aGVsbG8="}, "finishWrite": true}]},
    {"name": "start-resumable", "protocol": "grpc", "rpc": "google.storage.v2.Storage/StartResumableWrite", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-resumable", "contentType": "text/plain"}}}, "capture": {"resumable": "body:uploadId"}, "compare": false, "expect_status": 0},
    {"name": "resumable-flush-state-lookup", "protocol": "grpc", "rpc": "google.storage.v2.Storage/BidiWriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"uploadId": "{resumable}", "writeOffset": "0", "checksummedData": {"content": "aGVs"}, "flush": true, "stateLookup": true}]},
    {"name": "status-after-resumable-flush", "protocol": "grpc", "rpc": "google.storage.v2.Storage/QueryWriteStatus", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"uploadId": "{resumable}"}},
    {"name": "resumable-first-offset-above-persisted", "protocol": "grpc", "rpc": "google.storage.v2.Storage/BidiWriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"uploadId": "{resumable}", "writeOffset": "5", "checksummedData": {"content": "eA=="}, "stateLookup": true}]},
    {"name": "resumable-first-offset-below-persisted-finish", "protocol": "grpc", "rpc": "google.storage.v2.Storage/BidiWriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"uploadId": "{resumable}", "writeOffset": "1", "checksummedData": {"content": "ZWxsbw=="}, "finishWrite": true}]},
    {"name": "resumable-state-lookup-after-finalize", "protocol": "grpc", "rpc": "google.storage.v2.Storage/BidiWriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"uploadId": "{resumable}", "writeOffset": "0", "stateLookup": true}]},
    {"name": "start-first-checksums", "protocol": "grpc", "rpc": "google.storage.v2.Storage/StartResumableWrite", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-first", "contentType": "text/plain"}}}, "capture": {"first": "body:uploadId"}, "compare": false, "expect_status": 0},
    {"name": "resumable-object-checksums-on-first-message", "protocol": "grpc", "rpc": "google.storage.v2.Storage/BidiWriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"uploadId": "{first}", "writeOffset": "0", "objectChecksums": {"crc32c": 2591144780}, "stateLookup": true}, {"writeOffset": "0", "checksummedData": {"content": "aGVsbG8="}, "finishWrite": true}]},
    {"name": "start-repeat", "protocol": "grpc", "rpc": "google.storage.v2.Storage/StartResumableWrite", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-resumable-repeat", "contentType": "text/plain"}}}, "capture": {"repeat": "body:uploadId"}, "compare": false, "expect_status": 0},
    {"name": "resumable-upload-id-repeated", "protocol": "grpc", "rpc": "google.storage.v2.Storage/BidiWriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"uploadId": "{repeat}", "writeOffset": "0"}, {"uploadId": "{repeat}", "writeOffset": "0", "checksummedData": {"content": "aGVsbG8="}, "finishWrite": true}]},
    {"name": "start-after-finish", "protocol": "grpc", "rpc": "google.storage.v2.Storage/StartResumableWrite", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-resumable-after", "contentType": "text/plain"}}}, "capture": {"after": "body:uploadId"}, "compare": false, "expect_status": 0},
    {"name": "resumable-message-after-finish-write", "protocol": "grpc", "rpc": "google.storage.v2.Storage/BidiWriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"uploadId": "{after}", "writeOffset": "0", "checksummedData": {"content": "aGVsbG8="}, "finishWrite": true}, {"writeOffset": "5", "checksummedData": {"content": "eA=="}}]},
    {"name": "status-after-resumable-message-after-finish-write", "protocol": "grpc", "rpc": "google.storage.v2.Storage/QueryWriteStatus", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"uploadId": "{after}"}}
  ]
}
