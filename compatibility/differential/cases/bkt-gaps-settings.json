{
  "id": "bkt-gaps-settings",
  "description": "Bucket setting questions the gap ledger left open, on a bucket of its own: an object upload with a non-public predefinedAcl under uniform bucket-level access, conflicting uniform access aliases on a bucket where uniform access is already enabled (modern true with alias false, then modern false with alias true), and a lifecycle rule with the Early Access matchesPattern condition. Public access prevention stays enforced in every write, and uniform access and lifecycle are cleared at the end. Checks SPEC-UBLA-EDGES, SPEC-LIFECYCLE-CONFIG.",
  "bucket": "own",
  "steps": [
    {"name": "enable-ubla", "method": "PATCH", "path": "/storage/v1/b/{bucket}", "query": {"fields": "iamConfiguration"}, "body": {"iamConfiguration": {"uniformBucketLevelAccess": {"enabled": true}, "publicAccessPrevention": "enforced"}}, "compare": {"ignore_body_paths": ["iamConfiguration.uniformBucketLevelAccess.lockedTime", "iamConfiguration.bucketPolicyOnly.lockedTime"]}, "expect_status": 200},
    {"name": "upload-predefined-acl-under-ubla", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "media", "name": "{object}", "predefinedAcl": "private", "fields": "name"}, "headers": {"Content-Type": "text/plain"}, "body_text": "x"},
    {"name": "alias-conflict-modern-true-alias-false", "method": "PATCH", "path": "/storage/v1/b/{bucket}", "query": {"fields": "iamConfiguration"}, "body": {"iamConfiguration": {"uniformBucketLevelAccess": {"enabled": true}, "bucketPolicyOnly": {"enabled": false}, "publicAccessPrevention": "enforced"}}, "compare": {"ignore_body_paths": ["iamConfiguration.uniformBucketLevelAccess.lockedTime", "iamConfiguration.bucketPolicyOnly.lockedTime"]}},
    {"name": "get-after-conflict-modern-true", "method": "GET", "path": "/storage/v1/b/{bucket}", "query": {"fields": "iamConfiguration"}, "compare": {"ignore_body_paths": ["iamConfiguration.uniformBucketLevelAccess.lockedTime", "iamConfiguration.bucketPolicyOnly.lockedTime"]}, "expect_status": 200},
    {"name": "alias-conflict-modern-false-alias-true", "method": "PATCH", "path": "/storage/v1/b/{bucket}", "query": {"fields": "iamConfiguration"}, "body": {"iamConfiguration": {"uniformBucketLevelAccess": {"enabled": false}, "bucketPolicyOnly": {"enabled": true}, "publicAccessPrevention": "enforced"}}, "compare": {"ignore_body_paths": ["iamConfiguration.uniformBucketLevelAccess.lockedTime", "iamConfiguration.bucketPolicyOnly.lockedTime"]}},
    {"name": "get-after-conflict-modern-false", "method": "GET", "path": "/storage/v1/b/{bucket}", "query": {"fields": "iamConfiguration"}, "compare": {"ignore_body_paths": ["iamConfiguration.uniformBucketLevelAccess.lockedTime", "iamConfiguration.bucketPolicyOnly.lockedTime"]}, "expect_status": 200},
    {"name": "disable-ubla", "method": "PATCH", "path": "/storage/v1/b/{bucket}", "query": {"fields": "iamConfiguration"}, "body": {"iamConfiguration": {"uniformBucketLevelAccess": {"enabled": false}, "publicAccessPrevention": "enforced"}}, "compare": false, "always": true},

    {"name": "lifecycle-matches-pattern", "local_choice": {"reason": "Recorded 2026-11-17: both sides answer 400; Cloud Storage says matchesPattern is not available for the project (reason invalid), gcs-mimic uses its shared unsupported-setting rejection (SPEC-LIFECYCLE-CONFIG).", "mimic_status": 400}, "method": "PATCH", "path": "/storage/v1/b/{bucket}", "query": {"fields": "lifecycle"}, "body": {"lifecycle": {"rule": [{"action": {"type": "Delete"}, "condition": {"matchesPattern": "^tmp/"}}]}}},
    {"name": "lifecycle-clear", "method": "PATCH", "path": "/storage/v1/b/{bucket}", "query": {"fields": "lifecycle"}, "body": {"lifecycle": null}, "compare": false, "always": true},

    {"name": "cleanup-object", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}", "compare": false, "always": true}
  ]
}
