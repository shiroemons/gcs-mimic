{
  "id": "xml-gaps-objects",
  "description": "XML questions the gap ledger left open: a version 2 listing with fetch-owner=true, invalid and percent-encoded bucket segments, reading an object whose JSON custom metadata holds a non-ASCII value or keys that collide after case folding, and whether the XML ETag of a composite or customer-encrypted object equals its JSON etag or the plaintext MD5 (an entity tag is normalized, so equality is measured with If-Match). The keys are fixed test values. Checks SPEC-CROSS-PROTOCOL-EXCLUSIONS, SPEC-XML-PATH-ERROR, SPEC-XML-INPUTS.",
  "steps": [
    {"name": "put-owner-probe", "protocol": "xml", "method": "PUT", "path": "/{bucket}/{object}-o", "headers": {"Content-Type": "text/plain"}, "body_text": "x", "expect_status": 200},
    {"name": "list-v2-fetch-owner-true", "local_choice": {"reason": "Recorded 2026-11-17: Cloud Storage lists an Owner element for each object with fetch-owner=true; gcs-mimic refuses the option with 400 InvalidArgument (SPEC-CROSS-PROTOCOL-EXCLUSIONS).", "mimic_status": 400}, "protocol": "xml", "method": "GET", "path": "/{bucket}", "query": {"list-type": "2", "prefix": "{object}-o", "fetch-owner": "true"}},

    {"name": "get-invalid-bucket-uppercase", "protocol": "xml", "method": "GET", "path": "/Invalid_Bucket/{object}"},
    {"name": "get-invalid-bucket-punctuation", "protocol": "xml", "method": "GET", "path": "/gcsmimic!bad/{object}"},
    {"name": "get-encoded-slash-bucket", "protocol": "xml", "method": "GET", "path": "/gcsmimic%2Fbad/{object}"},

    {"name": "upload-non-ascii-metadata", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "media", "name": "{object}-m1"}, "headers": {"Content-Type": "text/plain"}, "body_text": "m1", "expect_status": 200},
    {"name": "patch-non-ascii-metadata", "method": "PATCH", "path": "/storage/v1/b/{bucket}/o/{object}-m1", "query": {"fields": "metadata"}, "body": {"metadata": {"k": "日本語"}}, "expect_status": 200},
    {"name": "xml-get-non-ascii-metadata", "protocol": "xml", "method": "GET", "path": "/{bucket}/{object}-m1"},
    {"name": "xml-head-non-ascii-metadata", "protocol": "xml", "method": "HEAD", "path": "/{bucket}/{object}-m1"},
    {"name": "upload-case-colliding-metadata", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "media", "name": "{object}-m2"}, "headers": {"Content-Type": "text/plain"}, "body_text": "m2", "expect_status": 200},
    {"name": "patch-case-colliding-metadata", "method": "PATCH", "path": "/storage/v1/b/{bucket}/o/{object}-m2", "query": {"fields": "metadata"}, "body": {"metadata": {"Dup": "1", "dup": "2"}}},
    {"name": "xml-get-case-colliding-metadata", "protocol": "xml", "method": "GET", "path": "/{bucket}/{object}-m2"},

    {"name": "upload-compose-part", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "media", "name": "{object}-p"}, "headers": {"Content-Type": "text/plain"}, "body_text": "hello", "expect_status": 200},
    {"name": "compose", "method": "POST", "path": "/storage/v1/b/{bucket}/o/{object}-cmp/compose", "query": {"fields": "name,etag"}, "body": {"sourceObjects": [{"name": "{object}-p"}, {"name": "{object}-p"}]}, "capture": {"cetag": "body:etag"}, "expect_status": 200},
    {"name": "xml-head-composite", "protocol": "xml", "method": "HEAD", "path": "/{bucket}/{object}-cmp"},
    {"name": "xml-get-composite-if-match-json-etag", "local_choice": {"reason": "Recorded 2026-11-17: on Cloud Storage the XML ETag of a composite object is not its JSON etag (412); gcs-mimic uses the JSON validator and answers 200 (SPEC-XML-INPUTS).", "mimic_status": 200}, "protocol": "xml", "method": "GET", "path": "/{bucket}/{object}-cmp", "headers": {"If-Match": "\"{cetag}\""}},
    {"name": "xml-get-plain-if-match-md5", "protocol": "xml", "method": "GET", "path": "/{bucket}/{object}-p", "headers": {"If-Match": "\"5d41402abc4b2a76b9719d911017c592\""}},

    {"name": "upload-encrypted", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "media", "name": "{object}-enc", "fields": "name,etag"}, "headers": {"Content-Type": "text/plain", "x-goog-encryption-algorithm": "AES256", "x-goog-encryption-key": "AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE=", "x-goog-encryption-key-sha256": "cs1uhCLEB/ttCYaQ8RMLfe1+wvf14dML2dUh8BU2N5M="}, "body_text": "hello", "capture": {"eetag": "body:etag"}, "expect_status": 200},
    {"name": "xml-head-encrypted-without-key", "protocol": "xml", "method": "HEAD", "path": "/{bucket}/{object}-enc"},
    {"name": "xml-get-encrypted-if-match-md5", "local_choice": {"reason": "Recorded 2026-11-17: both sides answer 412; Cloud Storage's XML error for a customer-encrypted object carries no-cache headers and Details naming the If-Match value, which gcs-mimic omits (SPEC-XML-INPUTS).", "mimic_status": 412}, "protocol": "xml", "method": "GET", "path": "/{bucket}/{object}-enc", "headers": {"x-goog-encryption-algorithm": "AES256", "x-goog-encryption-key": "AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE=", "x-goog-encryption-key-sha256": "cs1uhCLEB/ttCYaQ8RMLfe1+wvf14dML2dUh8BU2N5M=", "If-Match": "\"5d41402abc4b2a76b9719d911017c592\""}},
    {"name": "xml-get-encrypted-if-match-json-etag", "local_choice": {"reason": "Recorded 2026-11-17: on Cloud Storage the XML ETag of a customer-encrypted object is neither its JSON etag nor the plaintext MD5 (412); gcs-mimic uses the JSON validator and answers 200 (SPEC-XML-INPUTS).", "mimic_status": 200}, "protocol": "xml", "method": "GET", "path": "/{bucket}/{object}-enc", "headers": {"x-goog-encryption-algorithm": "AES256", "x-goog-encryption-key": "AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE=", "x-goog-encryption-key-sha256": "cs1uhCLEB/ttCYaQ8RMLfe1+wvf14dML2dUh8BU2N5M=", "If-Match": "\"{eetag}\""}},

    {"name": "cleanup-o", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-o", "compare": false, "always": true},
    {"name": "cleanup-m1", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-m1", "compare": false, "always": true},
    {"name": "cleanup-m2", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-m2", "compare": false, "always": true},
    {"name": "cleanup-p", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-p", "compare": false, "always": true},
    {"name": "cleanup-cmp", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-cmp", "compare": false, "always": true},
    {"name": "cleanup-enc", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-enc", "compare": false, "always": true}
  ]
}
