{
  "id": "json-content-length-zero-digits",
  "description": "JSON methods without a request body sent with Content-Length: 00, a valid spelling of zero: a bucket read, an object read and an object delete. The 2026-11-15 live recording shows that Cloud Storage accepts the header on all three.",
  "steps": [
    {"name": "upload", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "media", "name": "{object}"}, "headers": {"Content-Type": "text/plain"}, "body_text": "hello", "expect_status": 200},
    {"name": "get-bucket", "method": "GET", "path": "/storage/v1/b/{bucket}", "query": {"fields": "name"}, "headers": {"Content-Length": "00"}, "expect_status": 200},
    {"name": "get-object", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"fields": "name"}, "headers": {"Content-Length": "00"}, "expect_status": 200},
    {"name": "delete-object", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}", "headers": {"Content-Length": "00"}, "expect_status": 204}
  ]
}
