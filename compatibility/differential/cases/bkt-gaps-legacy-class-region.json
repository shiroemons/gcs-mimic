{
  "id": "bkt-gaps-legacy-class-region",
  "description": "The legacy REGIONAL and MULTI_REGIONAL storage classes in a regional (us-central1) bucket: as the bucket's default class through JSON PATCH and Storage v2 UpdateBucket, on objects through a JSON multipart insert, an XML PUT, Storage v2 WriteObject, a JSON and a Storage v2 rewrite and a compose that inherits the default, and in lifecycle SetStorageClass actions and matchesStorageClass conditions. Checks SPEC-SDK-UNSUPPORTED for the REGIONAL class.",
  "bucket": "own",
  "steps": [
    {"name": "patch-class-multi-regional", "method": "PATCH", "path": "/storage/v1/b/{bucket}", "query": {"fields": "storageClass"}, "body": {"storageClass": "MULTI_REGIONAL"}},
    {"name": "patch-class-dra", "method": "PATCH", "path": "/storage/v1/b/{bucket}", "query": {"fields": "storageClass"}, "body": {"storageClass": "DURABLE_REDUCED_AVAILABILITY"}},
    {"name": "patch-class-regional", "method": "PATCH", "path": "/storage/v1/b/{bucket}", "query": {"fields": "storageClass"}, "body": {"storageClass": "REGIONAL"}},
    {"name": "get-bucket-class", "method": "GET", "path": "/storage/v1/b/{bucket}", "query": {"fields": "storageClass,location,locationType"}},
    {"name": "upload-default-class", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "multipart", "fields": "name,storageClass"}, "headers": {"Content-Type": "multipart/related; boundary=gcsmimicdiff"}, "body_text": "--gcsmimicdiff\r\nContent-Type: application/json; charset=UTF-8\r\n\r\n{{\"name\":\"{object}-d\"}}\r\n--gcsmimicdiff\r\nContent-Type: text/plain\r\n\r\nx\r\n--gcsmimicdiff--"},
    {"name": "upload-class-multi-regional", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "multipart", "fields": "name,storageClass"}, "headers": {"Content-Type": "multipart/related; boundary=gcsmimicdiff"}, "body_text": "--gcsmimicdiff\r\nContent-Type: application/json; charset=UTF-8\r\n\r\n{{\"name\":\"{object}-m\",\"storageClass\":\"MULTI_REGIONAL\"}}\r\n--gcsmimicdiff\r\nContent-Type: text/plain\r\n\r\nx\r\n--gcsmimicdiff--"},
    {"name": "upload-class-standard", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "multipart", "fields": "name,storageClass"}, "headers": {"Content-Type": "multipart/related; boundary=gcsmimicdiff"}, "body_text": "--gcsmimicdiff\r\nContent-Type: application/json; charset=UTF-8\r\n\r\n{{\"name\":\"{object}-s\",\"storageClass\":\"STANDARD\"}}\r\n--gcsmimicdiff\r\nContent-Type: text/plain\r\n\r\nx\r\n--gcsmimicdiff--"},
    {"name": "xml-put-class-regional", "protocol": "xml", "method": "PUT", "path": "/{bucket}/{object}-x", "headers": {"Content-Type": "text/plain", "x-goog-storage-class": "REGIONAL"}, "body_text": "x"},
    {"name": "xml-put-class-multi-regional", "protocol": "xml", "method": "PUT", "path": "/{bucket}/{object}-xm", "headers": {"Content-Type": "text/plain", "x-goog-storage-class": "MULTI_REGIONAL"}, "body_text": "x"},
    {"name": "xml-head-class-regional", "protocol": "xml", "method": "HEAD", "path": "/{bucket}/{object}-x"},
    {"name": "rewrite-to-regional", "method": "POST", "path": "/storage/v1/b/{bucket}/o/{object}-s/rewriteTo/b/{bucket}/o/{object}-r", "query": {"fields": "done,resource(name,storageClass)"}, "body": {"storageClass": "REGIONAL"}},
    {"name": "rewrite-to-multi-regional", "method": "POST", "path": "/storage/v1/b/{bucket}/o/{object}-s/rewriteTo/b/{bucket}/o/{object}-rm", "query": {"fields": "done,resource(name,storageClass)"}, "body": {"storageClass": "MULTI_REGIONAL"}},
    {"name": "rewrite-regional-to-standard", "method": "POST", "path": "/storage/v1/b/{bucket}/o/{object}-d/rewriteTo/b/{bucket}/o/{object}-rs", "query": {"fields": "done,resource(name,storageClass)"}, "body": {"storageClass": "STANDARD"}},
    {"name": "compose-default-class", "method": "POST", "path": "/storage/v1/b/{bucket}/o/{object}-c/compose", "query": {"fields": "name,storageClass"}, "body": {"sourceObjects": [{"name": "{object}-s"}, {"name": "{object}-d"}]}},
    {"name": "lifecycle-set-class-multi-regional", "method": "PATCH", "path": "/storage/v1/b/{bucket}", "query": {"fields": "lifecycle"}, "body": {"lifecycle": {"rule": [{"action": {"type": "SetStorageClass", "storageClass": "MULTI_REGIONAL"}, "condition": {"matchesStorageClass": ["DURABLE_REDUCED_AVAILABILITY"]}}]}}},
    {"name": "lifecycle-set-class-regional-from-dra", "method": "PATCH", "path": "/storage/v1/b/{bucket}", "query": {"fields": "lifecycle"}, "body": {"lifecycle": {"rule": [{"action": {"type": "SetStorageClass", "storageClass": "REGIONAL"}, "condition": {"matchesStorageClass": ["DURABLE_REDUCED_AVAILABILITY"]}}]}}},
    {"name": "lifecycle-match-regional", "method": "PATCH", "path": "/storage/v1/b/{bucket}", "query": {"fields": "lifecycle"}, "body": {"lifecycle": {"rule": [{"action": {"type": "SetStorageClass", "storageClass": "NEARLINE"}, "condition": {"matchesStorageClass": ["REGIONAL"], "age": 3650}}]}}},
    {"name": "lifecycle-match-multi-regional", "method": "PATCH", "path": "/storage/v1/b/{bucket}", "query": {"fields": "lifecycle"}, "body": {"lifecycle": {"rule": [{"action": {"type": "Delete"}, "condition": {"matchesStorageClass": ["MULTI_REGIONAL"], "age": 3650}}]}}},
    {"name": "grpc-write-class-regional", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-g", "contentType": "text/plain", "storageClass": "REGIONAL"}, "objectSize": "1"}, "checksummedData": {"content": "eA=="}, "finishWrite": true}], "compare": {"ignore_body_paths": ["$.resource.contentType"]}},
    {"name": "grpc-write-class-multi-regional", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-gm", "contentType": "text/plain", "storageClass": "MULTI_REGIONAL"}, "objectSize": "1"}, "checksummedData": {"content": "eA=="}, "finishWrite": true}], "compare": {"ignore_body_paths": ["$.resource.contentType"]}},
    {"name": "grpc-get-object-class", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": "projects/_/buckets/{bucket}", "object": "{object}-d", "readMask": {"paths": ["name", "storage_class"]}}},
    {"name": "grpc-get-bucket-class", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"name": "projects/_/buckets/{bucket}", "readMask": {"paths": ["name", "storage_class"]}}},
    {"name": "grpc-update-bucket-class-multi-regional", "protocol": "grpc", "rpc": "google.storage.v2.Storage/UpdateBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": {"name": "projects/_/buckets/{bucket}", "storageClass": "MULTI_REGIONAL"}, "updateMask": {"paths": ["storage_class"]}}},
    {"name": "grpc-update-bucket-class-regional", "protocol": "grpc", "rpc": "google.storage.v2.Storage/UpdateBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": {"name": "projects/_/buckets/{bucket}", "storageClass": "REGIONAL"}, "updateMask": {"paths": ["storage_class"]}}, "compare": {"ignore_body_paths": ["$.acl", "$.defaultObjectAcl", "$.createTime", "$.updateTime", "$.softDeletePolicy"]}},
    {"name": "grpc-get-bucket-class-after-update", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"name": "projects/_/buckets/{bucket}", "readMask": {"paths": ["name", "storage_class"]}}},
    {"name": "grpc-rewrite-class-regional", "protocol": "grpc", "rpc": "google.storage.v2.Storage/RewriteObject", "headers": {"x-goog-request-params": "source_bucket=projects%2F_%2Fbuckets%2F{bucket}&bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"destinationName": "{object}-gr", "destinationBucket": "projects/_/buckets/{bucket}", "destination": {"storageClass": "REGIONAL"}, "sourceBucket": "projects/_/buckets/{bucket}", "sourceObject": "{object}-s"}, "compare": {"ignore_body_paths": ["$.resource.contentType"]}},
    {"name": "grpc-rewrite-class-multi-regional", "protocol": "grpc", "rpc": "google.storage.v2.Storage/RewriteObject", "headers": {"x-goog-request-params": "source_bucket=projects%2F_%2Fbuckets%2F{bucket}&bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"destinationName": "{object}-grm", "destinationBucket": "projects/_/buckets/{bucket}", "destination": {"storageClass": "MULTI_REGIONAL"}, "sourceBucket": "projects/_/buckets/{bucket}", "sourceObject": "{object}-s"}, "compare": {"ignore_body_paths": ["$.resource.contentType"]}},
    {"name": "cleanup-d", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-d", "compare": false, "always": true},
    {"name": "cleanup-m", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-m", "compare": false, "always": true},
    {"name": "cleanup-s", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-s", "compare": false, "always": true},
    {"name": "cleanup-x", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-x", "compare": false, "always": true},
    {"name": "cleanup-xm", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-xm", "compare": false, "always": true},
    {"name": "cleanup-r", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-r", "compare": false, "always": true},
    {"name": "cleanup-rm", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-rm", "compare": false, "always": true},
    {"name": "cleanup-rs", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-rs", "compare": false, "always": true},
    {"name": "cleanup-c", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-c", "compare": false, "always": true},
    {"name": "cleanup-g", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-g", "compare": false, "always": true},
    {"name": "cleanup-gm", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-gm", "compare": false, "always": true},
    {"name": "cleanup-gr", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-gr", "compare": false, "always": true},
    {"name": "cleanup-grm", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-grm", "compare": false, "always": true},
    {"name": "cleanup-settings", "method": "PATCH", "path": "/storage/v1/b/{bucket}", "query": {"fields": "name"}, "body": {"lifecycle": null, "storageClass": "STANDARD"}, "compare": false, "always": true}
  ]
}
