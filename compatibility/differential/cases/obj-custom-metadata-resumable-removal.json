{
  "id": "obj-custom-metadata-resumable-removal",
  "description": "A resumable upload whose start sends 8189 bytes of custom metadata beside a key whose value is null. The 2026-11-15 live recording shows that Cloud Storage accepts the start and the completion and stores the null value as an empty string instead of removing the key.",
  "steps": [
    {"name": "start", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "name": "{object}"}, "headers": {"Content-Type": "application/json", "X-Upload-Content-Type": "text/plain", "X-Upload-Content-Length": "5"}, "body": {"metadata": {"k": "", "gone": null}}, "capture": {"up": "header:location?upload_id"}, "expect_status": 200},
    {"name": "complete", "method": "PUT", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "upload_id": "{up}", "fields": "name"}, "headers": {"Content-Range": "bytes 0-4/5"}, "body_text": "hello", "expect_status": 200}
  ]
}
