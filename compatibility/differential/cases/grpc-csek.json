{
  "id": "grpc-csek",
  "description": "Storage v2 customer-supplied encryption keys: raw-key validation order and wording, GetObject/UpdateObject/ListObjects hiding checksums without the key, ReadObject requiring it, RewriteObject source and destination keys (rotation), ComposeObject's shared key, keys on later write and resumable messages, QueryWriteStatus and DeleteObject ignoring a key. The keys are fixed test values (32 bytes of 0x01 and of 0x02). Cloud Storage answers a key introduced after a keyless write started with INTERNAL and publishes nothing; gcs-mimic answers INVALID_ARGUMENT and publishes nothing. BidiReadObject is not available to the recording project and is left out. Comparisons ignore fields outside customer-supplied keys that differ for other reasons: the default contentType of a write without one, and QueryWriteStatus's acl, owner and open-session persistedDataChecksums.",
  "steps": [
    {"name": "write-plain", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-plain"}, "objectSize": "5"}, "checksummedData": {"content": "aGVsbG8="}, "finishWrite": true}], "compare": {"ignore_body_paths": ["$.contentType", "$.resource.contentType", "$.metadata.contentType", "$.objects[*].contentType"]}, "expect_status": 0},
    {"name": "write-plain2", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-plain2"}, "objectSize": "5"}, "checksummedData": {"content": "aGVsbG8="}, "finishWrite": true}], "compare": {"ignore_body_paths": ["$.contentType", "$.resource.contentType", "$.metadata.contentType", "$.objects[*].contentType"]}, "expect_status": 0},
    {"name": "write-enc", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-enc"}, "objectSize": "5"}, "checksummedData": {"content": "aGVsbG8="}, "finishWrite": true, "commonObjectRequestParams": {"encryptionAlgorithm": "AES256", "encryptionKeyBytes": "AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE=", "encryptionKeySha256Bytes": "cs1uhCLEB/ttCYaQ8RMLfe1+wvf14dML2dUh8BU2N5M="}}], "compare": {"ignore_body_paths": ["$.contentType", "$.resource.contentType", "$.metadata.contentType", "$.objects[*].contentType"]}, "expect_status": 0},
    {"name": "write-enc2", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-enc2"}, "objectSize": "5"}, "checksummedData": {"content": "aGVsbG8="}, "finishWrite": true, "commonObjectRequestParams": {"encryptionAlgorithm": "AES256", "encryptionKeyBytes": "AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE=", "encryptionKeySha256Bytes": "cs1uhCLEB/ttCYaQ8RMLfe1+wvf14dML2dUh8BU2N5M="}}], "compare": {"ignore_body_paths": ["$.contentType", "$.resource.contentType", "$.metadata.contentType", "$.objects[*].contentType"]}, "expect_status": 0},
