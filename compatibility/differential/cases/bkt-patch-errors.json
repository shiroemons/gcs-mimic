{
  "id": "bkt-patch-errors",
  "description": "Bucket PATCH and PUT inputs that must be rejected, and the same operations on a missing bucket. The case has a bucket of its own, because a PUT that succeeds replaces omitted fields with defaults.",
  "bucket": "own",
  "steps": [
    {"name": "patch-invalid-storage-class", "method": "PATCH", "path": "/storage/v1/b/{bucket}", "body": {"storageClass": "SUPERFAST"}, "expect_status": 400},
    {"name": "patch-labels-wrong-type", "method": "PATCH", "path": "/storage/v1/b/{bucket}", "body": {"labels": "x"}, "expect_status": 400},
    {"name": "patch-negative-retention", "method": "PATCH", "path": "/storage/v1/b/{bucket}", "body": {"retentionPolicy": {"retentionPeriod": "-5"}}, "expect_status": 400},
    {"name": "patch-soft-delete-below-minimum", "method": "PATCH", "path": "/storage/v1/b/{bucket}", "body": {"softDeletePolicy": {"retentionDurationSeconds": "100"}}, "expect_status": 400},
    {"name": "patch-invalid-pap", "method": "PATCH", "path": "/storage/v1/b/{bucket}", "body": {"iamConfiguration": {"publicAccessPrevention": "bogus"}}, "expect_status": 400},
    {"name": "patch-lifecycle-as-array", "method": "PATCH", "path": "/storage/v1/b/{bucket}", "body": {"lifecycle": []}, "expect_status": 400},
    {"name": "patch-malformed-json", "method": "PATCH", "path": "/storage/v1/b/{bucket}", "headers": {"Content-Type": "application/json"}, "body_text": "{{\"labels\": ", "expect_status": 400},
    {"name": "patch-invalid-projection", "method": "PATCH", "path": "/storage/v1/b/{bucket}", "query": {"projection": "everything"}, "body": {}, "expect_status": 400},
    {"name": "patch-undeclared-query-parameter", "method": "PATCH", "path": "/storage/v1/b/{bucket}", "query": {"append": "false"}, "body": {}, "expect_status": 400},
    {"name": "put-precondition-mismatch", "pap_reset": "measures how a bucket write without public access prevention behaves; the bucket is private and deleted right after the case", "method": "PUT", "path": "/storage/v1/b/{bucket}", "query": {"ifMetagenerationMatch": "999"}, "body": {"name": "{bucket}"}, "expect_status": 412},
    {"name": "put-name-mismatch", "pap_reset": "measures how a bucket write without public access prevention behaves; the bucket is private and deleted right after the case", "method": "PUT", "path": "/storage/v1/b/{bucket}", "body": {"name": "{missing_bucket}"}},
    {"name": "patch-missing-bucket", "method": "PATCH", "path": "/storage/v1/b/{missing_bucket}", "body": {"labels": {"a": "b"}}, "expect_status": 404},
    {"name": "put-missing-bucket", "pap_reset": "measures how a bucket write without public access prevention behaves; the bucket is private and deleted right after the case", "method": "PUT", "path": "/storage/v1/b/{missing_bucket}", "body": {"name": "{missing_bucket}"}, "expect_status": 404},
    {"name": "get-iam-missing-bucket", "method": "GET", "path": "/storage/v1/b/{missing_bucket}/iam", "expect_status": 404},
    {"name": "test-iam-missing-bucket", "method": "GET", "path": "/storage/v1/b/{missing_bucket}/iam/testPermissions", "query": {"permissions": "storage.buckets.get"}, "expect_status": 404},
    {"name": "list-acl-missing-bucket", "method": "GET", "path": "/storage/v1/b/{missing_bucket}/acl", "expect_status": 404},
    {"name": "list-default-acl-missing-bucket", "method": "GET", "path": "/storage/v1/b/{missing_bucket}/defaultObjectAcl", "expect_status": 404},
    {"name": "list-notifications-missing-bucket", "method": "GET", "path": "/storage/v1/b/{missing_bucket}/notificationConfigs", "expect_status": 404}
  ]
}
