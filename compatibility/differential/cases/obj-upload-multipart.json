{
  "id": "obj-upload-multipart",
  "description": "Multipart upload: metadata fields, content type precedence, missing media part type, missing name, missing boundary, one part only and invalid metadata JSON. Checks SPEC-016 and SPEC-011.",
  "steps": [
    {"name": "basic", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "multipart"}, "headers": {"Content-Type": "multipart/related; boundary=gcsmimicdiff"}, "body_text": "--gcsmimicdiff\r\nContent-Type: application/json; charset=UTF-8\r\n\r\n{{\"name\":\"{object}-basic\",\"contentType\":\"text/plain\",\"cacheControl\":\"no-cache\",\"contentLanguage\":\"en\",\"metadata\":{{\"k\":\"v\"}}}}\r\n--gcsmimicdiff\r\nContent-Type: text/plain\r\n\r\nhello\r\n--gcsmimicdiff--", "expect_status": 200},
    {"name": "metadata-type-wins", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "multipart"}, "headers": {"Content-Type": "multipart/related; boundary=gcsmimicdiff"}, "body_text": "--gcsmimicdiff\r\nContent-Type: application/json; charset=UTF-8\r\n\r\n{{\"name\":\"{object}-prec\",\"contentType\":\"application/json\"}}\r\n--gcsmimicdiff\r\nContent-Type: text/plain\r\n\r\nhello\r\n--gcsmimicdiff--", "expect_status": 200},
    {"name": "media-type-used", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "multipart"}, "headers": {"Content-Type": "multipart/related; boundary=gcsmimicdiff"}, "body_text": "--gcsmimicdiff\r\nContent-Type: application/json; charset=UTF-8\r\n\r\n{{\"name\":\"{object}-mtype\"}}\r\n--gcsmimicdiff\r\nContent-Type: text/plain\r\n\r\nhello\r\n--gcsmimicdiff--", "expect_status": 200},
    {"name": "media-part-without-type", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "multipart"}, "headers": {"Content-Type": "multipart/related; boundary=gcsmimicdiff"}, "body_text": "--gcsmimicdiff\r\nContent-Type: application/json; charset=UTF-8\r\n\r\n{{\"name\":\"{object}-notype\"}}\r\n--gcsmimicdiff\r\n\r\nhello\r\n--gcsmimicdiff--", "expect_status": 200},
    {"name": "name-from-query", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "multipart", "name": "{object}-qname"}, "headers": {"Content-Type": "multipart/related; boundary=gcsmimicdiff"}, "body_text": "--gcsmimicdiff\r\nContent-Type: application/json; charset=UTF-8\r\n\r\n{{}}\r\n--gcsmimicdiff\r\nContent-Type: text/plain\r\n\r\nhello\r\n--gcsmimicdiff--", "expect_status": 200},
    {"name": "no-name", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "multipart"}, "headers": {"Content-Type": "multipart/related; boundary=gcsmimicdiff"}, "body_text": "--gcsmimicdiff\r\nContent-Type: application/json; charset=UTF-8\r\n\r\n{{}}\r\n--gcsmimicdiff\r\nContent-Type: text/plain\r\n\r\nhello\r\n--gcsmimicdiff--", "expect_status": 400},
    {"name": "missing-boundary", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "multipart"}, "headers": {"Content-Type": "multipart/related"}, "body_text": "--gcsmimicdiff\r\nContent-Type: application/json\r\n\r\n{{\"name\":\"{object}-nob\"}}\r\n--gcsmimicdiff--", "expect_status": 400},
    {"name": "one-part-only", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "multipart"}, "headers": {"Content-Type": "multipart/related; boundary=gcsmimicdiff"}, "body_text": "--gcsmimicdiff\r\nContent-Type: application/json; charset=UTF-8\r\n\r\n{{\"name\":\"{object}-one\"}}\r\n--gcsmimicdiff--", "expect_status": 400},
    {"name": "invalid-metadata-json", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "multipart"}, "headers": {"Content-Type": "multipart/related; boundary=gcsmimicdiff"}, "body_text": "--gcsmimicdiff\r\nContent-Type: application/json; charset=UTF-8\r\n\r\n{{not json\r\n--gcsmimicdiff\r\nContent-Type: text/plain\r\n\r\nhello\r\n--gcsmimicdiff--", "expect_status": 400},
    {"name": "not-multipart-type", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "multipart", "name": "{object}-plain"}, "headers": {"Content-Type": "text/plain"}, "body_text": "hello", "expect_status": 400},
    {"name": "if-generation-match-zero", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "multipart", "ifGenerationMatch": "0"}, "headers": {"Content-Type": "multipart/related; boundary=gcsmimicdiff"}, "body_text": "--gcsmimicdiff\r\nContent-Type: application/json; charset=UTF-8\r\n\r\n{{\"name\":\"{object}-basic\"}}\r\n--gcsmimicdiff\r\nContent-Type: text/plain\r\n\r\nhello\r\n--gcsmimicdiff--", "expect_status": 412},
    {"name": "get-basic", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}-basic", "expect_status": 200},
    {"name": "get-precedence", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}-prec", "query": {"fields": "name,contentType"}, "expect_status": 200},
    {"name": "get-media-type", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}-mtype", "query": {"fields": "name,contentType"}, "expect_status": 200},
    {"name": "get-no-type", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}-notype", "query": {"fields": "name,contentType"}, "expect_status": 200},
    {"name": "cleanup-basic", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-basic", "compare": false},
    {"name": "cleanup-prec", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-prec", "compare": false},
    {"name": "cleanup-mtype", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-mtype", "compare": false},
    {"name": "cleanup-notype", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-notype", "compare": false},
    {"name": "cleanup-qname", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-qname", "compare": false}
  ]
}
