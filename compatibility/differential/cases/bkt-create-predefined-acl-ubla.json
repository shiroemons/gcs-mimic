{
  "id": "bkt-create-predefined-acl-ubla",
  "description": "Bucket creation with predefinedAcl together with uniform bucket-level access, which must be rejected. The bucket is deleted afterwards in case a side accepts it.",
  "bucket": false,
  "steps": [
    {"name":"predefined-acl-with-ubla","method":"POST","path":"/storage/v1/b","query":{"project":"{project}","predefinedAcl":"private"},"body":{"name":"{new_bucket}","iamConfiguration":{"uniformBucketLevelAccess":{"enabled":true},"publicAccessPrevention":"enforced"},"softDeletePolicy":{"retentionDurationSeconds":"0"}},"expect_status":400},
    {"name":"cleanup","method":"DELETE","path":"/storage/v1/b/{new_bucket}","compare":false,"always":true}
  ]
}
