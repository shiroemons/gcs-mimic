{
  "id": "grpc-probe-derived-writes",
  "description": "Storage v2 ComposeObject and RewriteObject destination fields that gcs-mimic refuses as UNIMPLEMENTED, and when a rewrite drops the source's content type, on the shared bucket with a 5-byte text/plain source. ComposeObject: a destination storage_class equal to the source's and a different one (NEARLINE), a destination acl naming the project owners, and output-only destination fields (generation, metageneration, size, create_time, update_time). RewriteObject: no destination, followed by Storage v2 GetObject and JSON objects.get of the result, to tell whether the dropped content type recorded on 2026-11-17 is stored or only left out of the response; a destination with only a content type and with only custom metadata; a destination acl; and output-only destination fields. A destination retention needs a bucket with object retention and is not asked. Asks RPC-STORAGE-010 grpc_compose_destination_storage_class and grpc_compose_destination_fields, and RPC-STORAGE-021 rewrite_destination_fields and rewrite_content_type (SPEC-SDK-UNSUPPORTED).",
  "steps": [
    {"name": "write-source", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}", "contentType": "text/plain"}, "objectSize": "5"}, "checksummedData": {"content": "aGVsbG8="}, "finishWrite": true}], "compare": false, "expect_status": 0},
    {"name": "get-source-acl", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": "projects/_/buckets/{bucket}", "object": "{object}", "readMask": {"paths": ["acl"]}}, "capture": {"pn": "body:acl.0.projectTeam.projectNumber"}, "compare": false, "expect_status": 0},
    {"name": "compose-destination-class-same", "protocol": "grpc", "rpc": "google.storage.v2.Storage/ComposeObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"destination": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-class-same", "storageClass": "STANDARD"}, "sourceObjects": [{"name": "{object}"}]}},
    {"name": "compose-destination-class-other", "protocol": "grpc", "rpc": "google.storage.v2.Storage/ComposeObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"destination": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-class-other", "storageClass": "NEARLINE"}, "sourceObjects": [{"name": "{object}"}]}},
    {"name": "compose-destination-acl", "protocol": "grpc", "rpc": "google.storage.v2.Storage/ComposeObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"destination": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-acl", "acl": [{"entity": "project-owners-{pn}", "role": "OWNER"}]}, "sourceObjects": [{"name": "{object}"}]}, "local_choice": {"reason": "A destination acl on ComposeObject is not implemented: publication gives a new generation the default object ACL or a canned one, so gcs-mimic rejects listed entries where Cloud Storage applies them and adds the creator as owner (SPEC-GRPC-LOCAL-CHOICES).", "mimic_status": 12}},
    {"name": "compose-destination-output-only", "protocol": "grpc", "rpc": "google.storage.v2.Storage/ComposeObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"destination": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-output", "generation": "1", "metageneration": "7", "size": "99", "createTime": "2020-01-01T00:00:00Z", "updateTime": "2020-01-01T00:00:00Z"}, "sourceObjects": [{"name": "{object}"}]}},
    {"name": "rewrite-without-destination", "protocol": "grpc", "rpc": "google.storage.v2.Storage/RewriteObject", "headers": {"x-goog-request-params": "source_bucket=projects%2F_%2Fbuckets%2F{bucket}&bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"destinationName": "{object}-rw", "destinationBucket": "projects/_/buckets/{bucket}", "sourceBucket": "projects/_/buckets/{bucket}", "sourceObject": "{object}"}},
    {"name": "get-rewritten", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": "projects/_/buckets/{bucket}", "object": "{object}-rw", "readMask": {"paths": ["name", "content_type"]}}},
    {"name": "json-get-rewritten", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}-rw", "query": {"fields": "name,contentType"}},
    {"name": "rewrite-destination-content-type", "protocol": "grpc", "rpc": "google.storage.v2.Storage/RewriteObject", "headers": {"x-goog-request-params": "source_bucket=projects%2F_%2Fbuckets%2F{bucket}&bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"destinationName": "{object}-rw-type", "destinationBucket": "projects/_/buckets/{bucket}", "destination": {"contentType": "text/x-destination"}, "sourceBucket": "projects/_/buckets/{bucket}", "sourceObject": "{object}"}},
    {"name": "rewrite-destination-metadata-only", "protocol": "grpc", "rpc": "google.storage.v2.Storage/RewriteObject", "headers": {"x-goog-request-params": "source_bucket=projects%2F_%2Fbuckets%2F{bucket}&bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"destinationName": "{object}-rw-meta", "destinationBucket": "projects/_/buckets/{bucket}", "destination": {"metadata": {"k": "v"}}, "sourceBucket": "projects/_/buckets/{bucket}", "sourceObject": "{object}"}},
    {"name": "rewrite-destination-acl", "protocol": "grpc", "rpc": "google.storage.v2.Storage/RewriteObject", "headers": {"x-goog-request-params": "source_bucket=projects%2F_%2Fbuckets%2F{bucket}&bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"destinationName": "{object}-rw-acl", "destinationBucket": "projects/_/buckets/{bucket}", "destination": {"acl": [{"entity": "project-owners-{pn}", "role": "OWNER"}]}, "sourceBucket": "projects/_/buckets/{bucket}", "sourceObject": "{object}"}, "local_choice": {"reason": "A destination acl on RewriteObject is not implemented: publication gives a new generation the default object ACL or a canned one and a rewrite session stores no entries, so gcs-mimic rejects listed entries where Cloud Storage applies them and adds the creator as owner (SPEC-GRPC-LOCAL-CHOICES).", "mimic_status": 12}},
    {"name": "rewrite-destination-output-only", "protocol": "grpc", "rpc": "google.storage.v2.Storage/RewriteObject", "headers": {"x-goog-request-params": "source_bucket=projects%2F_%2Fbuckets%2F{bucket}&bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"destinationName": "{object}-rw-output", "destinationBucket": "projects/_/buckets/{bucket}", "destination": {"generation": "1", "metageneration": "7", "size": "99", "createTime": "2020-01-01T00:00:00Z", "updateTime": "2020-01-01T00:00:00Z"}, "sourceBucket": "projects/_/buckets/{bucket}", "sourceObject": "{object}"}}
  ]
}
