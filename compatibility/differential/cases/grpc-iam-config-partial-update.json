{
  "id": "grpc-iam-config-partial-update",
  "description": "gRPC UpdateBucket with update_mask iam_config and an iam_config that sets only one of its two settings, as the Go client sends it: uniform access alone on a bucket with public access prevention enforced, then public access prevention alone on a bucket with uniform access enabled. Records whether the unset sibling is kept or reset. Both settings are restored at the end. Checks SPEC-GRPC-EMPTY-IAM-UPDATE.",
  "bucket": "own",
  "steps": [
    {"name": "get-before", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"name": "projects/_/buckets/{bucket}", "readMask": {"paths": ["metageneration", "iam_config"]}}, "expect_status": 0},
    {"name": "update-uniform-only", "protocol": "grpc", "rpc": "google.storage.v2.Storage/UpdateBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": {"name": "projects/_/buckets/{bucket}", "iamConfig": {"uniformBucketLevelAccess": {"enabled": true}}}, "updateMask": {"paths": ["iam_config"]}}, "compare": {"ignore_body_paths": ["updateTime", "etag", "createTime", "bucketId", "project", "location", "locationType", "rpo", "storageClass", "softDeletePolicy", "versioning", "autoclass", "hierarchicalNamespace", "satisfiesPzs", "lifecycle", "objectRetention", "ipFilter", "owner", "acl", "defaultObjectAcl", "labels", "billing", "website", "encryption", "logging", "retentionPolicy", "customPlacementConfig", "cors", "iamConfig.uniformBucketLevelAccess.lockTime"]}},
    {"name": "get-after-uniform", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"name": "projects/_/buckets/{bucket}", "readMask": {"paths": ["metageneration", "iam_config"]}}, "compare": {"ignore_body_paths": ["iamConfig.uniformBucketLevelAccess.lockTime"]}},
    {"name": "update-pap-only", "protocol": "grpc", "rpc": "google.storage.v2.Storage/UpdateBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": {"name": "projects/_/buckets/{bucket}", "iamConfig": {"publicAccessPrevention": "enforced"}}, "updateMask": {"paths": ["iam_config"]}}, "compare": {"ignore_body_paths": ["updateTime", "etag", "createTime", "bucketId", "project", "location", "locationType", "rpo", "storageClass", "softDeletePolicy", "versioning", "autoclass", "hierarchicalNamespace", "satisfiesPzs", "lifecycle", "objectRetention", "ipFilter", "owner", "acl", "defaultObjectAcl", "labels", "billing", "website", "encryption", "logging", "retentionPolicy", "customPlacementConfig", "cors", "iamConfig.uniformBucketLevelAccess.lockTime"]}},
    {"name": "get-after-pap", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"name": "projects/_/buckets/{bucket}", "readMask": {"paths": ["metageneration", "iam_config"]}}, "compare": {"ignore_body_paths": ["iamConfig.uniformBucketLevelAccess.lockTime"]}},
    {"name": "restore", "method": "PATCH", "path": "/storage/v1/b/{bucket}", "query": {"fields": "iamConfiguration"}, "body": {"iamConfiguration": {"publicAccessPrevention": "enforced", "uniformBucketLevelAccess": {"enabled": false}}}, "compare": false, "always": true}
  ]
}
