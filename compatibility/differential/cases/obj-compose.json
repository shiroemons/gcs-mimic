{
  "id": "obj-compose",
  "description": "Compose: destination metadata, absent destination, empty and missing sources, source generation and object preconditions, a composite as source, componentCount and deleteSourceObjects. Checks SPEC-COMPOSE-EDGES.",
  "steps": [
    {"name": "upload-a", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "media", "name": "{object}-a"}, "headers": {"Content-Type": "text/plain"}, "body_text": "aa", "capture": {"ga": "body:generation"}, "compare": false, "expect_status": 200},
    {"name": "upload-b", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "media", "name": "{object}-b"}, "headers": {"Content-Type": "text/plain"}, "body_text": "bb", "compare": false, "expect_status": 200},
    {"name": "compose", "method": "POST", "path": "/storage/v1/b/{bucket}/o/{object2}/compose", "body": {"sourceObjects": [{"name": "{object}-a"}, {"name": "{object}-b"}], "destination": {"contentType": "text/plain", "metadata": {"k": "v"}}}, "expect_status": 200},
    {"name": "download-composed", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object2}", "query": {"alt": "media"}, "expect_status": 200},
    {"name": "get-composed-fields", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object2}", "query": {"fields": "name,size,componentCount,crc32c,md5Hash,contentType,metadata"}, "expect_status": 200},
    {"name": "compose-without-destination", "method": "POST", "path": "/storage/v1/b/{bucket}/o/{object}-nodest/compose", "body": {"sourceObjects": [{"name": "{object}-a"}, {"name": "{object}-b"}]}, "expect_status": 200},
    {"name": "get-nodest-fields", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}-nodest", "query": {"fields": "name,contentType,size"}, "expect_status": 200},
    {"name": "compose-empty-sources", "method": "POST", "path": "/storage/v1/b/{bucket}/o/{object}-empty/compose", "body": {"sourceObjects": []}, "expect_status": 400},
    {"name": "compose-no-body-field", "method": "POST", "path": "/storage/v1/b/{bucket}/o/{object}-nobody/compose", "body": {}, "expect_status": 400},
    {"name": "compose-missing-source", "method": "POST", "path": "/storage/v1/b/{bucket}/o/{object}-missing/compose", "body": {"sourceObjects": [{"name": "{object}-a"}, {"name": "{object}-nosuch"}]}, "expect_status": 404},
    {"name": "compose-source-generation-match", "method": "POST", "path": "/storage/v1/b/{bucket}/o/{object}-gen/compose", "body": {"sourceObjects": [{"name": "{object}-a", "generation": "{ga}"}, {"name": "{object}-b"}]}, "expect_status": 200},
    {"name": "compose-source-generation-unknown", "method": "POST", "path": "/storage/v1/b/{bucket}/o/{object}-badgen/compose", "body": {"sourceObjects": [{"name": "{object}-a", "generation": "1"}, {"name": "{object}-b"}]}, "expect_status": 404},
    {"name": "compose-source-precondition-fail", "method": "POST", "path": "/storage/v1/b/{bucket}/o/{object}-pre/compose", "body": {"sourceObjects": [{"name": "{object}-a", "objectPreconditions": {"ifGenerationMatch": "1"}}, {"name": "{object}-b"}]}, "expect_status": 412},
    {"name": "compose-destination-exists", "method": "POST", "path": "/storage/v1/b/{bucket}/o/{object2}/compose", "query": {"ifGenerationMatch": "0"}, "body": {"sourceObjects": [{"name": "{object}-a"}, {"name": "{object}-b"}]}, "expect_status": 412},
    {"name": "compose-composite-as-source", "method": "POST", "path": "/storage/v1/b/{bucket}/o/{object}-twice/compose", "body": {"sourceObjects": [{"name": "{object2}"}, {"name": "{object}-a"}]}, "expect_status": 200},
    {"name": "get-twice-component-count", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}-twice", "query": {"fields": "name,size,componentCount"}, "expect_status": 200},
    {"name": "compose-delete-source-objects", "method": "POST", "path": "/storage/v1/b/{bucket}/o/{object}-del/compose", "query": {"deleteSourceObjects": "true"}, "body": {"sourceObjects": [{"name": "{object}-gen"}, {"name": "{object}-nodest"}]}, "expect_status": 200},
    {"name": "get-deleted-source", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}-gen", "query": {"fields": "name"}, "expect_status": 404},
    {"name": "compose-missing-bucket", "method": "POST", "path": "/storage/v1/b/{missing_bucket}/o/{object}-x/compose", "body": {"sourceObjects": [{"name": "{object}-a"}]}, "expect_status": 404},
    {"name": "cleanup-a", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-a", "compare": false},
    {"name": "cleanup-b", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-b", "compare": false},
    {"name": "cleanup-composed", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object2}", "compare": false},
    {"name": "cleanup-twice", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-twice", "compare": false},
    {"name": "cleanup-del", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-del", "compare": false}
  ]
}
