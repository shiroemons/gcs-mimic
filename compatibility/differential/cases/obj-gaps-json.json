{
  "id": "obj-gaps-json",
  "description": "JSON object questions the gap ledger left open: If-Match on metadata PATCH and PUT, soft-deleted listing, get and restore on a bucket whose soft delete is off, glob character classes and wildcards against a slash, compose with deleteSourceObjects or destination null, an empty contentLanguage on multipart and resumable uploads, and HEAD of a gzip-stored object on the media route. The two HEAD steps skip the body framing: Cloud Storage labels those bodiless replies chunked, which says nothing about a body that is never sent. Checks SPEC-METADATA-IF-MATCH, SPEC-SOFT-DELETE, SPEC-LIST-GLOB-EDGES, SPEC-RUBY-DEFAULTS, SPEC-015.",
  "steps": [
    {"name": "upload", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "media", "name": "{object}"}, "headers": {"Content-Type": "text/plain"}, "body_text": "hello", "capture": {"etag0": "body:etag"}, "expect_status": 200},
    {"name": "patch-if-match-current", "method": "PATCH", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"fields": "metadata,metageneration"}, "headers": {"If-Match": "\"{etag0}\""}, "body": {"metadata": {"a": "1"}}},
    {"name": "patch-if-match-stale", "method": "PATCH", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"fields": "metadata,metageneration"}, "headers": {"If-Match": "\"{etag0}\""}, "body": {"metadata": {"a": "2"}}},
    {"name": "put-if-match-other", "method": "PUT", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"fields": "metadata,metageneration,contentType"}, "headers": {"If-Match": "\"bogus\""}, "body": {"contentType": "text/plain", "metadata": {"a": "3"}}},
    {"name": "get-after-if-match", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"fields": "metadata,metageneration"}, "expect_status": 200},

    {"name": "upload-soft-delete-probe", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "media", "name": "{object}-sd"}, "headers": {"Content-Type": "text/plain"}, "body_text": "gone", "capture": {"gsd": "body:generation"}, "expect_status": 200},
    {"name": "delete-soft-delete-probe", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-sd", "expect_status": 204},
    {"name": "list-soft-deleted-policy-off", "local_choice": {"reason": "Recorded 2026-11-17: Cloud Storage refuses a soft-deleted listing on a bucket without a soft delete policy with 400 invalid; gcs-mimic answers an empty listing (SPEC-SOFT-DELETE).", "mimic_status": 200},"method": "GET", "path": "/storage/v1/b/{bucket}/o", "query": {"softDeleted": "true", "prefix": "{object}-sd"}},
    {"name": "get-soft-deleted-policy-off", "local_choice": {"reason": "Recorded 2026-11-17: Cloud Storage refuses a soft-deleted read on a bucket without a soft delete policy with 400 invalid; gcs-mimic answers 404 notFound (SPEC-SOFT-DELETE).", "mimic_status": 404},"method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}-sd", "query": {"softDeleted": "true", "generation": "{gsd}"}},
    {"name": "restore-policy-off", "local_choice": {"reason": "Recorded 2026-11-17: Cloud Storage refuses a restore on a bucket without a soft delete policy with 400 invalid; gcs-mimic answers 404 notFound (SPEC-SOFT-DELETE).", "mimic_status": 404},"method": "POST", "path": "/storage/v1/b/{bucket}/o/{object}-sd/restore", "query": {"generation": "{gsd}", "fields": "name"}},

    {"name": "upload-glob-slash", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "media", "name": "{object}-g/a"}, "headers": {"Content-Type": "text/plain"}, "body_text": "s", "expect_status": 200},
    {"name": "upload-glob-dash", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "media", "name": "{object}-g-a"}, "headers": {"Content-Type": "text/plain"}, "body_text": "d", "expect_status": 200},
    {"name": "list-glob-class-with-slash", "method": "GET", "path": "/storage/v1/b/{bucket}/o", "query": {"matchGlob": "{object}-g[/-]a", "fields": "items(name),prefixes"}},
    {"name": "list-glob-negated-class", "method": "GET", "path": "/storage/v1/b/{bucket}/o", "query": {"matchGlob": "{object}-g[!x]a", "fields": "items(name),prefixes"}},
    {"name": "list-glob-question-mark", "method": "GET", "path": "/storage/v1/b/{bucket}/o", "query": {"matchGlob": "{object}-g?a", "fields": "items(name),prefixes"}},

    {"name": "compose-delete-source-null", "method": "POST", "path": "/storage/v1/b/{bucket}/o/{object}-cmp1/compose", "query": {"fields": "name,size"}, "body": {"sourceObjects": [{"name": "{object}"}], "deleteSourceObjects": null}},
    {"name": "compose-destination-null", "method": "POST", "path": "/storage/v1/b/{bucket}/o/{object}-cmp2/compose", "query": {"fields": "name,size"}, "body": {"sourceObjects": [{"name": "{object}"}], "destination": null}},
    {"name": "get-source-after-compose", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"fields": "name"}, "expect_status": 200},

    {"name": "multipart-empty-content-language", "local_choice": {"reason": "Recorded 2026-11-17: Cloud Storage stores an empty contentLanguage sent with a multipart upload; gcs-mimic refuses it with 400 (SPEC-015).", "mimic_status": 400},"method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "multipart", "fields": "name,contentLanguage"}, "headers": {"Content-Type": "multipart/related; boundary=gcsmimicdiff"}, "body_text": "--gcsmimicdiff\r\nContent-Type: application/json; charset=UTF-8\r\n\r\n{{\"name\":\"{object}-lang\",\"contentLanguage\":\"\"}}\r\n--gcsmimicdiff\r\nContent-Type: text/plain\r\n\r\nhello\r\n--gcsmimicdiff--"},
    {"name": "resumable-start-empty-content-language", "local_choice": {"reason": "Recorded 2026-11-17: Cloud Storage starts a resumable session whose metadata has an empty contentLanguage; gcs-mimic refuses it with 400 (SPEC-015).", "mimic_status": 400},"method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "name": "{object}-lang2"}, "headers": {"Content-Type": "application/json", "X-Upload-Content-Type": "text/plain"}, "body": {"contentLanguage": ""}, "compare": {"ignore_headers": ["location", "x-guploader-uploadid"]}},

    {"name": "upload-gzip", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "media", "name": "{object}-gz", "contentEncoding": "gzip"}, "headers": {"Content-Type": "text/plain"}, "body_base64": "H4sIAAAAAAACA8tIzcnJV8hAkACAiPnlEQAAAA==", "expect_status": 200},
    {"name": "head-gzip-media", "method": "HEAD", "path": "/storage/v1/b/{bucket}/o/{object}-gz", "query": {"alt": "media"}, "compare": {"ignore_headers": ["x-harness-body-framing"]}},
    {"name": "head-gzip-media-accept-gzip", "method": "HEAD", "path": "/storage/v1/b/{bucket}/o/{object}-gz", "query": {"alt": "media"}, "headers": {"Accept-Encoding": "gzip"}, "compare": {"ignore_headers": ["x-harness-body-framing"]}},

    {"name": "cleanup-main", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}", "compare": false, "always": true},
    {"name": "cleanup-sd", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-sd", "compare": false, "always": true},
    {"name": "cleanup-glob-slash", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-g%2Fa", "compare": false, "always": true},
    {"name": "cleanup-glob-dash", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-g-a", "compare": false, "always": true},
    {"name": "cleanup-cmp1", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-cmp1", "compare": false, "always": true},
    {"name": "cleanup-cmp2", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-cmp2", "compare": false, "always": true},
    {"name": "cleanup-lang", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-lang", "compare": false, "always": true},
    {"name": "cleanup-gz", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-gz", "compare": false, "always": true}
  ]
}
