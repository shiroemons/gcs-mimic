{
  "id": "obj-resumable-declared-length",
  "description": "Resumable sessions whose X-Upload-Content-Length disagrees with the bytes that follow. The PHP SDK's gs:// writes declare 0, the size of a still-empty buffer, then send 256 KiB chunks whose total is open and finish with the total. A second session declares 0 and finishes in one 5-byte chunk; a third declares 5, sends a 256 KiB chunk whose total is open and finishes past the declared length. Checks SPEC-RESUMABLE-ZERO-DECLARED-LENGTH. Cloud Storage refuses the third session's chunk and then fails the session, repeating an error that counts the bytes it had read; gcs-mimic refuses the chunk but keeps the session, so the three five-* steps are recorded but not compared (SPEC-RESUMABLE-DECLARED-LENGTH-OVERRUN). The 308 answers after data also carry x-goog-running-hash and x-range-md5, which gcs-mimic does not send (SPEC-RESUMABLE-RUNNING-HASH).",
  "steps": [
    {"name": "start-zero", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "name": "{object}"}, "headers": {"Content-Type": "application/json", "X-Upload-Content-Type": "text/plain", "X-Upload-Content-Length": "0"}, "body": {"contentType": "text/plain"}, "capture": {"up": "header:location?upload_id"}, "compare": false, "expect_status": 200},
    {"name": "zero-open-chunk", "method": "PUT", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "upload_id": "{up}"}, "headers": {"Content-Range": "bytes 0-262143/*"}, "body_repeat": {"text": "a", "times": 262144}, "compare": {"ignore_headers": ["x-goog-running-hash", "x-range-md5"]}},
    {"name": "zero-status", "method": "PUT", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "upload_id": "{up}"}, "headers": {"Content-Range": "bytes */*"}, "body_text": "", "compare": {"ignore_headers": ["x-goog-running-hash", "x-range-md5"]}},
    {"name": "zero-final-chunk", "method": "PUT", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "upload_id": "{up}"}, "headers": {"Content-Range": "bytes 262144-262148/262149"}, "body_text": "hello"},
    {"name": "zero-get", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"fields": "name,size"}},
    {"name": "start-zero-one-chunk", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "name": "{object}-one-chunk"}, "headers": {"Content-Type": "application/json", "X-Upload-Content-Type": "text/plain", "X-Upload-Content-Length": "0"}, "body": {"contentType": "text/plain"}, "capture": {"up1": "header:location?upload_id"}, "compare": false, "expect_status": 200},
    {"name": "zero-one-chunk", "method": "PUT", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "upload_id": "{up1}"}, "headers": {"Content-Range": "bytes 0-4/5"}, "body_text": "hello"},
    {"name": "zero-one-chunk-get", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}-one-chunk", "query": {"fields": "name,size"}},
    {"name": "start-five", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "name": "{object}-five"}, "headers": {"Content-Type": "application/json", "X-Upload-Content-Type": "text/plain", "X-Upload-Content-Length": "5"}, "body": {"contentType": "text/plain"}, "capture": {"up5": "header:location?upload_id"}, "compare": false, "expect_status": 200},
    {"name": "five-open-chunk", "method": "PUT", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "upload_id": "{up5}"}, "headers": {"Content-Range": "bytes 0-262143/*"}, "body_repeat": {"text": "a", "times": 262144}, "compare": false},
    {"name": "five-status", "method": "PUT", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "upload_id": "{up5}"}, "headers": {"Content-Range": "bytes */*"}, "body_text": "", "compare": false},
    {"name": "five-final-chunk", "method": "PUT", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "upload_id": "{up5}"}, "headers": {"Content-Range": "bytes 262144-262148/262149"}, "body_text": "hello", "compare": false},
    {"name": "five-get", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}-five", "query": {"fields": "name,size"}},
    {"name": "cleanup", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}", "compare": false, "always": true},
    {"name": "cleanup-one-chunk", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-one-chunk", "compare": false, "always": true},
    {"name": "cleanup-five", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-five", "compare": false, "always": true}
  ]
}
