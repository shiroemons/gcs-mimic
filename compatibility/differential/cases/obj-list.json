{
  "id": "obj-list",
  "description": "Object listing: prefix, delimiter, includeTrailingDelimiter, paging with maxResults and pageToken, zero and invalid maxResults, matchGlob (valid, empty, invalid), startOffset and endOffset, fields, versions and an unmatched prefix. Checks SPEC-LIST-PAGING, SPEC-LIST-GLOB-EDGES and SPEC-LIST-RESOURCE-SHAPE.",
  "compare": {"ignore_body_paths": ["$.nextPageToken"]},
  "steps": [
    {"name": "upload-a", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "media", "name": "{object}/a.txt"}, "headers": {"Content-Type": "text/plain"}, "body_text": "a", "compare": false, "expect_status": 200},
    {"name": "upload-b", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "media", "name": "{object}/b.txt"}, "headers": {"Content-Type": "text/plain"}, "body_text": "b", "compare": false, "expect_status": 200},
    {"name": "upload-c", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "media", "name": "{object}/sub/c.txt"}, "headers": {"Content-Type": "text/plain"}, "body_text": "c", "compare": false, "expect_status": 200},
    {"name": "upload-d", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "media", "name": "{object}/sub/d.log"}, "headers": {"Content-Type": "text/plain"}, "body_text": "d", "compare": false, "expect_status": 200},
    {"name": "list-prefix", "method": "GET", "path": "/storage/v1/b/{bucket}/o", "query": {"prefix": "{object}/"}, "expect_status": 200},
    {"name": "list-delimiter", "method": "GET", "path": "/storage/v1/b/{bucket}/o", "query": {"prefix": "{object}/", "delimiter": "/"}, "expect_status": 200},
    {"name": "list-delimiter-trailing", "method": "GET", "path": "/storage/v1/b/{bucket}/o", "query": {"prefix": "{object}/", "delimiter": "/", "includeTrailingDelimiter": "true"}, "expect_status": 200},
    {"name": "list-page-1", "method": "GET", "path": "/storage/v1/b/{bucket}/o", "query": {"prefix": "{object}/", "maxResults": "2"}, "capture": {"token1": "body:nextPageToken"}, "expect_status": 200},
    {"name": "list-page-2", "method": "GET", "path": "/storage/v1/b/{bucket}/o", "query": {"prefix": "{object}/", "maxResults": "2", "pageToken": "{token1}"}, "expect_status": 200},
    {"name": "list-delimiter-page-1", "method": "GET", "path": "/storage/v1/b/{bucket}/o", "query": {"prefix": "{object}/", "delimiter": "/", "maxResults": "1"}, "capture": {"token2": "body:nextPageToken"}, "expect_status": 200},
    {"name": "list-delimiter-page-2", "method": "GET", "path": "/storage/v1/b/{bucket}/o", "query": {"prefix": "{object}/", "delimiter": "/", "maxResults": "1", "pageToken": "{token2}"}, "expect_status": 200},
    {"name": "list-max-results-zero", "method": "GET", "path": "/storage/v1/b/{bucket}/o", "query": {"prefix": "{object}/", "maxResults": "0"}, "expect_status": 200},
    {"name": "list-max-results-negative", "method": "GET", "path": "/storage/v1/b/{bucket}/o", "query": {"prefix": "{object}/", "maxResults": "-1"}, "expect_status": 400},
    {"name": "list-max-results-not-a-number", "method": "GET", "path": "/storage/v1/b/{bucket}/o", "query": {"prefix": "{object}/", "maxResults": "abc"}, "expect_status": 400},
    {"name": "list-bogus-page-token", "method": "GET", "path": "/storage/v1/b/{bucket}/o", "query": {"prefix": "{object}/", "pageToken": "bogus"}, "expect_status": 400},
    {"name": "list-glob-star", "method": "GET", "path": "/storage/v1/b/{bucket}/o", "query": {"matchGlob": "{object}/*.txt"}, "expect_status": 200},
    {"name": "list-glob-double-star", "method": "GET", "path": "/storage/v1/b/{bucket}/o", "query": {"matchGlob": "{object}/**/c.txt"}, "expect_status": 200},
    {"name": "list-glob-empty", "method": "GET", "path": "/storage/v1/b/{bucket}/o", "query": {"prefix": "{object}/", "matchGlob": ""}, "expect_status": 200},
    {"name": "list-glob-invalid", "method": "GET", "path": "/storage/v1/b/{bucket}/o", "query": {"matchGlob": "[abc"}, "expect_status": 400},
    {"name": "list-offsets", "method": "GET", "path": "/storage/v1/b/{bucket}/o", "query": {"prefix": "{object}/", "startOffset": "{object}/b", "endOffset": "{object}/sub/d"}, "expect_status": 200},
    {"name": "list-offsets-crossed", "method": "GET", "path": "/storage/v1/b/{bucket}/o", "query": {"prefix": "{object}/", "startOffset": "{object}/z", "endOffset": "{object}/a"}, "expect_status": 200},
    {"name": "list-fields", "method": "GET", "path": "/storage/v1/b/{bucket}/o", "query": {"prefix": "{object}/", "delimiter": "/", "fields": "items(name,size),prefixes,nextPageToken"}, "expect_status": 200},
    {"name": "list-fields-invalid", "method": "GET", "path": "/storage/v1/b/{bucket}/o", "query": {"prefix": "{object}/", "fields": "items(nosuch)"}, "expect_status": 400},
    {"name": "list-projection-full", "method": "GET", "path": "/storage/v1/b/{bucket}/o", "query": {"prefix": "{object}/a", "projection": "full"}, "expect_status": 200},
    {"name": "list-no-match", "method": "GET", "path": "/storage/v1/b/{bucket}/o", "query": {"prefix": "{object}-nothing"}, "expect_status": 200},
    {"name": "list-missing-bucket", "method": "GET", "path": "/storage/v1/b/{missing_bucket}/o", "expect_status": 404},
    {"name": "cleanup-a", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}%2Fa.txt", "compare": false},
    {"name": "cleanup-b", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}%2Fb.txt", "compare": false},
    {"name": "cleanup-c", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}%2Fsub%2Fc.txt", "compare": false},
    {"name": "cleanup-d", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}%2Fsub%2Fd.log", "compare": false}
  ]
}
