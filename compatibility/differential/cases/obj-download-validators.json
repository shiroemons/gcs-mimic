{
  "id": "obj-download-validators",
  "description": "Download response headers and conditional request headers (If-Match, If-None-Match, If-Modified-Since, If-Unmodified-Since) on media downloads and metadata reads. Checks SPEC-JSON-ETAG-WIRE.",
  "steps": [
    {"name": "upload", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "media", "name": "{object}"}, "headers": {"Content-Type": "text/plain"}, "body_text": "hello", "capture": {"jetag": "body:etag"}, "compare": false, "expect_status": 200},
    {"name": "download", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"alt": "media"}, "capture": {"hetag": "header:etag"}, "expect_status": 200},
    {"name": "metadata-etag", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"fields": "name,etag"}, "expect_status": 200},
    {"name": "media-if-none-match-current", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"alt": "media"}, "headers": {"If-None-Match": "{hetag}"}, "expect_status": 304},
    {"name": "media-if-none-match-other", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"alt": "media"}, "headers": {"If-None-Match": "\"other\""}, "expect_status": 200},
    {"name": "media-if-match-current", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"alt": "media"}, "headers": {"If-Match": "{hetag}"}, "expect_status": 200},
    {"name": "media-if-match-other", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"alt": "media"}, "headers": {"If-Match": "\"other\""}, "expect_status": 412},
    {"name": "media-if-modified-since-future", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"alt": "media"}, "headers": {"If-Modified-Since": "Fri, 01 Jan 2100 00:00:00 GMT"}, "expect_status": 304},
    {"name": "media-if-unmodified-since-past", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"alt": "media"}, "headers": {"If-Unmodified-Since": "Thu, 01 Jan 2015 00:00:00 GMT"}, "expect_status": 412},
    {"name": "media-if-none-match-and-match", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"alt": "media"}, "headers": {"If-None-Match": "{hetag}", "If-Match": "\"other\""}, "expect_status": 412},
    {"name": "metadata-if-none-match-current", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}", "headers": {"If-None-Match": "{jetag}"}, "expect_status": 304},
    {"name": "metadata-if-none-match-other", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}", "headers": {"If-None-Match": "\"other\""}, "expect_status": 200},
    {"name": "metadata-if-match-other", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}", "headers": {"If-Match": "\"other\""}, "expect_status": 412},
    {"name": "generation-and-metageneration-conflict", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"ifGenerationMatch": "1", "ifMetagenerationMatch": "999"}, "expect_status": 412},
    {"name": "generation-not-match-and-match", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"ifGenerationMatch": "1", "ifGenerationNotMatch": "1"}, "expect_status": 412},
    {"name": "cleanup", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}", "compare": false}
  ]
}
