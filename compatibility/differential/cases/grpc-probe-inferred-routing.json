{
  "id": "grpc-probe-inferred-routing",
  "description": "Storage v2 x-goog-request-params handling that gcs-mimic decided by inference, on a bucket of its own (UpdateBucket is one of the RPCs asked) with 5-byte objects. No metadata at all on the RPCs other than the four recorded (GetObject, GetBucket, ListBuckets and WriteObject answered INVALID_ARGUMENT, GRPC_INVALID_X_GOOG_REQUEST_PARAMS): ListObjects, DeleteObject of a missing object, UpdateObject, ComposeObject, RewriteObject, StartResumableWrite, GetIamPolicy, TestIamPermissions, BidiWriteObject, ReadObject, MoveObject, RestoreObject of a generation that does not exist (an error either way; the question is which), UpdateBucket of the label probe, DeleteBucket of a bucket that does not exist (never the case's own bucket), and QueryWriteStatus and CancelResumableWrite with an upload_id StartResumableWrite issued. Metadata forms on GetObject: the bucket key twice with the same value, twice with different values (the request's bucket first, then second), a pair without = (bucket), an unknown key with a malformed percent escape (unknown=%GG) beside the right bucket, a trailing &, a percent-encoded key (%62ucket), and an empty value. ListBuckets, which routes project: a bare bucket ID as bucket beside the right project, and a project that is not the request's. RewriteObject: a source_bucket other than the request's source bucket beside the right bucket, only bucket, and only source_bucket. QueryWriteStatus and CancelResumableWrite with an issued upload_id, on a session of their own, and metadata that routes another (missing) bucket. Session starts capture the upload_id and are not compared; the StartResumableWrite without metadata compares without uploadId in case the service accepts it. Asks BEHAVIOR-RPC-001 (its routing under SPEC-GRPC-ROUTING-NAMES and SPEC-GRPC-UNMODELED-SETTINGS).",
  "bucket": "own",
  "steps": [
    {"name": "write", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}", "contentType": "text/plain"}, "objectSize": "5"}, "checksummedData": {"content": "aGVsbG8="}, "finishWrite": true}], "compare": false, "expect_status": 0},
    {"name": "write-move-source", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-move", "contentType": "text/plain"}, "objectSize": "1"}, "checksummedData": {"content": "eA=="}, "finishWrite": true}], "compare": false, "expect_status": 0},
    {"name": "start-session-unrouted", "protocol": "grpc", "rpc": "google.storage.v2.Storage/StartResumableWrite", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-unrouted", "contentType": "text/plain"}}}, "capture": {"unrouted": "body:uploadId"}, "compare": false, "expect_status": 0},
    {"name": "start-session-other-bucket", "protocol": "grpc", "rpc": "google.storage.v2.Storage/StartResumableWrite", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-other-bucket", "contentType": "text/plain"}}}, "capture": {"other": "body:uploadId"}, "compare": false, "expect_status": 0},
    {"name": "list-objects-without-routing", "protocol": "grpc", "rpc": "google.storage.v2.Storage/ListObjects", "body": {"parent": "projects/_/buckets/{bucket}", "readMask": {"paths": ["name"]}}},
    {"name": "delete-missing-object-without-routing", "protocol": "grpc", "rpc": "google.storage.v2.Storage/DeleteObject", "body": {"bucket": "projects/_/buckets/{bucket}", "object": "{object}-missing"}},
    {"name": "update-object-without-routing", "protocol": "grpc", "rpc": "google.storage.v2.Storage/UpdateObject", "body": {"object": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}", "contentLanguage": "fr"}, "updateMask": {"paths": ["content_language"]}}},
    {"name": "compose-without-routing", "protocol": "grpc", "rpc": "google.storage.v2.Storage/ComposeObject", "body": {"destination": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-composed"}, "sourceObjects": [{"name": "{object}"}]}},
    {"name": "rewrite-without-routing", "protocol": "grpc", "rpc": "google.storage.v2.Storage/RewriteObject", "body": {"destinationName": "{object}-rewritten", "destinationBucket": "projects/_/buckets/{bucket}", "sourceBucket": "projects/_/buckets/{bucket}", "sourceObject": "{object}"}},
    {"name": "start-resumable-without-routing", "protocol": "grpc", "rpc": "google.storage.v2.Storage/StartResumableWrite", "body": {"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-started", "contentType": "text/plain"}}}, "compare": {"ignore_body_paths": ["$.uploadId"]}},
    {"name": "get-iam-policy-without-routing", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetIamPolicy", "body": {"resource": "projects/_/buckets/{bucket}"}},
    {"name": "test-iam-permissions-without-routing", "protocol": "grpc", "rpc": "google.storage.v2.Storage/TestIamPermissions", "body": {"resource": "projects/_/buckets/{bucket}", "permissions": ["storage.buckets.get"]}},
    {"name": "bidi-write-without-routing", "protocol": "grpc", "rpc": "google.storage.v2.Storage/BidiWriteObject", "body": [{"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-bidi", "contentType": "text/plain"}}, "writeOffset": "0", "checksummedData": {"content": "aGVsbG8="}, "finishWrite": true}]},
    {"name": "read-object-without-routing", "protocol": "grpc", "rpc": "google.storage.v2.Storage/ReadObject", "body": {"bucket": "projects/_/buckets/{bucket}", "object": "{object}"}},
    {"name": "move-object-without-routing", "protocol": "grpc", "rpc": "google.storage.v2.Storage/MoveObject", "body": {"bucket": "projects/_/buckets/{bucket}", "sourceObject": "{object}-move", "destinationObject": "{object}-moved"}},
    {"name": "restore-object-without-routing", "protocol": "grpc", "rpc": "google.storage.v2.Storage/RestoreObject", "body": {"bucket": "projects/_/buckets/{bucket}", "object": "{object}-gone", "generation": "1"}},
    {"name": "update-bucket-without-routing", "protocol": "grpc", "rpc": "google.storage.v2.Storage/UpdateBucket", "body": {"bucket": {"name": "projects/_/buckets/{bucket}", "labels": {"probe": "without-routing"}}, "updateMask": {"paths": ["labels.probe"]}}},
    {"name": "delete-missing-bucket-without-routing", "protocol": "grpc", "rpc": "google.storage.v2.Storage/DeleteBucket", "body": {"name": "projects/_/buckets/{missing_bucket}"}},
    {"name": "query-write-status-without-routing", "protocol": "grpc", "rpc": "google.storage.v2.Storage/QueryWriteStatus", "body": {"uploadId": "{unrouted}"}},
    {"name": "cancel-resumable-write-without-routing", "protocol": "grpc", "rpc": "google.storage.v2.Storage/CancelResumableWrite", "body": {"uploadId": "{unrouted}"}},
    {"name": "get-routing-bucket-twice-same", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}&bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": "projects/_/buckets/{bucket}", "object": "{object}", "readMask": {"paths": ["name", "size"]}}},
    {"name": "get-routing-bucket-twice-request-first", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}&bucket=projects%2F_%2Fbuckets%2F{missing_bucket}"}, "body": {"bucket": "projects/_/buckets/{bucket}", "object": "{object}", "readMask": {"paths": ["name", "size"]}}},
    {"name": "get-routing-bucket-twice-request-second", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{missing_bucket}&bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": "projects/_/buckets/{bucket}", "object": "{object}", "readMask": {"paths": ["name", "size"]}}},
    {"name": "get-routing-key-without-value", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetObject", "headers": {"x-goog-request-params": "bucket"}, "body": {"bucket": "projects/_/buckets/{bucket}", "object": "{object}", "readMask": {"paths": ["name", "size"]}}},
    {"name": "get-routing-unknown-key-malformed-escape", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}&unknown=%GG"}, "body": {"bucket": "projects/_/buckets/{bucket}", "object": "{object}", "readMask": {"paths": ["name", "size"]}}},
    {"name": "get-routing-trailing-ampersand", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}&"}, "body": {"bucket": "projects/_/buckets/{bucket}", "object": "{object}", "readMask": {"paths": ["name", "size"]}}},
    {"name": "get-routing-percent-encoded-key", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetObject", "headers": {"x-goog-request-params": "%62ucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": "projects/_/buckets/{bucket}", "object": "{object}", "readMask": {"paths": ["name", "size"]}}},
    {"name": "get-routing-empty-value", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetObject", "headers": {"x-goog-request-params": ""}, "body": {"bucket": "projects/_/buckets/{bucket}", "object": "{object}", "readMask": {"paths": ["name", "size"]}}},
    {"name": "list-buckets-routing-bare-bucket-beside-project", "protocol": "grpc", "rpc": "google.storage.v2.Storage/ListBuckets", "headers": {"x-goog-request-params": "project=projects%2F{project}&bucket={bucket}"}, "body": {"parent": "projects/{project}", "prefix": "{bucket}", "readMask": {"paths": ["name"]}}},
    {"name": "list-buckets-routing-other-project", "protocol": "grpc", "rpc": "google.storage.v2.Storage/ListBuckets", "headers": {"x-goog-request-params": "project=projects%2Fgcsmimic-probe-other"}, "body": {"parent": "projects/{project}", "prefix": "{bucket}", "readMask": {"paths": ["name"]}}},
    {"name": "rewrite-routing-other-source-bucket", "protocol": "grpc", "rpc": "google.storage.v2.Storage/RewriteObject", "headers": {"x-goog-request-params": "source_bucket=projects%2F_%2Fbuckets%2F{missing_bucket}&bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"destinationName": "{object}-rw-other-source", "destinationBucket": "projects/_/buckets/{bucket}", "sourceBucket": "projects/_/buckets/{bucket}", "sourceObject": "{object}"}},
    {"name": "rewrite-routing-bucket-only", "protocol": "grpc", "rpc": "google.storage.v2.Storage/RewriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"destinationName": "{object}-rw-bucket-only", "destinationBucket": "projects/_/buckets/{bucket}", "sourceBucket": "projects/_/buckets/{bucket}", "sourceObject": "{object}"}},
    {"name": "rewrite-routing-source-bucket-only", "protocol": "grpc", "rpc": "google.storage.v2.Storage/RewriteObject", "headers": {"x-goog-request-params": "source_bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"destinationName": "{object}-rw-source-only", "destinationBucket": "projects/_/buckets/{bucket}", "sourceBucket": "projects/_/buckets/{bucket}", "sourceObject": "{object}"}},
    {"name": "query-write-status-routed-other-bucket", "protocol": "grpc", "rpc": "google.storage.v2.Storage/QueryWriteStatus", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{missing_bucket}"}, "body": {"uploadId": "{other}"}},
    {"name": "cancel-resumable-write-routed-other-bucket", "protocol": "grpc", "rpc": "google.storage.v2.Storage/CancelResumableWrite", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{missing_bucket}"}, "body": {"uploadId": "{other}"}}
  ]
}
