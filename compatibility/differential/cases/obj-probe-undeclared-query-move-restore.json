{
  "id": "obj-probe-undeclared-query-move-restore",
  "description": "The undeclared query parameter gcsmimicUnknown=1 on objects.move in the shared bucket and on objects.restore in a new bucket that keeps soft-deleted objects for the 7-day minimum (restore needs a soft delete policy), each followed by a read that shows whether the request took effect. Checks SPEC-JSON-UNKNOWN-QUERY-OBJECTS.",
  "steps": [
    {"name": "upload", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "media", "name": "{object}"}, "headers": {"Content-Type": "text/plain"}, "body_text": "hello", "compare": false, "expect_status": 200},
    {"name": "move", "method": "POST", "path": "/storage/v1/b/{bucket}/o/{object}/moveTo/o/{object2}", "query": {"gcsmimicUnknown": "1", "fields": "name,size"}},
    {"name": "get-move-destination", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object2}", "query": {"fields": "name,size"}},
    {"name": "create-soft-delete-bucket", "method": "POST", "path": "/storage/v1/b", "query": {"project": "{project}", "fields": "name"}, "body": {"name": "{new_bucket}", "location": "us-central1", "storageClass": "STANDARD", "softDeletePolicy": {"retentionDurationSeconds": "604800"}, "iamConfiguration": {"publicAccessPrevention": "enforced"}}, "compare": false, "expect_status": 200},
    {"name": "upload-to-soft-delete", "method": "POST", "path": "/upload/storage/v1/b/{new_bucket}/o", "query": {"uploadType": "media", "name": "{object}"}, "headers": {"Content-Type": "text/plain"}, "body_text": "hello", "capture": {"gen": "body:generation"}, "compare": false, "expect_status": 200},
    {"name": "soft-delete", "method": "DELETE", "path": "/storage/v1/b/{new_bucket}/o/{object}", "compare": false, "expect_status": 204},
    {"name": "restore", "method": "POST", "path": "/storage/v1/b/{new_bucket}/o/{object}/restore", "query": {"generation": "{gen}", "gcsmimicUnknown": "1", "fields": "name,size"}},
    {"name": "get-restored", "method": "GET", "path": "/storage/v1/b/{new_bucket}/o/{object}", "query": {"fields": "name,size"}},
    {"name": "cleanup-move-destination", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object2}", "compare": false, "always": true},
    {"name": "cleanup-move-source", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}", "compare": false, "always": true},
    {"name": "cleanup-restored", "method": "DELETE", "path": "/storage/v1/b/{new_bucket}/o/{object}", "compare": false, "always": true}
  ]
}
