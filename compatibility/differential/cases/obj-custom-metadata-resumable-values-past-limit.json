{
  "id": "obj-custom-metadata-resumable-values-past-limit",
  "description": "A resumable upload whose start sends an 8193-byte value under a one-byte key. The 2026-11-15 live recording shows that Cloud Storage accepts both the start and the completion.",
  "steps": [
    {"name": "start", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "name": "{object}"}, "headers": {"Content-Type": "application/json", "X-Upload-Content-Type": "text/plain", "X-Upload-Content-Length": "5"}, "body": {"metadata": {"k": ""}}, "capture": {"up": "header:location?upload_id"}, "expect_status": 200},
    {"name": "complete", "method": "PUT", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "upload_id": "{up}", "fields": "name"}, "headers": {"Content-Range": "bytes 0-4/5"}, "body_text": "hello", "expect_status": 200}
  ]
}
