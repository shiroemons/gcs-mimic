{
  "id": "obj-list-empty-bucket",
  "description": "Object listing in a freshly created empty bucket, with and without versions, a delimiter and fields. Checks SPEC-LIST-RESOURCE-SHAPE.",
  "bucket": false,
  "steps": [
    {"name": "create", "method": "POST", "path": "/storage/v1/b", "query": {"project": "{project}"}, "body": {"name": "{new_bucket}", "location": "us-central1", "storageClass": "STANDARD", "softDeletePolicy": {"retentionDurationSeconds": "0"}}, "compare": false, "expect_status": 200},
    {"name": "list", "method": "GET", "path": "/storage/v1/b/{new_bucket}/o", "expect_status": 200},
    {"name": "list-versions", "method": "GET", "path": "/storage/v1/b/{new_bucket}/o", "query": {"versions": "true"}, "expect_status": 200},
    {"name": "list-delimiter", "method": "GET", "path": "/storage/v1/b/{new_bucket}/o", "query": {"delimiter": "/", "prefix": "a/"}, "expect_status": 200},
    {"name": "list-fields", "method": "GET", "path": "/storage/v1/b/{new_bucket}/o", "query": {"fields": "items(name),prefixes,nextPageToken"}, "expect_status": 200},
    {"name": "delete", "method": "DELETE", "path": "/storage/v1/b/{new_bucket}", "compare": false, "expect_status": 204}
  ]
}
