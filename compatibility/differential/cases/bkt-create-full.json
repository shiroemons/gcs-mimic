{
  "id": "bkt-create-full",
  "description": "Create a bucket with an uppercase location, a non-default storage class and every common configuration block; read it back with projection=full and field selectors, then clear retention and soft delete and delete it. Checks location normalization, input echo, default ACL output and header parity.",
  "bucket": false,
  "steps": [
    {"name": "create-full", "method": "POST", "path": "/storage/v1/b", "query": {"project": "{project}"}, "body": {"name": "{new_bucket}", "location": "US-CENTRAL1", "storageClass": "NEARLINE", "labels": {"team": "diff", "stage": "test"}, "versioning": {"enabled": true}, "retentionPolicy": {"retentionPeriod": "86400"}, "softDeletePolicy": {"retentionDurationSeconds": "604800"}, "lifecycle": {"rule": [{"action": {"type": "Delete"}, "condition": {"age": 30}}, {"action": {"type": "SetStorageClass", "storageClass": "COLDLINE"}, "condition": {"age": 7, "matchesStorageClass": ["NEARLINE"]}}]}, "cors": [{"origin": ["https://example.com"], "method": ["GET", "HEAD"], "responseHeader": ["Content-Type"], "maxAgeSeconds": 3600}], "iamConfiguration": {"uniformBucketLevelAccess": {"enabled": false}, "publicAccessPrevention": "inherited"}}, "expect_status": 200},
    {"name": "get", "method": "GET", "path": "/storage/v1/b/{new_bucket}", "expect_status": 200},
    {"name": "get-full", "method": "GET", "path": "/storage/v1/b/{new_bucket}", "query": {"projection": "full"}, "expect_status": 200},
    {"name": "get-fields-config", "method": "GET", "path": "/storage/v1/b/{new_bucket}", "query": {"fields": "name,location,locationType,storageClass,labels,versioning,retentionPolicy,softDeletePolicy,lifecycle,cors,iamConfiguration"}, "expect_status": 200},
    {"name": "get-fields-nested", "method": "GET", "path": "/storage/v1/b/{new_bucket}", "query": {"fields": "iamConfiguration/uniformBucketLevelAccess,retentionPolicy/retentionPeriod,lifecycle/rule/action"}, "expect_status": 200},
    {"name": "clear-retention-and-soft-delete", "method": "PATCH", "path": "/storage/v1/b/{new_bucket}", "body": {"retentionPolicy": null, "softDeletePolicy": {"retentionDurationSeconds": "0"}}, "expect_status": 200},
    {"name": "get-after-clear", "method": "GET", "path": "/storage/v1/b/{new_bucket}", "query": {"fields": "retentionPolicy,softDeletePolicy"}, "expect_status": 200},
    {"name": "delete", "method": "DELETE", "path": "/storage/v1/b/{new_bucket}", "expect_status": 204}
  ]
}
