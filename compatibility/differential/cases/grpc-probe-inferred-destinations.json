{
  "id": "grpc-probe-inferred-destinations",
  "description": "Which service-set destination fields make Storage v2 RewriteObject and ComposeObject refuse a request, on a bucket of its own with a 5-byte text/plain source. The earlier probe (grpc-probe-derived-writes) sent five such fields at once, and Cloud Storage refused the rewrite with INVALID_ARGUMENT (You must specify an object name.) while it accepted the compose; gcs-mimic's per-field answers are inferred from the proto. Here each step sets exactly one field on the destination, each writing a destination name of its own: generation 1, metageneration 7, size 99, etag gcsmimic-probe, create_time and update_time 2020-01-01, checksums with the crc32c the result will have (2591144780, so only the field and not a mismatch is asked), owner user-gcsmimic-probe and component_count 7. RewriteObject names the destination by destination_name and destination_bucket as an SDK does; ComposeObject names it in the destination. Asks RPC-STORAGE-010 grpc_compose_destination_fields and RPC-STORAGE-021 rewrite_destination_fields (SPEC-SDK-UNSUPPORTED).",
  "bucket": "own",
  "steps": [
    {"name": "write-source", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}", "contentType": "text/plain"}, "objectSize": "5"}, "checksummedData": {"content": "aGVsbG8="}, "finishWrite": true}], "compare": false, "expect_status": 0},
    {"name": "rewrite-destination-generation", "protocol": "grpc", "rpc": "google.storage.v2.Storage/RewriteObject", "headers": {"x-goog-request-params": "source_bucket=projects%2F_%2Fbuckets%2F{bucket}&bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"destinationName": "{object}-rw-generation", "destinationBucket": "projects/_/buckets/{bucket}", "destination": {"generation": "1"}, "sourceBucket": "projects/_/buckets/{bucket}", "sourceObject": "{object}"}},
    {"name": "rewrite-destination-metageneration", "protocol": "grpc", "rpc": "google.storage.v2.Storage/RewriteObject", "headers": {"x-goog-request-params": "source_bucket=projects%2F_%2Fbuckets%2F{bucket}&bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"destinationName": "{object}-rw-metageneration", "destinationBucket": "projects/_/buckets/{bucket}", "destination": {"metageneration": "7"}, "sourceBucket": "projects/_/buckets/{bucket}", "sourceObject": "{object}"}},
    {"name": "rewrite-destination-size", "protocol": "grpc", "rpc": "google.storage.v2.Storage/RewriteObject", "headers": {"x-goog-request-params": "source_bucket=projects%2F_%2Fbuckets%2F{bucket}&bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"destinationName": "{object}-rw-size", "destinationBucket": "projects/_/buckets/{bucket}", "destination": {"size": "99"}, "sourceBucket": "projects/_/buckets/{bucket}", "sourceObject": "{object}"}},
    {"name": "rewrite-destination-etag", "protocol": "grpc", "rpc": "google.storage.v2.Storage/RewriteObject", "headers": {"x-goog-request-params": "source_bucket=projects%2F_%2Fbuckets%2F{bucket}&bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"destinationName": "{object}-rw-etag", "destinationBucket": "projects/_/buckets/{bucket}", "destination": {"etag": "gcsmimic-probe"}, "sourceBucket": "projects/_/buckets/{bucket}", "sourceObject": "{object}"}},
    {"name": "rewrite-destination-create-time", "protocol": "grpc", "rpc": "google.storage.v2.Storage/RewriteObject", "headers": {"x-goog-request-params": "source_bucket=projects%2F_%2Fbuckets%2F{bucket}&bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"destinationName": "{object}-rw-create-time", "destinationBucket": "projects/_/buckets/{bucket}", "destination": {"createTime": "2020-01-01T00:00:00Z"}, "sourceBucket": "projects/_/buckets/{bucket}", "sourceObject": "{object}"}},
    {"name": "rewrite-destination-update-time", "protocol": "grpc", "rpc": "google.storage.v2.Storage/RewriteObject", "headers": {"x-goog-request-params": "source_bucket=projects%2F_%2Fbuckets%2F{bucket}&bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"destinationName": "{object}-rw-update-time", "destinationBucket": "projects/_/buckets/{bucket}", "destination": {"updateTime": "2020-01-01T00:00:00Z"}, "sourceBucket": "projects/_/buckets/{bucket}", "sourceObject": "{object}"}},
    {"name": "rewrite-destination-checksums", "protocol": "grpc", "rpc": "google.storage.v2.Storage/RewriteObject", "headers": {"x-goog-request-params": "source_bucket=projects%2F_%2Fbuckets%2F{bucket}&bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"destinationName": "{object}-rw-checksums", "destinationBucket": "projects/_/buckets/{bucket}", "destination": {"checksums": {"crc32c": 2591144780}}, "sourceBucket": "projects/_/buckets/{bucket}", "sourceObject": "{object}"}},
    {"name": "rewrite-destination-owner", "protocol": "grpc", "rpc": "google.storage.v2.Storage/RewriteObject", "headers": {"x-goog-request-params": "source_bucket=projects%2F_%2Fbuckets%2F{bucket}&bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"destinationName": "{object}-rw-owner", "destinationBucket": "projects/_/buckets/{bucket}", "destination": {"owner": {"entity": "user-gcsmimic-probe"}}, "sourceBucket": "projects/_/buckets/{bucket}", "sourceObject": "{object}"}},
    {"name": "rewrite-destination-component-count", "protocol": "grpc", "rpc": "google.storage.v2.Storage/RewriteObject", "headers": {"x-goog-request-params": "source_bucket=projects%2F_%2Fbuckets%2F{bucket}&bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"destinationName": "{object}-rw-component-count", "destinationBucket": "projects/_/buckets/{bucket}", "destination": {"componentCount": 7}, "sourceBucket": "projects/_/buckets/{bucket}", "sourceObject": "{object}"}},
    {"name": "compose-destination-generation", "protocol": "grpc", "rpc": "google.storage.v2.Storage/ComposeObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"destination": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-c-generation", "generation": "1"}, "sourceObjects": [{"name": "{object}"}]}},
    {"name": "compose-destination-metageneration", "protocol": "grpc", "rpc": "google.storage.v2.Storage/ComposeObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"destination": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-c-metageneration", "metageneration": "7"}, "sourceObjects": [{"name": "{object}"}]}},
    {"name": "compose-destination-size", "protocol": "grpc", "rpc": "google.storage.v2.Storage/ComposeObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"destination": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-c-size", "size": "99"}, "sourceObjects": [{"name": "{object}"}]}},
    {"name": "compose-destination-etag", "protocol": "grpc", "rpc": "google.storage.v2.Storage/ComposeObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"destination": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-c-etag", "etag": "gcsmimic-probe"}, "sourceObjects": [{"name": "{object}"}]}},
    {"name": "compose-destination-create-time", "protocol": "grpc", "rpc": "google.storage.v2.Storage/ComposeObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"destination": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-c-create-time", "createTime": "2020-01-01T00:00:00Z"}, "sourceObjects": [{"name": "{object}"}]}},
    {"name": "compose-destination-update-time", "protocol": "grpc", "rpc": "google.storage.v2.Storage/ComposeObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"destination": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-c-update-time", "updateTime": "2020-01-01T00:00:00Z"}, "sourceObjects": [{"name": "{object}"}]}},
    {"name": "compose-destination-checksums", "protocol": "grpc", "rpc": "google.storage.v2.Storage/ComposeObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"destination": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-c-checksums", "checksums": {"crc32c": 2591144780}}, "sourceObjects": [{"name": "{object}"}]}},
    {"name": "compose-destination-owner", "protocol": "grpc", "rpc": "google.storage.v2.Storage/ComposeObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"destination": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-c-owner", "owner": {"entity": "user-gcsmimic-probe"}}, "sourceObjects": [{"name": "{object}"}]}},
    {"name": "compose-destination-component-count", "protocol": "grpc", "rpc": "google.storage.v2.Storage/ComposeObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"destination": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-c-component-count", "componentCount": 7}, "sourceObjects": [{"name": "{object}"}]}}
  ]
}
