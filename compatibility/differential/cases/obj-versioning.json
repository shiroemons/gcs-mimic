{
  "id": "obj-versioning",
  "description": "With bucket versioning enabled for the duration of the case: generation-specific get and delete, combined generation and metageneration preconditions, noncurrent versions, listing with versions and copy from a source generation. Versioning is switched off again at the end. Checks SPEC-008 and SPEC-VERSION-DELETE-CONDITIONS.",
  "bucket": "own",
  "steps": [
    {"name": "enable-versioning", "method": "PATCH", "path": "/storage/v1/b/{bucket}", "query": {"fields": "name,versioning"}, "body": {"versioning": {"enabled": true}}, "expect_status": 200},
    {"name": "upload-v1", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "media", "name": "{object}"}, "headers": {"Content-Type": "text/plain"}, "body_text": "one", "capture": {"g1": "body:generation"}, "compare": false, "expect_status": 200},
    {"name": "upload-v2", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "media", "name": "{object}"}, "headers": {"Content-Type": "text/plain"}, "body_text": "two", "capture": {"g2": "body:generation"}, "expect_status": 200},
    {"name": "get-live", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"fields": "name,size,generation,metageneration,timeDeleted"}, "expect_status": 200},
    {"name": "get-g1-metadata", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"generation": "{g1}", "fields": "name,size,generation,timeDeleted"}, "expect_status": 200},
    {"name": "get-g1-media", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"generation": "{g1}", "alt": "media"}, "expect_status": 200},
    {"name": "get-g1-match-g2", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"generation": "{g1}", "ifGenerationMatch": "{g2}", "fields": "name"}, "expect_status": 412},
    {"name": "get-g1-not-match-g1", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"generation": "{g1}", "ifGenerationNotMatch": "{g1}", "fields": "name"}, "expect_status": 304},
    {"name": "get-live-match-g1", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"ifGenerationMatch": "{g1}", "fields": "name"}, "expect_status": 412},
    {"name": "get-live-not-match-g2", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"ifGenerationNotMatch": "{g2}", "fields": "name"}, "expect_status": 304},
    {"name": "get-unknown-generation", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"generation": "1", "fields": "name"}, "expect_status": 404},
    {"name": "get-invalid-generation", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"generation": "abc", "fields": "name"}, "expect_status": 400},
    {"name": "list-versions", "method": "GET", "path": "/storage/v1/b/{bucket}/o", "query": {"prefix": "{object}", "versions": "true", "fields": "items(name,size,timeDeleted)"}, "expect_status": 200},
    {"name": "delete-g1-match-g2", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"generation": "{g1}", "ifGenerationMatch": "{g2}"}, "expect_status": 412},
    {"name": "delete-g2-metageneration-mismatch", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"generation": "{g2}", "ifMetagenerationMatch": "999"}, "expect_status": 412},
    {"name": "delete-g2-match-g1-without-generation", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"ifGenerationMatch": "{g1}"}, "expect_status": 412},
    {"name": "delete-g1-match-g1", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"generation": "{g1}", "ifGenerationMatch": "{g1}"}, "expect_status": 204},
    {"name": "get-g1-after-delete", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"generation": "{g1}", "fields": "name"}, "expect_status": 404},
    {"name": "delete-g1-again", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"generation": "{g1}"}, "expect_status": 404},
    {"name": "delete-live-match-g2", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"ifGenerationMatch": "{g2}"}, "expect_status": 204},
    {"name": "get-live-after-delete", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}", "expect_status": 404},
    {"name": "get-g2-noncurrent", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"generation": "{g2}", "fields": "name,size,timeDeleted"}, "expect_status": 200},
    {"name": "list-live-only", "method": "GET", "path": "/storage/v1/b/{bucket}/o", "query": {"prefix": "{object}", "fields": "items(name)"}, "expect_status": 200},
    {"name": "list-versions-noncurrent", "method": "GET", "path": "/storage/v1/b/{bucket}/o", "query": {"prefix": "{object}", "versions": "true", "fields": "items(name,size,timeDeleted)"}, "expect_status": 200},
    {"name": "copy-from-source-generation", "method": "POST", "path": "/storage/v1/b/{bucket}/o/{object}/copyTo/b/{bucket}/o/{object2}", "query": {"sourceGeneration": "{g2}", "fields": "name,size"}, "expect_status": 200},
    {"name": "copy-from-unknown-source-generation", "method": "POST", "path": "/storage/v1/b/{bucket}/o/{object}/copyTo/b/{bucket}/o/{object2}", "query": {"sourceGeneration": "1"}, "expect_status": 404},
    {"name": "cleanup-g2", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}", "query": {"generation": "{g2}"}, "compare": false},
    {"name": "cleanup-copy-live", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object2}", "compare": false},
    {"name": "disable-versioning", "method": "PATCH", "path": "/storage/v1/b/{bucket}", "query": {"fields": "name,versioning"}, "body": {"versioning": {"enabled": false}}, "expect_status": 200, "always": true}
  ]
}
