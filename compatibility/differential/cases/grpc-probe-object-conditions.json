{
  "id": "grpc-probe-object-conditions",
  "description": "Which Storage v2 object RPCs refuse a metageneration condition of 0 or a match together with a not-match, and which evaluate them, on the shared bucket. Three shapes per RPC: if_metageneration_match 0; a generation match together with a not-match; a metageneration match together with a not-match. GetObject and ReadObject send both pairs holding; DeleteObject, UpdateObject, a WriteObjectSpec, RewriteObject (destination and source conditions) and MoveObject (destination and source conditions) send pairs whose not-match names the current value, so an evaluated pair fails with FAILED_PRECONDITION, a refused one answers INVALID_ARGUMENT, and neither changes anything. ComposeObject has no not-match condition and asks only if_metageneration_match 0. RestoreObject asks the plain restore and the three shapes for a deleted generation in a bucket without soft delete, which shows whether condition validation comes before the soft delete check; GetObject then asks for that generation with soft_deleted, and for the live object with a restore_token, in the same bucket. The moves come last, because an applied move would remove the source. Asks the condition_validation cases of RPC-STORAGE-010, RPC-STORAGE-011 (delete_condition_validation), RPC-STORAGE-012, RPC-STORAGE-014, RPC-STORAGE-015, RPC-STORAGE-017, RPC-STORAGE-018, RPC-STORAGE-021 and RPC-STORAGE-024, and RPC-STORAGE-014 get_object_soft_deleted and get_object_restore_token_pinned (SPEC-GRPC-LOCAL-CHOICES, SPEC-GRPC-UNMODELED-SETTINGS).",
  "steps": [
    {"name": "write", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}", "contentType": "text/plain"}, "objectSize": "5"}, "checksummedData": {"content": "aGVsbG8="}, "finishWrite": true}], "capture": {"gen": "body:resource.generation"}, "compare": false, "expect_status": 0},
    {"name": "write-destination", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-dst", "contentType": "text/plain"}, "objectSize": "1"}, "checksummedData": {"content": "eA=="}, "finishWrite": true}], "capture": {"dgen": "body:resource.generation"}, "compare": false, "expect_status": 0},
    {"name": "get-metageneration-match-zero", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": "projects/_/buckets/{bucket}", "object": "{object}", "ifMetagenerationMatch": "0", "readMask": {"paths": ["name", "metageneration"]}}},
    {"name": "get-generation-match-and-not-match", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": "projects/_/buckets/{bucket}", "object": "{object}", "ifGenerationMatch": "{gen}", "ifGenerationNotMatch": "1", "readMask": {"paths": ["name", "metageneration"]}}},
    {"name": "get-metageneration-match-and-not-match", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": "projects/_/buckets/{bucket}", "object": "{object}", "ifMetagenerationMatch": "1", "ifMetagenerationNotMatch": "99", "readMask": {"paths": ["name", "metageneration"]}}},
    {"name": "read-metageneration-match-zero", "protocol": "grpc", "rpc": "google.storage.v2.Storage/ReadObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": "projects/_/buckets/{bucket}", "object": "{object}", "ifMetagenerationMatch": "0", "readMask": {"paths": ["checksummed_data.content", "metadata.name"]}}},
    {"name": "read-generation-match-and-not-match", "protocol": "grpc", "rpc": "google.storage.v2.Storage/ReadObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": "projects/_/buckets/{bucket}", "object": "{object}", "ifGenerationMatch": "{gen}", "ifGenerationNotMatch": "1", "readMask": {"paths": ["checksummed_data.content", "metadata.name"]}}},
    {"name": "read-metageneration-match-and-not-match", "protocol": "grpc", "rpc": "google.storage.v2.Storage/ReadObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": "projects/_/buckets/{bucket}", "object": "{object}", "ifMetagenerationMatch": "1", "ifMetagenerationNotMatch": "99", "readMask": {"paths": ["checksummed_data.content", "metadata.name"]}}},
    {"name": "delete-metageneration-match-zero", "protocol": "grpc", "rpc": "google.storage.v2.Storage/DeleteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": "projects/_/buckets/{bucket}", "object": "{object}", "ifMetagenerationMatch": "0"}},
    {"name": "delete-generation-match-and-not-match", "protocol": "grpc", "rpc": "google.storage.v2.Storage/DeleteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": "projects/_/buckets/{bucket}", "object": "{object}", "ifGenerationMatch": "{gen}", "ifGenerationNotMatch": "{gen}"}},
    {"name": "delete-metageneration-match-and-not-match", "protocol": "grpc", "rpc": "google.storage.v2.Storage/DeleteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": "projects/_/buckets/{bucket}", "object": "{object}", "ifMetagenerationMatch": "1", "ifMetagenerationNotMatch": "1"}},
    {"name": "update-metageneration-match-zero", "protocol": "grpc", "rpc": "google.storage.v2.Storage/UpdateObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"object": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}", "contentLanguage": "fr"}, "updateMask": {"paths": ["content_language"]}, "ifMetagenerationMatch": "0"}},
    {"name": "update-generation-match-and-not-match", "protocol": "grpc", "rpc": "google.storage.v2.Storage/UpdateObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"object": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}", "contentLanguage": "fr"}, "updateMask": {"paths": ["content_language"]}, "ifGenerationMatch": "{gen}", "ifGenerationNotMatch": "{gen}"}},
    {"name": "update-metageneration-match-and-not-match", "protocol": "grpc", "rpc": "google.storage.v2.Storage/UpdateObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"object": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}", "contentLanguage": "fr"}, "updateMask": {"paths": ["content_language"]}, "ifMetagenerationMatch": "1", "ifMetagenerationNotMatch": "1"}},
    {"name": "compose-metageneration-match-zero", "protocol": "grpc", "rpc": "google.storage.v2.Storage/ComposeObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"destination": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-dst"}, "sourceObjects": [{"name": "{object}"}], "ifMetagenerationMatch": "0"}},
    {"name": "rewrite-metageneration-match-zero", "protocol": "grpc", "rpc": "google.storage.v2.Storage/RewriteObject", "headers": {"x-goog-request-params": "source_bucket=projects%2F_%2Fbuckets%2F{bucket}&bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"destinationName": "{object}-dst", "destinationBucket": "projects/_/buckets/{bucket}", "sourceBucket": "projects/_/buckets/{bucket}", "sourceObject": "{object}", "ifMetagenerationMatch": "0"}},
    {"name": "rewrite-generation-match-and-not-match", "protocol": "grpc", "rpc": "google.storage.v2.Storage/RewriteObject", "headers": {"x-goog-request-params": "source_bucket=projects%2F_%2Fbuckets%2F{bucket}&bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"destinationName": "{object}-dst", "destinationBucket": "projects/_/buckets/{bucket}", "sourceBucket": "projects/_/buckets/{bucket}", "sourceObject": "{object}", "ifGenerationMatch": "{dgen}", "ifGenerationNotMatch": "{dgen}"}},
    {"name": "rewrite-metageneration-match-and-not-match", "protocol": "grpc", "rpc": "google.storage.v2.Storage/RewriteObject", "headers": {"x-goog-request-params": "source_bucket=projects%2F_%2Fbuckets%2F{bucket}&bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"destinationName": "{object}-dst", "destinationBucket": "projects/_/buckets/{bucket}", "sourceBucket": "projects/_/buckets/{bucket}", "sourceObject": "{object}", "ifMetagenerationMatch": "1", "ifMetagenerationNotMatch": "1"}},
    {"name": "rewrite-source-metageneration-match-zero", "protocol": "grpc", "rpc": "google.storage.v2.Storage/RewriteObject", "headers": {"x-goog-request-params": "source_bucket=projects%2F_%2Fbuckets%2F{bucket}&bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"destinationName": "{object}-dst", "destinationBucket": "projects/_/buckets/{bucket}", "sourceBucket": "projects/_/buckets/{bucket}", "sourceObject": "{object}", "ifSourceMetagenerationMatch": "0"}},
    {"name": "rewrite-source-generation-match-and-not-match", "protocol": "grpc", "rpc": "google.storage.v2.Storage/RewriteObject", "headers": {"x-goog-request-params": "source_bucket=projects%2F_%2Fbuckets%2F{bucket}&bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"destinationName": "{object}-dst", "destinationBucket": "projects/_/buckets/{bucket}", "sourceBucket": "projects/_/buckets/{bucket}", "sourceObject": "{object}", "ifSourceGenerationMatch": "{gen}", "ifSourceGenerationNotMatch": "{gen}"}},
    {"name": "rewrite-source-metageneration-match-and-not-match", "protocol": "grpc", "rpc": "google.storage.v2.Storage/RewriteObject", "headers": {"x-goog-request-params": "source_bucket=projects%2F_%2Fbuckets%2F{bucket}&bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"destinationName": "{object}-dst", "destinationBucket": "projects/_/buckets/{bucket}", "sourceBucket": "projects/_/buckets/{bucket}", "sourceObject": "{object}", "ifSourceMetagenerationMatch": "1", "ifSourceMetagenerationNotMatch": "1"}},
    {"name": "write-metageneration-match-zero", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}", "contentType": "text/plain"}, "ifMetagenerationMatch": "0", "objectSize": "1"}, "checksummedData": {"content": "eA=="}, "finishWrite": true}]},
    {"name": "write-generation-match-and-not-match", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}", "contentType": "text/plain"}, "ifGenerationMatch": "{gen}", "ifGenerationNotMatch": "{gen}", "objectSize": "1"}, "checksummedData": {"content": "eA=="}, "finishWrite": true}]},
    {"name": "write-metageneration-match-and-not-match", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}", "contentType": "text/plain"}, "ifMetagenerationMatch": "1", "ifMetagenerationNotMatch": "1", "objectSize": "1"}, "checksummedData": {"content": "eA=="}, "finishWrite": true}]},
    {"name": "write-restore-source", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-r", "contentType": "text/plain"}, "objectSize": "1"}, "checksummedData": {"content": "eA=="}, "finishWrite": true}], "capture": {"rgen": "body:resource.generation"}, "compare": false, "expect_status": 0},
    {"name": "delete-restore-source", "protocol": "grpc", "rpc": "google.storage.v2.Storage/DeleteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": "projects/_/buckets/{bucket}", "object": "{object}-r"}, "compare": false},
    {"name": "restore-without-soft-delete", "protocol": "grpc", "rpc": "google.storage.v2.Storage/RestoreObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": "projects/_/buckets/{bucket}", "object": "{object}-r", "generation": "{rgen}"}},
    {"name": "restore-metageneration-match-zero", "protocol": "grpc", "rpc": "google.storage.v2.Storage/RestoreObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": "projects/_/buckets/{bucket}", "object": "{object}-r", "generation": "{rgen}", "ifMetagenerationMatch": "0"}},
    {"name": "restore-generation-match-and-not-match", "protocol": "grpc", "rpc": "google.storage.v2.Storage/RestoreObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": "projects/_/buckets/{bucket}", "object": "{object}-r", "generation": "{rgen}", "ifGenerationMatch": "0", "ifGenerationNotMatch": "0"}},
    {"name": "restore-metageneration-match-and-not-match", "protocol": "grpc", "rpc": "google.storage.v2.Storage/RestoreObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": "projects/_/buckets/{bucket}", "object": "{object}-r", "generation": "{rgen}", "ifMetagenerationMatch": "1", "ifMetagenerationNotMatch": "1"}},
    {"name": "get-soft-deleted-without-soft-delete", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": "projects/_/buckets/{bucket}", "object": "{object}-r", "generation": "{rgen}", "softDeleted": true}},
    {"name": "get-restore-token", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": "projects/_/buckets/{bucket}", "object": "{object}", "restoreToken": "gcsmimic-probe", "readMask": {"paths": ["name", "metageneration"]}}},
    {"name": "move-metageneration-match-zero", "protocol": "grpc", "rpc": "google.storage.v2.Storage/MoveObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": "projects/_/buckets/{bucket}", "sourceObject": "{object}", "destinationObject": "{object}-dst", "ifMetagenerationMatch": "0"}},
    {"name": "move-generation-match-and-not-match", "protocol": "grpc", "rpc": "google.storage.v2.Storage/MoveObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": "projects/_/buckets/{bucket}", "sourceObject": "{object}", "destinationObject": "{object}-dst", "ifGenerationMatch": "{dgen}", "ifGenerationNotMatch": "{dgen}"}},
    {"name": "move-metageneration-match-and-not-match", "protocol": "grpc", "rpc": "google.storage.v2.Storage/MoveObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": "projects/_/buckets/{bucket}", "sourceObject": "{object}", "destinationObject": "{object}-dst", "ifMetagenerationMatch": "1", "ifMetagenerationNotMatch": "1"}},
    {"name": "move-source-metageneration-match-zero", "protocol": "grpc", "rpc": "google.storage.v2.Storage/MoveObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": "projects/_/buckets/{bucket}", "sourceObject": "{object}", "destinationObject": "{object}-dst", "ifSourceMetagenerationMatch": "0"}},
    {"name": "move-source-generation-match-and-not-match", "protocol": "grpc", "rpc": "google.storage.v2.Storage/MoveObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": "projects/_/buckets/{bucket}", "sourceObject": "{object}", "destinationObject": "{object}-dst", "ifSourceGenerationMatch": "{gen}", "ifSourceGenerationNotMatch": "{gen}"}},
    {"name": "move-source-metageneration-match-and-not-match", "protocol": "grpc", "rpc": "google.storage.v2.Storage/MoveObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": "projects/_/buckets/{bucket}", "sourceObject": "{object}", "destinationObject": "{object}-dst", "ifSourceMetagenerationMatch": "1", "ifSourceMetagenerationNotMatch": "1"}}
