{
  "id": "object-delete",
  "description": "Delete an object, read it afterwards and delete it again.",
  "steps": [
    {"name": "upload", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "media", "name": "{object}"}, "headers": {"Content-Type": "text/plain"}, "body_text": "hello", "compare": false, "expect_status": 200},
    {"name": "delete", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}", "expect_status": 204},
    {"name": "get-after-delete", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}", "expect_status": 404},
    {"name": "delete-again", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}", "expect_status": 404}
  ]
}
