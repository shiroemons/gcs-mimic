{
  "id": "grpc-probe-inferred-conditions",
  "description": "Storage v2 object conditions whose validation gcs-mimic decided by inference, on a bucket of its own with 5-byte and 1-byte objects. Negative values: if_generation_match -1, if_metageneration_match -1 and if_generation_not_match -1, one per step, on a non-resumable WriteObject of a new name, UpdateObject (content_language), GetObject, RewriteObject (destination conditions) and DeleteObject, and if_generation_match -1 and if_metageneration_match -1 on ComposeObject, which has no not-match condition; gcs-mimic answers INVALID_ARGUMENT, and no answer was recorded. The deletes come last and use an object of their own, since a not-match of -1 that is evaluated holds and deletes it. MoveObject with a match and a not-match of different values (every recorded pair had equal values, which Cloud Storage refused as conflicting preconditions): for the destination generation, the destination metageneration, the source generation and the source metageneration, first a pair whose match fails and whose not-match holds, from one source to an existing destination, then a pair where both hold, each moving a source of its own (the generation and metageneration pairs onto the existing destination, the source pairs to new names), so an evaluated pair moves it and a refused pair leaves it. Asks RPC-STORAGE-010, RPC-STORAGE-011, RPC-STORAGE-014, RPC-STORAGE-017, RPC-STORAGE-018, RPC-STORAGE-021 and RPC-STORAGE-024 condition validation (SPEC-GRPC-LOCAL-CHOICES).",
  "bucket": "own",
  "steps": [
    {"name": "write", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}", "contentType": "text/plain"}, "objectSize": "5"}, "checksummedData": {"content": "aGVsbG8="}, "finishWrite": true}], "compare": false, "expect_status": 0},
    {"name": "write-delete-target", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-delete", "contentType": "text/plain"}, "objectSize": "1"}, "checksummedData": {"content": "eA=="}, "finishWrite": true}], "compare": false, "expect_status": 0},
    {"name": "write-generation-match-negative", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-write", "contentType": "text/plain"}, "ifGenerationMatch": "-1", "objectSize": "1"}, "checksummedData": {"content": "eA=="}, "finishWrite": true}]},
    {"name": "write-metageneration-match-negative", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-write", "contentType": "text/plain"}, "ifMetagenerationMatch": "-1", "objectSize": "1"}, "checksummedData": {"content": "eA=="}, "finishWrite": true}]},
    {"name": "write-generation-not-match-negative", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-write", "contentType": "text/plain"}, "ifGenerationNotMatch": "-1", "objectSize": "1"}, "checksummedData": {"content": "eA=="}, "finishWrite": true}]},
    {"name": "update-generation-match-negative", "protocol": "grpc", "rpc": "google.storage.v2.Storage/UpdateObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"object": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}", "contentLanguage": "fr"}, "updateMask": {"paths": ["content_language"]}, "ifGenerationMatch": "-1"}},
    {"name": "update-metageneration-match-negative", "protocol": "grpc", "rpc": "google.storage.v2.Storage/UpdateObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"object": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}", "contentLanguage": "fr"}, "updateMask": {"paths": ["content_language"]}, "ifMetagenerationMatch": "-1"}},
    {"name": "update-generation-not-match-negative", "protocol": "grpc", "rpc": "google.storage.v2.Storage/UpdateObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"object": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}", "contentLanguage": "fr"}, "updateMask": {"paths": ["content_language"]}, "ifGenerationNotMatch": "-1"}},
    {"name": "get-generation-match-negative", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": "projects/_/buckets/{bucket}", "object": "{object}", "ifGenerationMatch": "-1", "readMask": {"paths": ["name", "size"]}}},
    {"name": "get-metageneration-match-negative", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": "projects/_/buckets/{bucket}", "object": "{object}", "ifMetagenerationMatch": "-1", "readMask": {"paths": ["name", "size"]}}},
    {"name": "get-generation-not-match-negative", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": "projects/_/buckets/{bucket}", "object": "{object}", "ifGenerationNotMatch": "-1", "readMask": {"paths": ["name", "size"]}}},
    {"name": "compose-generation-match-negative", "protocol": "grpc", "rpc": "google.storage.v2.Storage/ComposeObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"destination": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-compose"}, "sourceObjects": [{"name": "{object}"}], "ifGenerationMatch": "-1"}},
    {"name": "compose-metageneration-match-negative", "protocol": "grpc", "rpc": "google.storage.v2.Storage/ComposeObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"destination": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-compose"}, "sourceObjects": [{"name": "{object}"}], "ifMetagenerationMatch": "-1"}},
    {"name": "rewrite-generation-match-negative", "protocol": "grpc", "rpc": "google.storage.v2.Storage/RewriteObject", "headers": {"x-goog-request-params": "source_bucket=projects%2F_%2Fbuckets%2F{bucket}&bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"destinationName": "{object}-rewrite", "destinationBucket": "projects/_/buckets/{bucket}", "sourceBucket": "projects/_/buckets/{bucket}", "sourceObject": "{object}", "ifGenerationMatch": "-1"}},
    {"name": "rewrite-metageneration-match-negative", "protocol": "grpc", "rpc": "google.storage.v2.Storage/RewriteObject", "headers": {"x-goog-request-params": "source_bucket=projects%2F_%2Fbuckets%2F{bucket}&bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"destinationName": "{object}-rewrite", "destinationBucket": "projects/_/buckets/{bucket}", "sourceBucket": "projects/_/buckets/{bucket}", "sourceObject": "{object}", "ifMetagenerationMatch": "-1"}},
    {"name": "rewrite-generation-not-match-negative", "protocol": "grpc", "rpc": "google.storage.v2.Storage/RewriteObject", "headers": {"x-goog-request-params": "source_bucket=projects%2F_%2Fbuckets%2F{bucket}&bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"destinationName": "{object}-rewrite", "destinationBucket": "projects/_/buckets/{bucket}", "sourceBucket": "projects/_/buckets/{bucket}", "sourceObject": "{object}", "ifGenerationNotMatch": "-1"}},
    {"name": "delete-generation-match-negative", "protocol": "grpc", "rpc": "google.storage.v2.Storage/DeleteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": "projects/_/buckets/{bucket}", "object": "{object}-delete", "ifGenerationMatch": "-1"}},
    {"name": "delete-metageneration-match-negative", "protocol": "grpc", "rpc": "google.storage.v2.Storage/DeleteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": "projects/_/buckets/{bucket}", "object": "{object}-delete", "ifMetagenerationMatch": "-1"}},
    {"name": "delete-generation-not-match-negative", "protocol": "grpc", "rpc": "google.storage.v2.Storage/DeleteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": "projects/_/buckets/{bucket}", "object": "{object}-delete", "ifGenerationNotMatch": "-1"}},
    {"name": "write-move-source-a", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-move-a", "contentType": "text/plain"}, "objectSize": "1"}, "checksummedData": {"content": "YQ=="}, "finishWrite": true}], "compare": false, "expect_status": 0},
    {"name": "write-move-source-b", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-move-b", "contentType": "text/plain"}, "objectSize": "1"}, "checksummedData": {"content": "Yg=="}, "finishWrite": true}], "compare": false, "expect_status": 0},
    {"name": "write-move-source-c", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-move-c", "contentType": "text/plain"}, "objectSize": "1"}, "checksummedData": {"content": "Yw=="}, "finishWrite": true}], "capture": {"cgen": "body:resource.generation"}, "compare": false, "expect_status": 0},
    {"name": "write-move-source-d", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-move-d", "contentType": "text/plain"}, "objectSize": "1"}, "checksummedData": {"content": "ZA=="}, "finishWrite": true}], "compare": false, "expect_status": 0},
    {"name": "write-move-destination", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-move-dst", "contentType": "text/plain"}, "objectSize": "1"}, "checksummedData": {"content": "eA=="}, "finishWrite": true}], "capture": {"dgen": "body:resource.generation"}, "compare": false, "expect_status": 0},
    {"name": "move-generation-pair-match-failing", "protocol": "grpc", "rpc": "google.storage.v2.Storage/MoveObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": "projects/_/buckets/{bucket}", "sourceObject": "{object}-move-a", "destinationObject": "{object}-move-dst", "ifGenerationMatch": "1", "ifGenerationNotMatch": "2"}},
    {"name": "move-metageneration-pair-match-failing", "protocol": "grpc", "rpc": "google.storage.v2.Storage/MoveObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": "projects/_/buckets/{bucket}", "sourceObject": "{object}-move-a", "destinationObject": "{object}-move-dst", "ifMetagenerationMatch": "99", "ifMetagenerationNotMatch": "98"}},
    {"name": "move-source-generation-pair-match-failing", "protocol": "grpc", "rpc": "google.storage.v2.Storage/MoveObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": "projects/_/buckets/{bucket}", "sourceObject": "{object}-move-a", "destinationObject": "{object}-move-dst", "ifSourceGenerationMatch": "1", "ifSourceGenerationNotMatch": "2"}},
    {"name": "move-source-metageneration-pair-match-failing", "protocol": "grpc", "rpc": "google.storage.v2.Storage/MoveObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": "projects/_/buckets/{bucket}", "sourceObject": "{object}-move-a", "destinationObject": "{object}-move-dst", "ifSourceMetagenerationMatch": "99", "ifSourceMetagenerationNotMatch": "98"}},
    {"name": "move-generation-pair-holding", "protocol": "grpc", "rpc": "google.storage.v2.Storage/MoveObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": "projects/_/buckets/{bucket}", "sourceObject": "{object}-move-a", "destinationObject": "{object}-move-dst", "ifGenerationMatch": "{dgen}", "ifGenerationNotMatch": "1"}},
    {"name": "move-metageneration-pair-holding", "protocol": "grpc", "rpc": "google.storage.v2.Storage/MoveObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": "projects/_/buckets/{bucket}", "sourceObject": "{object}-move-b", "destinationObject": "{object}-move-dst", "ifMetagenerationMatch": "1", "ifMetagenerationNotMatch": "99"}},
    {"name": "move-source-generation-pair-holding", "protocol": "grpc", "rpc": "google.storage.v2.Storage/MoveObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": "projects/_/buckets/{bucket}", "sourceObject": "{object}-move-c", "destinationObject": "{object}-move-c-moved", "ifSourceGenerationMatch": "{cgen}", "ifSourceGenerationNotMatch": "1"}},
    {"name": "move-source-metageneration-pair-holding", "protocol": "grpc", "rpc": "google.storage.v2.Storage/MoveObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": "projects/_/buckets/{bucket}", "sourceObject": "{object}-move-d", "destinationObject": "{object}-move-d-moved", "ifSourceMetagenerationMatch": "1", "ifSourceMetagenerationNotMatch": "99"}}
  ]
}
