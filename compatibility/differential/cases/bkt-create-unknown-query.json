{
  "id": "bkt-create-unknown-query",
  "description": "Bucket creation with an undeclared query parameter. The bucket is deleted afterwards in case a side accepts it.",
  "bucket": false,
  "steps": [
    {"name":"unknown-query-parameter","method":"POST","path":"/storage/v1/b","query":{"project":"{project}","append":"false"},"body":{"name":"{new_bucket}","iamConfiguration":{"publicAccessPrevention":"enforced"},"softDeletePolicy":{"retentionDurationSeconds":"0"}},"expect_status":200},
    {"name":"cleanup","method":"DELETE","path":"/storage/v1/b/{new_bucket}","compare":false,"always":true}
  ]
}
