{
  "id": "grpc-probe-object-precedence",
  "description": "Which Storage v2 failure wins when one DeleteObject or ReadObject request has two, on the shared bucket. DeleteObject: a missing object with a failing generation condition, a missing generation of an existing object with a failing metageneration condition, and an object under a temporary hold with a failing condition and without one; the hold is released at the end. ReadObject: a missing object with a read mask that lacks checksummed_data.content, a missing object with a malformed customer-supplied key (31 bytes), and an existing object with a failing generation condition beside a read_offset past the end and beside a read mask that lacks checksummed_data.content. Asks RPC-STORAGE-011 delete_local_precedence and RPC-STORAGE-015 read_object_local_precedence (SPEC-GRPC-LOCAL-CHOICES).",
  "steps": [
    {"name": "write", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}", "contentType": "text/plain"}, "objectSize": "5"}, "checksummedData": {"content": "aGVsbG8="}, "finishWrite": true}], "compare": false, "expect_status": 0},
    {"name": "delete-missing-object-generation-match-failing", "protocol": "grpc", "rpc": "google.storage.v2.Storage/DeleteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": "projects/_/buckets/{bucket}", "object": "{object}-missing", "ifGenerationMatch": "1"}},
    {"name": "delete-missing-generation-metageneration-match-failing", "protocol": "grpc", "rpc": "google.storage.v2.Storage/DeleteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": "projects/_/buckets/{bucket}", "object": "{object}", "generation": "1", "ifMetagenerationMatch": "99"}},
    {"name": "set-temporary-hold", "protocol": "grpc", "rpc": "google.storage.v2.Storage/UpdateObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"object": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}", "temporaryHold": true}, "updateMask": {"paths": ["temporary_hold"]}}, "compare": false},
    {"name": "delete-held-metageneration-match-failing", "protocol": "grpc", "rpc": "google.storage.v2.Storage/DeleteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": "projects/_/buckets/{bucket}", "object": "{object}", "ifMetagenerationMatch": "99"}},
    {"name": "delete-held", "protocol": "grpc", "rpc": "google.storage.v2.Storage/DeleteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": "projects/_/buckets/{bucket}", "object": "{object}"}},
    {"name": "release-temporary-hold", "protocol": "grpc", "rpc": "google.storage.v2.Storage/UpdateObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"object": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}", "temporaryHold": false}, "updateMask": {"paths": ["temporary_hold"]}}, "compare": false, "always": true},
    {"name": "read-missing-mask-without-content", "protocol": "grpc", "rpc": "google.storage.v2.Storage/ReadObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": "projects/_/buckets/{bucket}", "object": "{object}-missing", "readMask": {"paths": ["metadata.name"]}}},
    {"name": "read-missing-malformed-key", "protocol": "grpc", "rpc": "google.storage.v2.Storage/ReadObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": "projects/_/buckets/{bucket}", "object": "{object}-missing", "commonObjectRequestParams": {"encryptionAlgorithm": "AES256", "encryptionKeyBytes": "AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQ==", "encryptionKeySha256Bytes": "zF9s8y82Hp+1BQbHCoZsJb9ZVv8JXNXJaOuxTyJBKmM="}}},
    {"name": "read-generation-match-failing-offset-past-end", "protocol": "grpc", "rpc": "google.storage.v2.Storage/ReadObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": "projects/_/buckets/{bucket}", "object": "{object}", "ifGenerationMatch": "1", "readOffset": "99"}},
    {"name": "read-generation-match-failing-mask-without-content", "protocol": "grpc", "rpc": "google.storage.v2.Storage/ReadObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": "projects/_/buckets/{bucket}", "object": "{object}", "ifGenerationMatch": "1", "readMask": {"paths": ["metadata.name"]}}}
  ]
}
