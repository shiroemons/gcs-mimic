{
  "id": "obj-probe-upload-hashes",
  "description": "Checksum headers the earlier upload cases left out. A JSON media upload with only a wrong and with only a correct Content-MD5. X-Goog-Hash (correct and wrong, crc32c and md5) on a resumable initiation, each session then finished by one 5-byte request without the header. The same four values on the single final request of sessions started without one. Two-chunk sessions (256 KiB of a, then hello) whose final request names the crc32c of the whole object (ySLq0Q==) or of the final chunk alone (mnG7TA==), which tells whether the final request's hash covers the object. Checks SPEC-010.",
  "steps": [
    {"name": "media-content-md5-wrong", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "media", "name": "{object}-cmd5-wrong"}, "headers": {"Content-Type": "text/plain", "Content-MD5": "AAAAAAAAAAAAAAAAAAAAAA=="}, "body_text": "hello"},
    {"name": "media-content-md5-ok", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "media", "name": "{object}-cmd5-ok"}, "headers": {"Content-Type": "text/plain", "Content-MD5": "XUFAKrxLKna5cZ2REBfFkg=="}, "body_text": "hello", "expect_status": 200},
    {"name": "init-crc32c-ok", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "name": "{object}-init-crc32c-ok"}, "headers": {"Content-Type": "application/json", "X-Goog-Hash": "crc32c=mnG7TA=="}, "body": {"contentType": "text/plain"}, "capture": {"ic1": "header:location?upload_id"}},
    {"name": "init-crc32c-ok-final", "method": "PUT", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "upload_id": "{ic1}"}, "headers": {"Content-Range": "bytes 0-4/5"}, "body_text": "hello"},
    {"name": "init-crc32c-wrong", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "name": "{object}-init-crc32c-wrong"}, "headers": {"Content-Type": "application/json", "X-Goog-Hash": "crc32c=AAAAAA=="}, "body": {"contentType": "text/plain"}, "capture": {"ic2": "header:location?upload_id"}},
    {"name": "init-crc32c-wrong-final", "method": "PUT", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "upload_id": "{ic2}"}, "headers": {"Content-Range": "bytes 0-4/5"}, "body_text": "hello"},
    {"name": "init-md5-ok", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "name": "{object}-init-md5-ok"}, "headers": {"Content-Type": "application/json", "X-Goog-Hash": "md5=XUFAKrxLKna5cZ2REBfFkg=="}, "body": {"contentType": "text/plain"}, "capture": {"ic3": "header:location?upload_id"}},
    {"name": "init-md5-ok-final", "method": "PUT", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "upload_id": "{ic3}"}, "headers": {"Content-Range": "bytes 0-4/5"}, "body_text": "hello"},
    {"name": "init-md5-wrong", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "name": "{object}-init-md5-wrong"}, "headers": {"Content-Type": "application/json", "X-Goog-Hash": "md5=AAAAAAAAAAAAAAAAAAAAAA=="}, "body": {"contentType": "text/plain"}, "capture": {"ic4": "header:location?upload_id"}},
    {"name": "init-md5-wrong-final", "method": "PUT", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "upload_id": "{ic4}"}, "headers": {"Content-Range": "bytes 0-4/5"}, "body_text": "hello"},
    {"name": "final-crc32c-ok-start", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "name": "{object}-final-crc32c-ok"}, "headers": {"Content-Type": "application/json"}, "body": {"contentType": "text/plain"}, "capture": {"fc1": "header:location?upload_id"}, "compare": false, "expect_status": 200},
    {"name": "final-crc32c-ok", "method": "PUT", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "upload_id": "{fc1}"}, "headers": {"Content-Range": "bytes 0-4/5", "X-Goog-Hash": "crc32c=mnG7TA=="}, "body_text": "hello"},
    {"name": "final-crc32c-wrong-start", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "name": "{object}-final-crc32c-wrong"}, "headers": {"Content-Type": "application/json"}, "body": {"contentType": "text/plain"}, "capture": {"fc2": "header:location?upload_id"}, "compare": false, "expect_status": 200},
    {"name": "final-crc32c-wrong", "method": "PUT", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "upload_id": "{fc2}"}, "headers": {"Content-Range": "bytes 0-4/5", "X-Goog-Hash": "crc32c=AAAAAA=="}, "body_text": "hello"},
    {"name": "final-md5-ok-start", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "name": "{object}-final-md5-ok"}, "headers": {"Content-Type": "application/json"}, "body": {"contentType": "text/plain"}, "capture": {"fc3": "header:location?upload_id"}, "compare": false, "expect_status": 200},
    {"name": "final-md5-ok", "method": "PUT", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "upload_id": "{fc3}"}, "headers": {"Content-Range": "bytes 0-4/5", "X-Goog-Hash": "md5=XUFAKrxLKna5cZ2REBfFkg=="}, "body_text": "hello"},
    {"name": "final-md5-wrong-start", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "name": "{object}-final-md5-wrong"}, "headers": {"Content-Type": "application/json"}, "body": {"contentType": "text/plain"}, "capture": {"fc4": "header:location?upload_id"}, "compare": false, "expect_status": 200},
    {"name": "final-md5-wrong", "method": "PUT", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "upload_id": "{fc4}"}, "headers": {"Content-Range": "bytes 0-4/5", "X-Goog-Hash": "md5=AAAAAAAAAAAAAAAAAAAAAA=="}, "body_text": "hello"},
    {"name": "two-chunk-object-crc32c-start", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "name": "{object}-two-chunk-object"}, "headers": {"Content-Type": "application/json"}, "body": {"contentType": "text/plain"}, "capture": {"tc1": "header:location?upload_id"}, "compare": false, "expect_status": 200},
    {"name": "two-chunk-object-crc32c-first", "method": "PUT", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "upload_id": "{tc1}"}, "headers": {"Content-Range": "bytes 0-262143/*"}, "body_repeat": {"text": "a", "times": 262144}, "expect_status": 308},
    {"name": "two-chunk-object-crc32c-final", "method": "PUT", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "upload_id": "{tc1}"}, "headers": {"Content-Range": "bytes 262144-262148/262149", "X-Goog-Hash": "crc32c=ySLq0Q=="}, "body_text": "hello"},
    {"name": "two-chunk-last-chunk-crc32c-start", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "name": "{object}-two-chunk-last"}, "headers": {"Content-Type": "application/json"}, "body": {"contentType": "text/plain"}, "capture": {"tc2": "header:location?upload_id"}, "compare": false, "expect_status": 200},
    {"name": "two-chunk-last-chunk-crc32c-first", "method": "PUT", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "upload_id": "{tc2}"}, "headers": {"Content-Range": "bytes 0-262143/*"}, "body_repeat": {"text": "a", "times": 262144}, "expect_status": 308},
    {"name": "two-chunk-last-chunk-crc32c-final", "method": "PUT", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "resumable", "upload_id": "{tc2}"}, "headers": {"Content-Range": "bytes 262144-262148/262149", "X-Goog-Hash": "crc32c=mnG7TA=="}, "body_text": "hello"},
    {"name": "cleanup-cmd5-wrong", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-cmd5-wrong", "compare": false, "always": true},
    {"name": "cleanup-cmd5-ok", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-cmd5-ok", "compare": false, "always": true},
    {"name": "cleanup-init-crc32c-ok", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-init-crc32c-ok", "compare": false, "always": true},
    {"name": "cleanup-init-crc32c-wrong", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-init-crc32c-wrong", "compare": false, "always": true},
    {"name": "cleanup-init-md5-ok", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-init-md5-ok", "compare": false, "always": true},
    {"name": "cleanup-init-md5-wrong", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-init-md5-wrong", "compare": false, "always": true},
    {"name": "cleanup-final-crc32c-ok", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-final-crc32c-ok", "compare": false, "always": true},
    {"name": "cleanup-final-crc32c-wrong", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-final-crc32c-wrong", "compare": false, "always": true},
    {"name": "cleanup-final-md5-ok", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-final-md5-ok", "compare": false, "always": true},
    {"name": "cleanup-final-md5-wrong", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-final-md5-wrong", "compare": false, "always": true},
    {"name": "cleanup-two-chunk-object", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-two-chunk-object", "compare": false, "always": true},
    {"name": "cleanup-two-chunk-last", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}-two-chunk-last", "compare": false, "always": true}
  ]
}
