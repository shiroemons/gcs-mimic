{
  "id": "bkt-patch-put-edges",
  "description": "PATCH and PUT edge inputs on a fresh multi-region bucket created with a lowercase location: empty body, unknown and output-only fields, null and empty values per field, retention and soft delete set and cleared (never locked), projection=full, fields, predefined ACLs (non-public), and PUT omission semantics.",
  "bucket": false,
  "steps": [
    {"name": "create-multi-region", "method": "POST", "path": "/storage/v1/b", "query": {"project": "{project}"}, "body": {"name": "{new_bucket}", "location": "us", "softDeletePolicy": {"retentionDurationSeconds": "0"}, "iamConfiguration": {"publicAccessPrevention": "enforced"}}, "capture": {"mg": "body:metageneration"}, "expect_status": 200},
    {"name": "patch-empty-body", "method": "PATCH", "path": "/storage/v1/b/{new_bucket}", "body": {}, "expect_status": 200},
    {"name": "patch-unknown-field", "method": "PATCH", "path": "/storage/v1/b/{new_bucket}", "body": {"noSuchField": "x"}, "expect_status": 200},
    {"name": "patch-output-only-fields", "method": "PATCH", "path": "/storage/v1/b/{new_bucket}", "body": {"id": "other", "selfLink": "https://example.invalid/b", "projectNumber": "1", "timeCreated": "2000-01-01T00:00:00Z", "metageneration": "99", "location": "EU"}, "expect_status": 400},
    {"name": "set-labels-and-versioning", "method": "PATCH", "path": "/storage/v1/b/{new_bucket}", "body": {"labels": {"a": "1", "b": "2"}, "versioning": {"enabled": true}}, "expect_status": 200},
    {"name": "versioning-empty-object", "method": "PATCH", "path": "/storage/v1/b/{new_bucket}", "body": {"versioning": {}}, "expect_status": 200},
    {"name": "versioning-null", "method": "PATCH", "path": "/storage/v1/b/{new_bucket}", "body": {"versioning": null}, "expect_status": 400},
    {"name": "labels-null", "method": "PATCH", "path": "/storage/v1/b/{new_bucket}", "body": {"labels": null}, "expect_status": 200},
    {"name": "labels-empty-object", "method": "PATCH", "path": "/storage/v1/b/{new_bucket}", "body": {"labels": {}}, "expect_status": 200},
    {"name": "storage-class-null", "method": "PATCH", "path": "/storage/v1/b/{new_bucket}", "body": {"storageClass": null}, "expect_status": 400},
    {"name": "storage-class-nearline", "method": "PATCH", "path": "/storage/v1/b/{new_bucket}", "body": {"storageClass": "NEARLINE"}, "expect_status": 200},
    {"name": "retention-set", "method": "PATCH", "path": "/storage/v1/b/{new_bucket}", "body": {"retentionPolicy": {"retentionPeriod": "3600"}}, "expect_status": 200},
    {"name": "retention-get", "method": "GET", "path": "/storage/v1/b/{new_bucket}", "query": {"fields": "retentionPolicy"}, "expect_status": 200},
    {"name": "retention-empty-object", "method": "PATCH", "path": "/storage/v1/b/{new_bucket}", "body": {"retentionPolicy": {}}, "expect_status": 200},
    {"name": "retention-null", "method": "PATCH", "path": "/storage/v1/b/{new_bucket}", "body": {"retentionPolicy": null}, "expect_status": 200},
    {"name": "retention-get-after-null", "method": "GET", "path": "/storage/v1/b/{new_bucket}", "query": {"fields": "retentionPolicy"}, "expect_status": 200},
    {"name": "soft-delete-set-30-days", "method": "PATCH", "path": "/storage/v1/b/{new_bucket}", "body": {"softDeletePolicy": {"retentionDurationSeconds": "2592000"}}, "expect_status": 200},
    {"name": "soft-delete-null", "method": "PATCH", "path": "/storage/v1/b/{new_bucket}", "body": {"softDeletePolicy": null}, "expect_status": 200},
    {"name": "soft-delete-get-after-null", "method": "GET", "path": "/storage/v1/b/{new_bucket}", "query": {"fields": "softDeletePolicy"}, "expect_status": 200},
    {"name": "soft-delete-zero", "method": "PATCH", "path": "/storage/v1/b/{new_bucket}", "body": {"softDeletePolicy": {"retentionDurationSeconds": "0"}, "iamConfiguration": {"publicAccessPrevention": "enforced"}}, "capture": {"mg": "body:metageneration"}, "expect_status": 200},
    {"name": "lifecycle-set", "method": "PATCH", "path": "/storage/v1/b/{new_bucket}", "body": {"lifecycle": {"rule": [{"action": {"type": "Delete"}, "condition": {"age": 10}}]}}, "expect_status": 200},
    {"name": "lifecycle-empty-rule-array", "method": "PATCH", "path": "/storage/v1/b/{new_bucket}", "body": {"lifecycle": {"rule": []}}, "expect_status": 200},
    {"name": "lifecycle-get-after-empty", "method": "GET", "path": "/storage/v1/b/{new_bucket}", "query": {"fields": "lifecycle"}, "expect_status": 200},
    {"name": "lifecycle-null", "method": "PATCH", "path": "/storage/v1/b/{new_bucket}", "body": {"lifecycle": null}, "expect_status": 200},
    {"name": "cors-set", "method": "PATCH", "path": "/storage/v1/b/{new_bucket}", "body": {"cors": [{"origin": ["https://example.com"], "method": ["GET"]}]}, "expect_status": 200},
    {"name": "cors-empty-array", "method": "PATCH", "path": "/storage/v1/b/{new_bucket}", "body": {"cors": []}, "expect_status": 200},
    {"name": "cors-get-after-empty", "method": "GET", "path": "/storage/v1/b/{new_bucket}", "query": {"fields": "cors"}, "expect_status": 200},
    {"name": "cors-null", "method": "PATCH", "path": "/storage/v1/b/{new_bucket}", "body": {"cors": null}, "expect_status": 200},
    {"name": "iam-configuration-empty", "method": "PATCH", "path": "/storage/v1/b/{new_bucket}", "body": {"iamConfiguration": {}}, "expect_status": 200},
    {"name": "iam-configuration-null", "method": "PATCH", "path": "/storage/v1/b/{new_bucket}", "body": {"iamConfiguration": null}, "expect_status": 400},
    {"name": "predefined-acls-full", "method": "PATCH", "path": "/storage/v1/b/{new_bucket}", "query": {"predefinedAcl": "private", "predefinedDefaultObjectAcl": "projectPrivate", "projection": "full"}, "body": {"labels": {"c": "3"}}, "expect_status": 400},
    {"name": "invalid-predefined-acl", "method": "PATCH", "path": "/storage/v1/b/{new_bucket}", "query": {"predefinedAcl": "notACannedAcl"}, "body": {}, "expect_status": 400},
    {"name": "patch-fields", "method": "PATCH", "path": "/storage/v1/b/{new_bucket}", "query": {"fields": "name,metageneration,labels"}, "body": {"labels": {"d": "4"}}, "expect_status": 200},
    {"name": "prepare-non-default-state", "method": "PATCH", "path": "/storage/v1/b/{new_bucket}", "body": {"versioning": {"enabled": true}, "lifecycle": {"rule": [{"action": {"type": "Delete"}, "condition": {"age": 10}}]}, "cors": [{"origin": ["https://example.com"], "method": ["GET"]}], "retentionPolicy": {"retentionPeriod": "3600"}, "labels": {"keep": "me"}}, "compare": false, "expect_status": 200},
    {"name": "put-name-only", "method": "PUT", "path": "/storage/v1/b/{new_bucket}", "body": {"name": "{new_bucket}"}, "expect_status": 200},
    {"name": "get-after-put-name-only", "method": "GET", "path": "/storage/v1/b/{new_bucket}", "query": {"projection": "full"}, "expect_status": 200},
    {"name": "put-with-class-labels-versioning", "method": "PUT", "path": "/storage/v1/b/{new_bucket}", "query": {"predefinedAcl": "private", "predefinedDefaultObjectAcl": "projectPrivate"}, "body": {"name": "{new_bucket}", "storageClass": "COLDLINE", "labels": {"e": "5"}, "versioning": {"enabled": true}}, "expect_status": 400},
    {"name": "put-unknown-field", "method": "PUT", "path": "/storage/v1/b/{new_bucket}", "body": {"name": "{new_bucket}", "noSuchField": "x"}, "expect_status": 200},
    {"name": "put-null-labels", "method": "PUT", "path": "/storage/v1/b/{new_bucket}", "body": {"name": "{new_bucket}", "labels": null}, "expect_status": 200},
    {"name": "put-fields", "method": "PUT", "path": "/storage/v1/b/{new_bucket}", "query": {"fields": "name,storageClass,versioning"}, "body": {"name": "{new_bucket}"}, "expect_status": 200},
    {"name": "get-final", "method": "GET", "path": "/storage/v1/b/{new_bucket}", "expect_status": 200},
    {"name": "delete", "method": "DELETE", "path": "/storage/v1/b/{new_bucket}", "expect_status": 204}
  ]
}
