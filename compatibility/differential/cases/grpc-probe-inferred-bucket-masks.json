{
  "id": "grpc-probe-inferred-bucket-masks",
  "description": "Storage v2 UpdateBucket and GetBucket answers that gcs-mimic decided by inference, on an empty bucket of its own. UpdateBucket update_mask paths, one per step with a value in the request bucket: the OUTPUT_ONLY bucket fields other than the recorded create_time and update_time (bucket_id set to the bucket's own ID, metageneration 7, location_type dual-region, owner user-gcsmimic-probe), the immutable project and location set to the values GetBucket reported (the project as read back, the location us-central1 the harness created the bucket in), the identifier name, and etag set to the current etag so the precondition holds. if_metageneration_not_match equal to the current metageneration, read by GetBucket first, on GetBucket and on UpdateBucket (only the DeleteBucket answer was recorded). Nested update paths that name no member: versioning.no_such_field, iam_config.no_such_field and labels. (an empty label key); the request bucket carries versioning off, public access prevention enforced and the harness label, so a path read as its whole parent field changes nothing the cleanup needs. The UpdateBucket steps that may apply change only the label probe, and a final JSON PATCH enforces public access prevention and keeps the harness label even when an earlier step failed. Asks RPC-STORAGE-002 grpc_bucket_get_condition_validation, RPC-STORAGE-009 grpc_bucket_update_condition_validation and its update mask paths, and BEHAVIOR-RPC-002 grpc_masks_nested_paths and grpc_masks_output_only_update_paths (SPEC-GRPC-LOCAL-CHOICES).",
  "bucket": "own",
  "steps": [
    {"name": "get-bucket", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"name": "projects/_/buckets/{bucket}", "readMask": {"paths": ["etag", "metageneration", "project", "location"]}}, "capture": {"etag": "body:etag", "bproject": "body:project"}, "expect_status": 0},
    {"name": "update-mask-etag", "protocol": "grpc", "rpc": "google.storage.v2.Storage/UpdateBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": {"name": "projects/_/buckets/{bucket}", "etag": "{etag}"}, "updateMask": {"paths": ["etag"]}}},
    {"name": "update-mask-bucket-id", "protocol": "grpc", "rpc": "google.storage.v2.Storage/UpdateBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": {"name": "projects/_/buckets/{bucket}", "bucketId": "{bucket}"}, "updateMask": {"paths": ["bucket_id"]}}},
    {"name": "update-mask-metageneration", "protocol": "grpc", "rpc": "google.storage.v2.Storage/UpdateBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": {"name": "projects/_/buckets/{bucket}", "metageneration": "7"}, "updateMask": {"paths": ["metageneration"]}}},
    {"name": "update-mask-location-type", "protocol": "grpc", "local_choice": {"reason": "Cloud Storage raised the bucket metageneration from 1 to 2 on this step, which asks for an output-only location_type and so a no-op, after the no-op masks etag, bucket_id and metageneration left it at 1. The request's location_type, dual-region, differed from the stored region, but a differing value does not explain the raise: the metageneration step before it sent 7 against the stored 1, and the owner step after it sent an owner entity other than the stored one, and neither raised the metageneration. gcs-mimic changes the metageneration only when an update changes a setting, and no recording explains what moved it here (SPEC-GRPC-LOCAL-CHOICES).", "mimic_status": 0},"rpc": "google.storage.v2.Storage/UpdateBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": {"name": "projects/_/buckets/{bucket}", "locationType": "dual-region"}, "updateMask": {"paths": ["location_type"]}}},
    {"name": "update-mask-owner", "protocol": "grpc", "compare": {"ignore_body_paths": ["$.metageneration"]},"rpc": "google.storage.v2.Storage/UpdateBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": {"name": "projects/_/buckets/{bucket}", "owner": {"entity": "user-gcsmimic-probe"}}, "updateMask": {"paths": ["owner"]}}},
    {"name": "update-mask-project", "protocol": "grpc", "compare": {"ignore_body_paths": ["$.metageneration"]},"rpc": "google.storage.v2.Storage/UpdateBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": {"name": "projects/_/buckets/{bucket}", "project": "{bproject}"}, "updateMask": {"paths": ["project"]}}},
    {"name": "update-mask-location", "protocol": "grpc", "compare": {"ignore_body_paths": ["$.metageneration"]},"rpc": "google.storage.v2.Storage/UpdateBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": {"name": "projects/_/buckets/{bucket}", "location": "US-CENTRAL1"}, "updateMask": {"paths": ["location"]}}},
    {"name": "update-mask-name", "protocol": "grpc", "compare": {"ignore_body_paths": ["$.metageneration"]},"rpc": "google.storage.v2.Storage/UpdateBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": {"name": "projects/_/buckets/{bucket}"}, "updateMask": {"paths": ["name"]}}},
    {"name": "get-metageneration", "protocol": "grpc", "compare": {"ignore_body_paths": ["$.metageneration"]},"rpc": "google.storage.v2.Storage/GetBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"name": "projects/_/buckets/{bucket}", "readMask": {"paths": ["name", "metageneration"]}}, "capture": {"mg": "body:metageneration"}, "expect_status": 0},
    {"name": "get-not-match-current", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"name": "projects/_/buckets/{bucket}", "ifMetagenerationNotMatch": "{mg}", "readMask": {"paths": ["name", "metageneration"]}}},
    {"name": "update-not-match-current", "protocol": "grpc", "rpc": "google.storage.v2.Storage/UpdateBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": {"name": "projects/_/buckets/{bucket}", "labels": {"probe": "not-match-current"}}, "updateMask": {"paths": ["labels.probe"]}, "ifMetagenerationNotMatch": "{mg}"}},
    {"name": "update-mask-versioning-unknown-member", "protocol": "grpc", "rpc": "google.storage.v2.Storage/UpdateBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": {"name": "projects/_/buckets/{bucket}", "versioning": {}}, "updateMask": {"paths": ["versioning.no_such_field"]}}},
    {"name": "update-mask-iam-config-unknown-member", "protocol": "grpc", "rpc": "google.storage.v2.Storage/UpdateBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": {"name": "projects/_/buckets/{bucket}", "iamConfig": {"publicAccessPrevention": "enforced"}}, "updateMask": {"paths": ["iam_config.no_such_field"]}}},
    {"name": "update-mask-labels-empty-key", "protocol": "grpc", "rpc": "google.storage.v2.Storage/UpdateBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": {"name": "projects/_/buckets/{bucket}", "labels": {"gcs-mimic-differential": "1", "probe": "empty-key"}}, "updateMask": {"paths": ["labels."]}}},
    {"name": "restore-settings", "method": "PATCH", "path": "/storage/v1/b/{bucket}", "query": {"fields": "name"}, "body": {"iamConfiguration": {"publicAccessPrevention": "enforced"}, "labels": {"gcs-mimic-differential": "1"}}, "compare": false, "always": true}
  ]
}
