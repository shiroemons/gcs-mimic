{
  "id": "obj-probe-undeclared-query-acls",
  "description": "The undeclared query parameter gcsmimicUnknown=1 on the object ACL get, patch, update, delete and insert of the project-viewers entity (never a public entity), followed by a plain listing that shows which changes took effect, and on the bucket ACL and default object ACL list and get of the shared bucket. Checks SPEC-JSON-UNKNOWN-QUERY-OBJECTS.",
  "steps": [
    {"name": "bucket-project-number", "method": "GET", "path": "/storage/v1/b/{bucket}", "query": {"fields": "projectNumber"}, "capture": {"pn": "body:projectNumber"}, "compare": false, "expect_status": 200},
    {"name": "upload", "method": "POST", "path": "/upload/storage/v1/b/{bucket}/o", "query": {"uploadType": "media", "name": "{object}"}, "headers": {"Content-Type": "text/plain"}, "body_text": "hello", "compare": false, "expect_status": 200},
    {"name": "object-acl-get", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}/acl/project-viewers-{pn}", "query": {"gcsmimicUnknown": "1"}},
    {"name": "object-acl-patch", "method": "PATCH", "path": "/storage/v1/b/{bucket}/o/{object}/acl/project-viewers-{pn}", "query": {"gcsmimicUnknown": "1"}, "body": {"role": "OWNER"}},
    {"name": "object-acl-update", "method": "PUT", "path": "/storage/v1/b/{bucket}/o/{object}/acl/project-viewers-{pn}", "query": {"gcsmimicUnknown": "1"}, "body": {"entity": "project-viewers-{pn}", "role": "READER"}},
    {"name": "object-acl-delete", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}/acl/project-viewers-{pn}", "query": {"gcsmimicUnknown": "1"}},
    {"name": "object-acl-list-after-delete", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}/acl", "expect_status": 200},
    {"name": "object-acl-insert", "method": "POST", "path": "/storage/v1/b/{bucket}/o/{object}/acl", "query": {"gcsmimicUnknown": "1"}, "body": {"entity": "project-viewers-{pn}", "role": "READER"}},
    {"name": "object-acl-list-after-insert", "method": "GET", "path": "/storage/v1/b/{bucket}/o/{object}/acl", "expect_status": 200},
    {"name": "bucket-acl-list", "method": "GET", "path": "/storage/v1/b/{bucket}/acl", "query": {"gcsmimicUnknown": "1"}},
    {"name": "bucket-acl-get", "method": "GET", "path": "/storage/v1/b/{bucket}/acl/project-viewers-{pn}", "query": {"gcsmimicUnknown": "1"}},
    {"name": "default-acl-list", "method": "GET", "path": "/storage/v1/b/{bucket}/defaultObjectAcl", "query": {"gcsmimicUnknown": "1"}},
    {"name": "default-acl-get", "method": "GET", "path": "/storage/v1/b/{bucket}/defaultObjectAcl/project-viewers-{pn}", "query": {"gcsmimicUnknown": "1"}},
    {"name": "cleanup", "method": "DELETE", "path": "/storage/v1/b/{bucket}/o/{object}", "compare": false, "always": true}
  ]
}
