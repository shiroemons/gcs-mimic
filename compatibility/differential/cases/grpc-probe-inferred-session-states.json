{
  "id": "grpc-probe-inferred-session-states",
  "description": "Storage v2 resumable session states and resumable check order that gcs-mimic decided by inference, on a bucket of its own, each question on a session of its own and every object at most 5 bytes. Terminated session: after a finishing message whose 3 bytes miss the session's object_size of 5 (recorded: OUT_OF_RANGE, then QueryWriteStatus answered that the upload was terminated), a resumed WriteObject of 5 bytes without and then with finish_write, CancelResumableWrite, and QueryWriteStatus after the cancel. Cancelled session: a resumed WriteObject of 5 bytes without finish_write (only the finishing write was recorded). Non-resumable: a first message with both write_offset 2 and 5 bytes past an object_size of 3, to see which refusal wins. Resumable check order: sessions start with if_generation_match 0 while the object is missing, then the object is written, so the condition fails only when the message arrives; the case asks the failing condition alone, beside a wrong data crc32c, beside a first write_offset of 5 past the persisted 0, and beside 5 bytes past an object_size of 3; then, on sessions without a condition, a wrong data crc32c beside 5 bytes past an object_size of 3, and a 3-byte object_checksums.md5_hash beside a first write_offset of 5 (the non-resumable order was recorded in grpc-probe-write-streams; the resumable one is inferred). object_checksums on a non-final message: a stream whose only message declares a crc32c of 1 without data or finish_write, QueryWriteStatus, then a stream that finishes with 5 bytes the declared crc32c does not match; and one stream with both messages, then QueryWriteStatus, to show whether the mismatch is answered at the declaring message or at finish_write and with which status. Session starts capture the upload_id and are not compared. Asks RPC-STORAGE-013, RPC-STORAGE-018, RPC-STORAGE-023 and BEHAVIOR-RPC-003 (SPEC-GRPC-LOCAL-CHOICES).",
  "bucket": "own",
  "steps": [
    {"name": "start-terminated", "protocol": "grpc", "rpc": "google.storage.v2.Storage/StartResumableWrite", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-terminated", "contentType": "text/plain"}, "objectSize": "5"}}, "capture": {"terminated": "body:uploadId"}, "compare": false, "expect_status": 0},
    {"name": "terminate-below-object-size", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"uploadId": "{terminated}", "writeOffset": "0", "checksummedData": {"content": "YWJj"}, "finishWrite": true}]},
    {"name": "terminated-write-without-finish", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"uploadId": "{terminated}", "writeOffset": "0", "checksummedData": {"content": "aGVsbG8="}}]},
    {"name": "terminated-write-finish", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"uploadId": "{terminated}", "writeOffset": "0", "checksummedData": {"content": "aGVsbG8="}, "finishWrite": true}]},
    {"name": "terminated-cancel", "protocol": "grpc", "rpc": "google.storage.v2.Storage/CancelResumableWrite", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"uploadId": "{terminated}"}},
    {"name": "terminated-status-after-cancel", "protocol": "grpc", "rpc": "google.storage.v2.Storage/QueryWriteStatus", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"uploadId": "{terminated}"}},
    {"name": "start-cancelled", "protocol": "grpc", "rpc": "google.storage.v2.Storage/StartResumableWrite", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-cancelled", "contentType": "text/plain"}}}, "capture": {"cancelled": "body:uploadId"}, "compare": false, "expect_status": 0},
    {"name": "cancel", "protocol": "grpc", "rpc": "google.storage.v2.Storage/CancelResumableWrite", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"uploadId": "{cancelled}"}},
    {"name": "cancelled-write-without-finish", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"uploadId": "{cancelled}", "writeOffset": "0", "checksummedData": {"content": "aGVsbG8="}}]},
    {"name": "single-offset-and-size-past-object-size", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-single", "contentType": "text/plain"}, "objectSize": "3"}, "writeOffset": "2", "checksummedData": {"content": "aGVsbG8="}, "finishWrite": true}]},
    {"name": "start-condition-only", "protocol": "grpc", "rpc": "google.storage.v2.Storage/StartResumableWrite", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-condition", "contentType": "text/plain"}, "ifGenerationMatch": "0"}}, "capture": {"cond_only": "body:uploadId"}, "compare": false, "expect_status": 0},
    {"name": "start-condition-crc", "protocol": "grpc", "rpc": "google.storage.v2.Storage/StartResumableWrite", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-condition", "contentType": "text/plain"}, "ifGenerationMatch": "0"}}, "capture": {"cond_crc": "body:uploadId"}, "compare": false, "expect_status": 0},
    {"name": "start-condition-offset", "protocol": "grpc", "rpc": "google.storage.v2.Storage/StartResumableWrite", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-condition", "contentType": "text/plain"}, "ifGenerationMatch": "0"}}, "capture": {"cond_offset": "body:uploadId"}, "compare": false, "expect_status": 0},
    {"name": "start-condition-size", "protocol": "grpc", "rpc": "google.storage.v2.Storage/StartResumableWrite", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-condition", "contentType": "text/plain"}, "ifGenerationMatch": "0", "objectSize": "3"}}, "capture": {"cond_size": "body:uploadId"}, "compare": false, "expect_status": 0},
    {"name": "start-crc-size", "protocol": "grpc", "rpc": "google.storage.v2.Storage/StartResumableWrite", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-crc-size", "contentType": "text/plain"}, "objectSize": "3"}}, "capture": {"crc_size": "body:uploadId"}, "compare": false, "expect_status": 0},
    {"name": "start-md5-offset", "protocol": "grpc", "rpc": "google.storage.v2.Storage/StartResumableWrite", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-md5-offset", "contentType": "text/plain"}}}, "capture": {"md5_offset": "body:uploadId"}, "compare": false, "expect_status": 0},
    {"name": "write-condition-target", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-condition", "contentType": "text/plain"}, "objectSize": "1"}, "checksummedData": {"content": "eA=="}, "finishWrite": true}], "compare": false, "expect_status": 0},
    {"name": "condition-failing", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"uploadId": "{cond_only}", "writeOffset": "0", "checksummedData": {"content": "aGVsbG8="}, "finishWrite": true}]},
    {"name": "condition-failing-and-wrong-crc32c", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"uploadId": "{cond_crc}", "writeOffset": "0", "checksummedData": {"content": "aGVsbG8=", "crc32c": 1}, "finishWrite": true}]},
    {"name": "condition-failing-and-offset-past-persisted", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"uploadId": "{cond_offset}", "writeOffset": "5", "checksummedData": {"content": "aGVsbG8="}, "finishWrite": true}]},
    {"name": "condition-failing-and-size-past-object-size", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"uploadId": "{cond_size}", "writeOffset": "0", "checksummedData": {"content": "aGVsbG8="}, "finishWrite": true}]},
    {"name": "wrong-crc32c-and-size-past-object-size", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"uploadId": "{crc_size}", "writeOffset": "0", "checksummedData": {"content": "aGVsbG8=", "crc32c": 1}, "finishWrite": true}]},
    {"name": "malformed-md5-and-offset-past-persisted", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"uploadId": "{md5_offset}", "writeOffset": "5", "checksummedData": {"content": "aGVsbG8="}, "objectChecksums": {"md5Hash": "AAAA"}, "finishWrite": true}]},
    {"name": "start-checksums-split", "protocol": "grpc", "rpc": "google.storage.v2.Storage/StartResumableWrite", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-checksums-split", "contentType": "text/plain"}}}, "capture": {"ck_split": "body:uploadId"}, "compare": false, "expect_status": 0},
    {"name": "object-checksums-nonfinal-only", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"uploadId": "{ck_split}", "writeOffset": "0", "objectChecksums": {"crc32c": 1}}]},
    {"name": "status-after-object-checksums-nonfinal", "protocol": "grpc", "rpc": "google.storage.v2.Storage/QueryWriteStatus", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"uploadId": "{ck_split}"}},
    {"name": "finish-after-object-checksums-nonfinal", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"uploadId": "{ck_split}", "writeOffset": "0", "checksummedData": {"content": "aGVsbG8="}, "finishWrite": true}]},
    {"name": "start-checksums-stream", "protocol": "grpc", "rpc": "google.storage.v2.Storage/StartResumableWrite", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-checksums-stream", "contentType": "text/plain"}}}, "capture": {"ck_stream": "body:uploadId"}, "compare": false, "expect_status": 0},
    {"name": "object-checksums-nonfinal-then-finish", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"uploadId": "{ck_stream}", "writeOffset": "0", "objectChecksums": {"crc32c": 1}}, {"writeOffset": "0", "checksummedData": {"content": "aGVsbG8="}, "finishWrite": true}]},
    {"name": "status-after-object-checksums-stream", "protocol": "grpc", "rpc": "google.storage.v2.Storage/QueryWriteStatus", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"uploadId": "{ck_stream}"}}
  ]
}
