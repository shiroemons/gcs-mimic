{
  "id": "grpc-probe-bucket-conditions",
  "description": "Storage v2 bucket metageneration conditions whose validation and precedence the ledger leaves as local choices, on a bucket of its own: GetBucket and UpdateBucket with if_metageneration_match 0 or -1 and if_metageneration_not_match 0 or -1, UpdateBucket with both conditions holding (GetBucket with both holding was recorded in bkt-metageneration-match-and-not-match), and DeleteBucket on a nonempty bucket, on a missing bucket and on the emptied bucket with a failing condition, those values and both conditions together, plus ListObjects with an unknown read mask path on the empty bucket. The UpdateBucket steps change only the label probe (update mask labels.probe), and the bucket holds one 1-byte object only while the nonempty steps run. The last DeleteBucket steps may delete the bucket itself, which the harness cleanup then finds absent. Asks RPC-STORAGE-001 grpc_bucket_delete_condition_validation and grpc_bucket_delete_local_precedence, RPC-STORAGE-002 grpc_bucket_get_condition_validation, RPC-STORAGE-009 grpc_bucket_update_condition_validation and RPC-STORAGE-020 list_mask_validation_order (SPEC-GRPC-LOCAL-CHOICES).",
  "bucket": "own",
  "compare": {"ignore_body_paths": ["$.updateTime", "$.etag", "$.createTime", "$.bucketId", "$.project", "$.location", "$.locationType", "$.rpo", "$.storageClass", "$.softDeletePolicy", "$.versioning", "$.autoclass", "$.hierarchicalNamespace", "$.satisfiesPzs", "$.lifecycle", "$.objectRetention", "$.ipFilter", "$.owner", "$.acl", "$.defaultObjectAcl", "$.billing", "$.website", "$.encryption", "$.logging", "$.retentionPolicy", "$.customPlacementConfig", "$.cors", "$.iamConfig"]},
  "steps": [
    {"name": "get-metageneration", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"name": "projects/_/buckets/{bucket}", "readMask": {"paths": ["name", "metageneration"]}}, "capture": {"mg": "body:metageneration"}, "expect_status": 0},
    {"name": "get-match-zero", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"name": "projects/_/buckets/{bucket}", "ifMetagenerationMatch": "0", "readMask": {"paths": ["name", "metageneration"]}}},
    {"name": "get-not-match-zero", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"name": "projects/_/buckets/{bucket}", "ifMetagenerationNotMatch": "0", "readMask": {"paths": ["name", "metageneration"]}}},
    {"name": "get-match-negative", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"name": "projects/_/buckets/{bucket}", "ifMetagenerationMatch": "-1", "readMask": {"paths": ["name", "metageneration"]}}},
    {"name": "get-not-match-negative", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"name": "projects/_/buckets/{bucket}", "ifMetagenerationNotMatch": "-1", "readMask": {"paths": ["name", "metageneration"]}}},
    {"name": "update-match-and-not-match", "protocol": "grpc", "rpc": "google.storage.v2.Storage/UpdateBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": {"name": "projects/_/buckets/{bucket}", "labels": {"probe": "both"}}, "updateMask": {"paths": ["labels.probe"]}, "ifMetagenerationMatch": "{mg}", "ifMetagenerationNotMatch": "99"}},
    {"name": "update-match-zero", "protocol": "grpc", "rpc": "google.storage.v2.Storage/UpdateBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": {"name": "projects/_/buckets/{bucket}", "labels": {"probe": "match-zero"}}, "updateMask": {"paths": ["labels.probe"]}, "ifMetagenerationMatch": "0"}},
    {"name": "update-match-negative", "protocol": "grpc", "rpc": "google.storage.v2.Storage/UpdateBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": {"name": "projects/_/buckets/{bucket}", "labels": {"probe": "match-negative"}}, "updateMask": {"paths": ["labels.probe"]}, "ifMetagenerationMatch": "-1"}},
    {"name": "update-not-match-zero", "protocol": "grpc", "rpc": "google.storage.v2.Storage/UpdateBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": {"name": "projects/_/buckets/{bucket}", "labels": {"probe": "not-match-zero"}}, "updateMask": {"paths": ["labels.probe"]}, "ifMetagenerationNotMatch": "0"}},
    {"name": "update-not-match-negative", "protocol": "grpc", "rpc": "google.storage.v2.Storage/UpdateBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": {"name": "projects/_/buckets/{bucket}", "labels": {"probe": "not-match-negative"}}, "updateMask": {"paths": ["labels.probe"]}, "ifMetagenerationNotMatch": "-1"}},
    {"name": "get-metageneration-after-updates", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"name": "projects/_/buckets/{bucket}", "readMask": {"paths": ["name", "metageneration", "labels"]}}, "capture": {"mg2": "body:metageneration"}, "expect_status": 0},
    {"name": "write-object", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}", "contentType": "text/plain"}, "objectSize": "1"}, "checksummedData": {"content": "eA=="}, "finishWrite": true}], "compare": false, "expect_status": 0},
    {"name": "delete-nonempty", "protocol": "grpc", "rpc": "google.storage.v2.Storage/DeleteBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"name": "projects/_/buckets/{bucket}"}},
    {"name": "delete-nonempty-match-failing", "protocol": "grpc", "rpc": "google.storage.v2.Storage/DeleteBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"name": "projects/_/buckets/{bucket}", "ifMetagenerationMatch": "99"}},
    {"name": "delete-nonempty-match-zero", "protocol": "grpc", "rpc": "google.storage.v2.Storage/DeleteBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"name": "projects/_/buckets/{bucket}", "ifMetagenerationMatch": "0"}},
    {"name": "delete-nonempty-match-negative", "protocol": "grpc", "rpc": "google.storage.v2.Storage/DeleteBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"name": "projects/_/buckets/{bucket}", "ifMetagenerationMatch": "-1"}},
    {"name": "delete-nonempty-not-match-zero", "protocol": "grpc", "rpc": "google.storage.v2.Storage/DeleteBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"name": "projects/_/buckets/{bucket}", "ifMetagenerationNotMatch": "0"}},
    {"name": "delete-nonempty-not-match-negative", "protocol": "grpc", "rpc": "google.storage.v2.Storage/DeleteBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"name": "projects/_/buckets/{bucket}", "ifMetagenerationNotMatch": "-1"}},
    {"name": "delete-nonempty-match-and-not-match", "protocol": "grpc", "rpc": "google.storage.v2.Storage/DeleteBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"name": "projects/_/buckets/{bucket}", "ifMetagenerationMatch": "{mg2}", "ifMetagenerationNotMatch": "99"}},
    {"name": "delete-missing", "protocol": "grpc", "rpc": "google.storage.v2.Storage/DeleteBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{missing_bucket}"}, "body": {"name": "projects/_/buckets/{missing_bucket}"}},
    {"name": "delete-missing-match-failing", "protocol": "grpc", "rpc": "google.storage.v2.Storage/DeleteBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{missing_bucket}"}, "body": {"name": "projects/_/buckets/{missing_bucket}", "ifMetagenerationMatch": "99"}},
    {"name": "delete-missing-match-negative", "protocol": "grpc", "rpc": "google.storage.v2.Storage/DeleteBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{missing_bucket}"}, "body": {"name": "projects/_/buckets/{missing_bucket}", "ifMetagenerationMatch": "-1"}},
    {"name": "delete-object", "protocol": "grpc", "rpc": "google.storage.v2.Storage/DeleteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"bucket": "projects/_/buckets/{bucket}", "object": "{object}"}, "compare": false, "always": true},
    {"name": "list-empty-bucket-unknown-mask-path", "protocol": "grpc", "rpc": "google.storage.v2.Storage/ListObjects", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"parent": "projects/_/buckets/{bucket}", "readMask": {"paths": ["no_such_field"]}}},
    {"name": "delete-empty-match-failing", "protocol": "grpc", "rpc": "google.storage.v2.Storage/DeleteBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"name": "projects/_/buckets/{bucket}", "ifMetagenerationMatch": "99"}},
    {"name": "delete-empty-match-negative", "protocol": "grpc", "rpc": "google.storage.v2.Storage/DeleteBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"name": "projects/_/buckets/{bucket}", "ifMetagenerationMatch": "-1"}},
    {"name": "delete-empty-match-zero", "protocol": "grpc", "rpc": "google.storage.v2.Storage/DeleteBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"name": "projects/_/buckets/{bucket}", "ifMetagenerationMatch": "0"}},
    {"name": "delete-empty-match-and-not-match-current", "protocol": "grpc", "rpc": "google.storage.v2.Storage/DeleteBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"name": "projects/_/buckets/{bucket}", "ifMetagenerationMatch": "{mg2}", "ifMetagenerationNotMatch": "{mg2}"}},
    {"name": "delete-empty-not-match-negative", "protocol": "grpc", "rpc": "google.storage.v2.Storage/DeleteBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"name": "projects/_/buckets/{bucket}", "ifMetagenerationNotMatch": "-1"}},
    {"name": "get-after-deletes", "protocol": "grpc", "rpc": "google.storage.v2.Storage/GetBucket", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"name": "projects/_/buckets/{bucket}", "readMask": {"paths": ["name", "metageneration"]}}}
  ]
}
