{
  "id": "grpc-probe-inferred-upload-ids",
  "description": "Storage v2 answers to an upload_id that is well formed but names no session, which gcs-mimic answers NOT_FOUND by inference, on a bucket of its own. Real upload IDs are opaque, so each one is approximated from an ID that StartResumableWrite issued, with one character changed and the length kept (the harness's alter-middle and alter-last captures: a letter changes case, a digit becomes a letter from a to f): the first letter or digit from the middle on, on one session, and the last letter or digit, on another. With each altered ID the case asks QueryWriteStatus, a resumed WriteObject that sends 5 bytes from offset 0 with finish_write, and CancelResumableWrite, then QueryWriteStatus with the issued ID to show whether the altered requests reached the real session. The earlier probe (grpc-probe-resumable-sessions) only appended a character, which Cloud Storage answered INTERNAL, and used a made-up ID under the bucket's resource name. Session starts capture the IDs and are not compared. Asks RPC-STORAGE-013, RPC-STORAGE-018 and RPC-STORAGE-023 for an unknown session (SPEC-GRPC-LOCAL-CHOICES).",
  "bucket": "own",
  "steps": [
    {"name": "start-middle", "protocol": "grpc", "rpc": "google.storage.v2.Storage/StartResumableWrite", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-middle", "contentType": "text/plain"}}}, "capture": {"middle": "body:uploadId", "middle_altered": "alter-middle:body:uploadId"}, "compare": false, "expect_status": 0},
    {"name": "status-middle-altered", "protocol": "grpc", "rpc": "google.storage.v2.Storage/QueryWriteStatus", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"uploadId": "{middle_altered}"}},
    {"name": "write-middle-altered", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"uploadId": "{middle_altered}", "writeOffset": "0", "checksummedData": {"content": "aGVsbG8="}, "finishWrite": true}]},
    {"name": "cancel-middle-altered", "protocol": "grpc", "rpc": "google.storage.v2.Storage/CancelResumableWrite", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"uploadId": "{middle_altered}"}},
    {"name": "status-middle-issued", "protocol": "grpc", "rpc": "google.storage.v2.Storage/QueryWriteStatus", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"uploadId": "{middle}"}},
    {"name": "start-last", "protocol": "grpc", "rpc": "google.storage.v2.Storage/StartResumableWrite", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"writeObjectSpec": {"resource": {"bucket": "projects/_/buckets/{bucket}", "name": "{object}-last", "contentType": "text/plain"}}}, "capture": {"last": "body:uploadId", "last_altered": "alter-last:body:uploadId"}, "compare": false, "expect_status": 0},
    {"name": "status-last-altered", "protocol": "grpc", "rpc": "google.storage.v2.Storage/QueryWriteStatus", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"uploadId": "{last_altered}"}},
    {"name": "write-last-altered", "protocol": "grpc", "rpc": "google.storage.v2.Storage/WriteObject", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": [{"uploadId": "{last_altered}", "writeOffset": "0", "checksummedData": {"content": "aGVsbG8="}, "finishWrite": true}]},
    {"name": "cancel-last-altered", "protocol": "grpc", "rpc": "google.storage.v2.Storage/CancelResumableWrite", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"uploadId": "{last_altered}"}},
    {"name": "status-last-issued", "protocol": "grpc", "rpc": "google.storage.v2.Storage/QueryWriteStatus", "headers": {"x-goog-request-params": "bucket=projects%2F_%2Fbuckets%2F{bucket}"}, "body": {"uploadId": "{last}"}}
  ]
}
