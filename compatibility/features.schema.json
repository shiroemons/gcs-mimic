{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Emulator feature ledger",
  "type": "object",
  "required": [
    "schema_version",
    "as_of",
    "features"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "as_of": {
      "type": "string"
    },
    "delivery_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["updated_at", "semantics", "phase_rule", "progress_rule", "common_completion_gate", "existing_scopes", "next_deliverables"],
      "properties": {
        "updated_at": { "type": "string", "format": "date" },
        "semantics": { "type": "string", "minLength": 1 },
        "phase_rule": { "type": "string", "minLength": 1 },
        "progress_rule": { "type": "string", "minLength": 1 },
        "common_completion_gate": { "$ref": "#/$defs/nonempty_strings" },
        "migration": { "$ref": "#/$defs/migration_contract" },
        "existing_scopes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/existing_scope" }
        },
        "next_deliverables": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/deliverable" }
        }
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "title",
          "status",
          "target_fidelity",
          "actual_fidelity",
          "phase",
          "acceptance_cases",
          "verification",
          "category",
          "dependencies",
          "source_urls",
          "source_checked_at",
          "source_evidence",
          "test_ids",
          "sdk_evidence",
          "known_deviations"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9-]*$"
          },
          "kind": {
            "enum": [
              "api_operation",
              "behavior",
              "project_requirement"
            ]
          },
          "status": {
            "enum": [
              "NOT_STARTED",
              "IN_PROGRESS",
              "PARTIAL",
              "IMPLEMENTED",
              "BLOCKED",
              "NOT_APPLICABLE"
            ]
          },
          "target_fidelity": {
            "enum": [
              "EXACT",
              "LOCAL_SIMULATION",
              "METADATA_ONLY",
              "EXTERNAL",
              "PROJECT"
            ]
          },
          "actual_fidelity": {
            "enum": [
              "NONE",
              "EXACT",
              "LOCAL_SIMULATION",
              "METADATA_ONLY",
              "EXTERNAL",
              "PROJECT"
            ]
          },
          "phase": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3",
              "P4",
              "P5",
              "P6",
              "P7"
            ]
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "acceptance_cases": {
            "type": "array",
            "items": { "$ref": "#/$defs/acceptance" }
          },
          "verification": {
            "type": "array",
            "items": { "$ref": "#/$defs/verification" }
          },
          "test_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "source_urls": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^https://.+" }
          },
          "source_checked_at": { "type": "string", "format": "date" },
          "source_evidence": { "type": "string", "minLength": 1 },
          "sdk_evidence": { "type": "array" },
          "known_deviations": { "type": "array" },
          "category": { "type": "string", "minLength": 1 }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "IMPLEMENTED"
                }
              }
            },
            "then": {
              "properties": {
                "acceptance_cases": {
                  "minItems": 1
                },
                "verification": {
                  "minItems": 1
                },
                "actual_fidelity": {
                  "not": {
                    "const": "NONE"
                  }
                },
                "last_verified": {
                  "type": "string"
                }
              },
              "required": [
                "last_verified"
              ]
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "migration_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal", "baseline", "environment_contract", "storage_contract", "full_superset_gate", "milestones"],
      "properties": {
        "goal": { "type": "string", "minLength": 1 },
        "baseline": {
          "type": "object",
          "additionalProperties": false,
          "required": ["product", "version", "checked_at"],
          "properties": {
            "product": { "const": "fake-gcs-server" },
            "version": { "type": "string", "minLength": 1 },
            "checked_at": { "type": "string", "format": "date" }
          }
        },
        "environment_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_prefix", "target_prefix", "legacy_keys", "naming_rule", "precedence", "storage_boundary", "port_boundary"],
          "properties": {
            "source_prefix": { "const": "FAKE_GCS_" },
            "target_prefix": { "const": "GCS_MIMIC_" },
            "legacy_keys": { "type": "string", "minLength": 1 },
            "naming_rule": { "type": "string", "minLength": 1 },
            "precedence": { "type": "string", "minLength": 1 },
            "storage_boundary": { "type": "string", "minLength": 1 },
            "port_boundary": { "type": "string", "minLength": 1 }
          }
        },
        "storage_contract": { "type": "string", "minLength": 1 },
        "full_superset_gate": { "$ref": "#/$defs/nonempty_strings" },
        "milestones": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/deliverable" }
        }
      }
    },
    "nonempty_strings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "delivery_id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "existing_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "scope", "feature_ids", "acceptance_case_refs", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/delivery_id" },
        "title": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "feature_ids": { "$ref": "#/$defs/nonempty_strings" },
        "acceptance_case_refs": { "$ref": "#/$defs/nonempty_strings" },
        "evidence": { "$ref": "#/$defs/nonempty_strings" }
      }
    },
    "deliverable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "order", "title", "depends_on", "feature_ids", "completion_conditions", "deferred_scope"],
      "properties": {
        "id": { "$ref": "#/$defs/delivery_id" },
        "order": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1 },
        "depends_on": { "$ref": "#/$defs/nonempty_strings" },
        "feature_ids": { "$ref": "#/$defs/nonempty_strings" },
        "completion_conditions": { "$ref": "#/$defs/nonempty_strings" },
        "deferred_scope": { "type": "string", "minLength": 1 }
      }
    },
    "test_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "acceptance": {
      "type": "object",
      "required": ["id", "description", "result", "test_ids"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "result": { "enum": ["PENDING", "PASS", "FAIL"] },
        "test_ids": { "$ref": "#/$defs/test_ids" }
      }
    },
    "verification": {
      "type": "object",
      "required": ["command", "result", "verified_at", "artifact", "test_ids"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "result": { "enum": ["PASS", "FAIL"] },
        "verified_at": { "type": "string", "format": "date" },
        "artifact": { "type": "string", "minLength": 1 },
        "test_ids": { "$ref": "#/$defs/test_ids" }
      }
    }
  },
  "$comment": "Rust xtask must additionally validate uniqueness, dependency integrity, evidence semantics, count reconciliation and generated views."
}
